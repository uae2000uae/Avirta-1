# Exclude files and folders not needed in the Cloud Run container image

# VCS and local env
.git/
.gitignore
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# IDE/editor
.idea/
.vscode/

# Local environment and secrets
.env
.env.*
.junie/
remove_shelf.bat

# OS generated
.DS_Store
Thumbs.db

# Tests and docs (not needed at runtime)
tests/
docs/

# Deployment configs not used in Cloud Run image
app.yaml
cloudbuild.yaml
docker-compose.yml
avirta.service
app_engine_nginx.conf
nginx_avirta.conf
Direct deploy.bat

# Misc large or dev-only assets
scratches/
*.md
*.MD

# Optional: exclude local run data/output not required for serving
.game_runs/
