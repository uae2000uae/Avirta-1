{
  "type": "text",
  "question": "\u0645\u0627 \u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0645 \u0641\u064a\u0647\u0627 \u062a\u062d\u0648\u064a\u0644 \u063a\u0627\u0632 \u0627\u0644\u0623\u0643\u0633\u062c\u064a\u0646 \u0625\u0644\u0649 \u062b\u0627\u0646\u064a \u0623\u0643\u0633\u064a\u062f \u0627\u0644\u0643\u0631\u0628\u0648\u0646 \u0641\u064a \u062e\u0644\u0627\u064a\u0627 \u0627\u0644\u062c\u0633\u0645\u061f",
  "correct_answer": "\u0627\u0644\u062a\u0646\u0641\u0633 \u0627\u0644\u062e\u0644\u0648\u064a \u0627\u0644\u0647\u0648\u0627\u0626\u064a",
  "explanation": "\u062e\u0644\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629\u060c \u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0623\u0643\u0633\u062c\u064a\u0646 \u0644\u062a\u0643\u0633\u064a\u0631 \u0627\u0644\u062c\u0644\u0648\u0643\u0648\u0632 \u0648\u0625\u0646\u062a\u0627\u062c ATP\u060c \u0648\u0647\u0648 \u0645\u0635\u062f\u0631 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0644\u0644\u062e\u0644\u0627\u064a\u0627\u060c \u0648\u064a\u0646\u062a\u062c \u0639\u0646 \u0630\u0644\u0643 \u062b\u0627\u0646\u064a \u0623\u0643\u0633\u064a\u062f \u0627\u0644\u0643\u0631\u0628\u0648\u0646 \u0643\u0645\u064f\u062e\u0644\u0641 \u064a\u062a\u0645 \u0627\u0644\u062a\u062e\u0644\u0635 \u0645\u0646\u0647 \u0639\u0628\u0631 \u0627\u0644\u0631\u0626\u062a\u064a\u0646",
