{
  "type": "text",
  "question": "\u0645\u0627 \u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0645 \u0641\u064a\u0647\u0627 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0643\u064a\u0645\u064a\u0627\u0626\u064a\u0629 \u0625\u0644\u0649 \u0637\u0627\u0642\u0629 \u062d\u0631\u0627\u0631\u064a\u0629 \u0641\u064a \u062c\u0633\u0645 \u0627\u0644\u0625\u0646\u0633\u0627\u0646\u061f",
  "correct_answer": "\u0627\u0644\u0623\u064a\u0636 (\u0627\u0644\u062a\u0645\u062b\u064a\u0644 \u0627\u0644\u063a\u0630\u0627\u0626\u064a) \u0623\u0648 \u0627\u0644\u062a\u0646\u0641\u0633 \u0627\u0644\u062e\u0644\u0648\u064a",
  "explanation": "\u0627\u0644\u062a\u0646\u0641\u0633 \u0627\u0644\u062e\u0644\u0648\u064a \u062c\u0632\u0621 \u0645\u0646 \u0627\u0644\u0623\u064a\u0636\u060c \u062d\u064a\u062b \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0625\u0646\u062a\u0627\u062c \u0627\u0644\u0637\u0627\u0642\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0623\u064a\u0636 \u064a\u0634\u0645\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062d\u064a\u0648\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u062c\u0633\u0645",
