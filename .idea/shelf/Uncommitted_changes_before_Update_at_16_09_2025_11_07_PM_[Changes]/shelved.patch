+@app.route('/api/questions')
+def api_questions():
+    """Paginated questions API for lazy loading in admin view.
+    Query params: category_id (required), offset (default 0), limit (default 50).
+    Requires admin authentication.
+    """
+    if not session.get('admin_authenticated', False):
+        return jsonify({"error": "unauthorized"}), 401
+
+    category_id = request.args.get('category_id')
+    if not category_id:
+        return jsonify({"error": "category_id required"}), 400
+
+    try:
+        offset = int(request.args.get('offset', 0))
+        limit = int(request.args.get('limit', 50))
+        limit = max(1, min(limit, 200))  # clamp
+        offset = max(0, offset)
+    except ValueError:
+        return jsonify({"error": "invalid offset/limit"}), 400
+
+    # Ensure latest data loaded
+    question_bank.load_questions()
+
+    questions = question_bank.get_questions_by_category(category_id) or []
+    total = len(questions)
+    slice_ = questions[offset: offset + limit]
+
+    # Only include fields needed for the table/details to reduce payload
+    def to_item(q):
+        return {
+            'id': q.get('id'),
+            'question': q.get('question'),
+            'type': q.get('type'),
+            'points': q.get('points', 0),
+            'use_count': q.get('use_count', 0),
+            'options': q.get('options', []),
+            'correct_answer': q.get('correct_answer'),
+        }
+
+    return jsonify({
+        'total': total,
+        'offset': offset,
+        'limit': limit,
+        'items': [to_item(q) for q in slice_]
+    })
+
