<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}Avirta - Create Room{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"page-section\">\r\n    <h2>Create a \"Knowleade Columns\" Game Board</h2>\r\n  <form action=\"{{ url_for('create_room') }}\" method=\"post\" class=\"form-group-xx\" data-max-categories=\"{{ max_categories }}\">\r\n        <div class=\"form-group-equal-md\">\r\n            <label for=\"room_name\">Room Name:</label>\r\n            <input type=\"text\" id=\"room_name\" name=\"room_name\" required placeholder=\"Game room title\">\r\n        </div>\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"host_name\">Host (Player 1):</label>\r\n            <input type=\"text\" id=\"host_name\" name=\"host_name\" required placeholder=\"Player 1 (the host)\">\r\n        </div>\r\n        <div class=\"form-group-inline\">\r\n            <label>Additional Players:</label>\r\n            <div class=\"form-group-grid\">\r\n                {% for i in range(1, max_players) %}\r\n                <div class=\"form-group-equal-sm\">\r\n                    <input type=\"text\" id=\"player{{ i }}\" name=\"additional_players\" placeholder=\"Player {{ i+1 }} (optional)\">\r\n                </div>\r\n                {% endfor %}\r\n            </div>\r\n        </div>\r\n        <div class=\"form-group-inline\">\r\n            <label>Select Categories (up to {{ max_categories }}):</label>\r\n            <div class=\"categories-grid\">\r\n                {% for category_id, category in categories.items() %}\r\n\r\n                <div class=\"category-checkbox\">\r\n                    <input type=\"checkbox\" id=\"category_{{ category_id }}\" name=\"categories\" value=\"{{ category_id }}\">\r\n                    <label for=\"category_{{ category_id }}\" class=\"text-center\">{{ category.name }}</label>\r\n                </div>\r\n                {% endfor %}\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"form-group-inline\">\r\n            <label>Select Question Types:</label>\r\n            <div class=\"form-group-equal-sm\">\r\n                <div class=category-checkbox>\r\n                    <input type=\"checkbox\" id=\"type_text\" name=\"question_types\" value=\"text\" checked>\r\n                    <label for=\"type_text\">Text</label>\r\n                </div>\r\n                <div class=category-checkbox>\r\n                    <input type=\"checkbox\" id=\"type_multiple_choice\" name=\"question_types\" value=\"multiple_choice\" checked>\r\n                    <label for=\"type_multiple_choice\">Multiple Choice</label>\r\n                </div>\r\n                <div class=category-checkbox>\r\n                    <input type=\"checkbox\" id=\"type_true_false\" name=\"question_types\" value=\"true_false\" checked>\r\n                    <label for=\"type_true_false\">True/False</label>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"form-actions\">\r\n            <button type=\"submit\">Create Room</button>\r\n            <button class=\"button secondary\"><a class=\"text-clear\" href=\"{{ url_for('index') }}\">Cancel</a></button>\r\n        </div>\r\n    </form>\r\n</div>\r\n\r\n{% endblock %}\r\n
