{ url_for('admin_controls') }}\">\r\n                        <div class=\"form-group\">\r\n                            <label for=\"username\">Username:</label>\r\n                            <input type=\"text\" id=\"username\" name=\"username\" required>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <label for=\"password\">Password:</label>\r\n                            <input type=\"password\" id=\"password\" name=\"password\" required>\r\n                        </div>\r\n                        <div class=\"form-group\">\r\n                            <button type=\"submit\" class=\"button\">Login</button>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            {% endif %}\r\n        </div>\r\n    </header>\r\n\r\n\r\n{% set hide_navigation = false %}\r\n{% block hide_nav %}{% endblock %}\r\n\r\n{% if hide_nav is defined and hide_nav %}\r\n    {% set hide_navigation = true %}\r\n{% endif %}\r\n\r\n\r\n\r\n\r\n\r\n    <div class=\"container\">\r\n        {% with messages = get_flashed_messages(with_categories=true) %}\r\n            {% if messages %}\r\n                <div class=\"flash-messages\">\r\n                    {% for category, message in messages %}\r\n                        <div class=\"flash-message {% if category == 'error' %}error{% elif category == 'success' %}success{% elif category == 'result-correct' %}result-correct{% else %}success{% endif %}\">{{ message }}</div>\r\n                    {% endfor %}\r\n                </div>\r\n            {% endif %}\r\n        {% endwith %}\r\n\r\n        <main>\r\n            {% block content %}{% endblock %}\r\n        </main>\r\n    </div>\r\n\r\n    <footer>\r\n      <p>© 2025 Avirta. All rights reserved.</p>\r\n</footer>\r\n\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        // Get the admin login button and dropdown form\r\n        const adminLoginBtn = document.getElementById('adminLoginBtn');\r\n        const adminLoginForm = document.getElementById('adminLoginForm');\r\n\r\n        // Add click event listener to the login button\r\n        if (adminLoginBtn) {\r\n            adminLoginBtn.addEventListener('click', function() {\r\n                // Toggle the 'show' class on the login form\r\n                adminLoginForm.classList.toggle('show');\r\n            });\r\n\r\n            // Close the dropdown when clicking outside of it\r\n            document.addEventListener('click', function(event) {\r\n                if (!adminLoginBtn.contains(event.target) && !adminLoginForm.contains(event.target)) {\r\n                    adminLoginForm.classList.remove('show');\r\n                }\r\n            });\r\n        }\r\n\r\n        // Fetch and display timestamp information\r\n        const timestampInfo = document.getElementById('timestamp-info');\r\n        if (timestampInfo) {\r\n            fetch('/timestamp.json')\r\n                .then(response => response.json())\r\n                .then(data => {\r\n                    if (data.lastSynced) {\r\n                        const timestamp = new Date(data.lastSynced);\r\n                        const formattedDate = timestamp.toLocaleDateString();\r\n                        const formattedTime = timestamp.toLocaleTimeString();\r\n                        timestampInfo.textContent = `Last synced: ${formattedDate} ${formattedTime}`;\r\n                    } else {\r\n                        timestampInfo.textContent = 'Last synced: Unknown';\r\n                    }\r\n                })\r\n                .catch(error => {\r\n                    console.error('Error fetching timestamp:', error);\r\n                    timestampInfo.textContent = 'Last synced: Error loading';\r\n                });\r\n        }\r\n    });\r\n</script>\r\n\r\n{% if session.get('error_modal') %}\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        // Ensure showModal function is available before calling it\r\n        function displayErrorModal() {\r\n            if (typeof showModal === 'function') {\r\n                showModal('{{ session.pop(\"error_modal\")|safe }}');\r\n            } else {\r\n                // If showModal is not available yet, wait a bit and try again\r\n                setTimeout(displayErrorModal, 100);\r\n            }\r\n        }\r\n        displayErrorModal();\r\n    });\r\n</script>\r\n{% endif %}\r\n\r\n</body>\r\n</html>\r\n
