<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}Bulk Import Questions - Avirta{% endblock %}\r\n\r\n{% block content %}\r\n<h1>Bulk Import Questions</h1>\r\n\r\n<div class=\"actions\">\r\n    <a href=\"{{ url_for('admin_controls') }}\" class=\"button\">Back to Admin Controls</a>\r\n</div>\r\n\r\n<div class=\"import-section\">\r\n    <h2>Import Questions from File</h2>\r\n    <p>Upload a CSV or Excel file containing questions to import them in bulk.</p>\r\n\r\n    <div class=\"template-links\">\r\n        <h3>Templates</h3>\r\n        <p>Use one of these templates to format your questions correctly:</p>\r\n        <div class=\"template-buttons\">\r\n            <a href=\"{{ url_for('export_template_route', format='csv') }}\" class=\"button\">CSV Template</a>\r\n            <a href=\"{{ url_for('export_template_route', format='xlsx') }}\" class=\"button\">Excel Template</a>\r\n        </div>\r\n    </div>\r\n\r\n    <form method=\"POST\" action=\"{{ url_for('bulk_import_page') }}\" enctype=\"multipart/form-data\">\r\n        <div class=\"form-group\">\r\n            <label for=\"file\">Select File:</label>\r\n            <input type=\"file\" id=\"file\" name=\"file\" accept=\".csv,.xlsx,.xls\" required>\r\n            <small>Accepted formats: CSV, Excel (.xlsx, .xls)</small>\r\n        </div>\r\n<div class=\"form-actions\">\r\n      <button type=\"submit\" class=\"button\">Import Questions</button>\r\n        </div>\r\n    </form>\r\n</div>\r\n\r\n<div class=\"import-instructions\">\r\n    <h2>Instructions</h2>\r\n    <ol>\r\n        <li>Download the template file</li>\r\n        <li>Fill in the template with your questions</li>\r\n        <li>Upload the completed file using the form above</li>\r\n        <li>Click \"Import Questions\" to begin the import process</li>\r\n    </ol>\r\n\r\n    <h3>File Format</h3>\r\n    <p>Your file should contain the following columns:</p>\r\n    <ul>\r\n        <li><strong>question</strong> (required): The text of the question</li>\r\n        <li><strong>type</strong> (required): The question type (multiple_choice, true_false)</li>\r\n        <li><strong>category</strong> (optional): The category for the question</li>\r\n        <li><strong>points</strong> (optional): The point value (100, 200, 300, 400, 500)</li>\r\n        <li><strong>options</strong> (for multiple choice): Comma-separated list of options</li>\r\n        <li><strong>correct_answer</strong> (required): The correct answer</li>\r\n    </ul>\r\n</div>\r\n\r\n{% endblock %}\r\n
