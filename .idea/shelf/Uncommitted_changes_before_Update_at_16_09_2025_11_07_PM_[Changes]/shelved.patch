<+><link href=\"/static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}AI Question Generator - Avirta{% endblock %}\r\n\r\n{% block content %}\r\n<h2>AI Question Generator</h2>\r\n\r\n<div class=\"actions\">\r\n    <a href=\"{{ url_for('admin_controls') }}\" class=\"button\">Back to Admin Controls</a>\r\n</div>\r\n\r\n<div class=\"page-section\">\r\n    {% if not admin_setup.game_settings.get('openai_api_key') %}\r\n    <div class=\"warning-message\">\r\n        <p> No OpenAI API key is configured. An API key is required to generate questions.</p>\r\n        <p>Please <a href=\"{{ url_for('admin_controls') }}\">configure your OpenAI API key</a> in the Admin Controls before using this feature.</p>\r\n    </div>\r\n    {% endif %}\r\n\t<div class=\"section\">\r\n    <h2>AI Generator</h2>\r\n    <p>Enter a prompt and customize options to generate questions using AI.</p>\r\n\t\t<form id=\"generatorForm\" action=\"{{ url_for('ai_question_generator') }}\" method=\"POST\" class=\"form\">\r\n        <div class=\"form-group-inline\">\r\n            <h3 for=\"prompt\">Prompt:</h3>\r\n            <textarea id=\"prompt\" name=\"prompt\" rows=\"4\" required placeholder=\"Enter a topic, subject, or specific instructions for generating questions...\"></textarea>\r\n            <div><small>Be specific about the type of questions you want. For example: \"Generate questions about ancient Egyptian history.\"</small>\r\n        </div></div>\r\n\t\t<div class=\"form-group\">\r\n\t\t<div class=\"fill-stack\"><h3>Generation Options:</h3>\r\n        <div class=\"form-group equal-md\">\r\n                <label for=\"question_type\">Type:</label>\r\n                <select id=\"question_type\" name=\"question_type\">\r\n                    <option value=\"mixed\">All Types</option>\r\n                    <option value=\"multiple_choice\">Multiple Choice Only</option>\r\n                    <option value=\"true_false\">True/False Only</option>\r\n                    <option value=\"text\">Text Answer Only</option>\r\n                </select>\r\n            </div>\r\n        <div class=\"form-group equal-md\">\r\n                <label for=\"difficulty\">Difficulty:</label>\r\n                <select id=\"difficulty\" name=\"difficulty\">\r\n                  <option value=\"mixed\">All Difficulties</option>\r\n                    <option value=\"easiest\">Easiest (100)</option>\r\n                    <option value=\"easy\">Easy (200)</option>\r\n                    <option value=\"medium\">Medium (300)</option>\r\n                    <option value=\"hard\">Hard (400)</option>\r\n                    <option value=\"hardest\">Hardest (500)</option>\r\n                </select>\r\n        </div>\r\n        <div class=\"form-group equal-md\">\r\n                <label for=\"language\">Language:</label>\r\n                <select id=\"language\" name=\"language\">\r\n                    <option value=\"english\">English</option>\r\n                    <option value=\"arabic\" selected>Arabic</option>\r\n                </select>\r\n        </div>\r\n        <div class=\"form-group equal-md\">\r\n                <label for=\"num_questions\">Count:</label>\r\n                <select id=\"num_questions\" name=\"num_questions\">\r\n                    <option value=\"3\">3</option>\r\n                    <option value=\"5\">5</option>\r\n                    <option value=\"10\">10</option>\r\n                    <option value=\"15\">15</option>\r\n                    <option value=\"25\" selected>25</option>\r\n\t\t\t\t\t<option value=\"50\">50</option>\r\n                </select>\r\n        </div>\r\n        <div class=\"form-group\">\r\n                <label>Select categories if you want AI to avoid repeating questions already in them:</label>\r\n                <div id=\"categories-container\" class=\"categories-inline-container\">\r\n                    {% for category_id, category in categories.items() %}\r\n                    <div class=\"category-item\" data-category-id=\"{{ category_id }}\">{{ category.name }} ({{ category.question_count }})</div>\r\n                    {% endfor %}\r\n                </div>\r\n                <div id=\"selected-categories-container\" class=\"selected-categories-container\">\r\n                    <p>Selected categories: <span id=\"selected-categories-text\">None</span></p>\r\n                </div>\r\n                <div id=\"hidden-inputs-container\"></div>\r\n                <small>Click on categories to select them</small>\r\n        </div>\r\n\t\t\t<br>\r\n\t\t\t<div class=\"form-group-grid\">\r\n          \t\t<input type=\"checkbox\" id=\"include_explanations\" name=\"include_explanations\" checked>\r\n                <label for=\"include_explanations\">Include explanations for correct answers</label>\r\n            </div></div>\r\n\t\t</div>\r\n\t\t<div class=\"form-actions clear\">\r\n\t\t    <div class=\"form-actions\">\r\n              <button type=\"submit\" class=\"button\" id=\"generateButton\">Generate Questions</button>\r\n\t\t\t</div>\r\n        </div>\r\n    <!-- Progress indicator (hidden by default) -->\r\n\t\t<div class=\"form-group centered\"></div>\r\n\t\t<div id=\"progressContainer\" class=\"progress-container\" style=\"display: none;\">\r\n\t\t\t\t<h3>Generating Questions...</h3>\r\n\t\t\t\t <div class=\"progress-bar-container\">\r\n\t\t\t\t\t<div id=\"progressBar\" class=\"progress-bar\"></div>\r\n\t\t\t\t </div>\r\n\t\t\t <div id=\"progressStatus\" class=\"progress-status\">Initializing...</div>\r\n\t\t</div>\r\n\t</form>\r\n</div>\r\n\r\n{% if generated_questions %}\r\n<br>\r\n<div class=\"section\">\r\n    <h2>Preview Generated Questions</h2>\r\n    <p>Review the generated questions before adding them to your question bank.</p>\r\n\r\n    <form action=\"{{ url_for('save_ai_questions') }}\" method=\"POST\" class=\"form-group-grid1\">\r\n        <input type=\"hidden\" name=\"batch_id\" value=\"{{ batch_id }}\">\r\n\r\n\r\n        {% for i, question in enumerate(generated_questions) %}\r\n        <div class=\"colored-box blue equal-md\">\r\n            <h3>Question {{ i+1 }}</h3>\r\n\r\n\r\n            <div class=\"text-clear\">\r\n                <p><strong class=\"status-message\">Question:</strong> {{ question.question }}</p>\r\n\r\n                {% if question.type == 'multiple_choice' %}\r\n                <p><strong>Type:</strong> Multiple Choice</p>\r\n                <p><strong class=\"status-message\">Options:</strong></p>\r\n                <ul>\r\n                    {% for option in question.options %}\r\n                    <li>{{ option }}{% if option == question.correct_answer %} (Correct){% endif %}</li>\r\n                    {% endfor %}\r\n                </ul>\r\n                {% elif question.type == 'true_false' %}\r\n                <p><strong>Type:</strong> True/False</p>\r\n                <p><strong class=\"status-message\">Correct Answer:</strong> {{ question.correct_answer }}</p>\r\n                {% elif question.type == 'text' %}\r\n                <p><strong>Type:</strong> Text Answer</p>\r\n                <p><strong class=\"status-message\">Correct Answer:</strong> {{ question.correct_answer }}</p>\r\n                {% endif %}\r\n\r\n                {% if question.explanation %}\r\n                <p><strong>Explanation:</strong> {{ question.explanation }}</p>\r\n                {% endif %}\r\n            </div>\r\n\r\n            <div class=\"form-group checkbox-group\">\r\n                <input type=\"checkbox\" id=\"include_{{ i }}\" name=\"include_{{ i }}\" checked>\r\n                <label for=\"include_{{ i }}\">Include this question</label>\r\n            </div>\r\n\r\n            <!-- Category is now set at the form level with the custom category name -->\r\n\r\n            <div class=\"form-group\">\r\n                <label for=\"points_{{ i }}\">Points:</label>\r\n                <select id=\"points_{{ i }}\" name=\"points_{{ i }}\">\r\n                    <option value=\"100\" {% if question.points == 100 %}selected{% endif %}>100 points</option>\r\n                    <option value=\"200\" {% if question.points == 200 %}selected{% endif %}>200 points</option>\r\n                    <option value=\"300\" {% if question.points == 300 or not question.points %}selected{% endif %}>300 points</option>\r\n                    <option value=\"400\" {% if question.points == 400 %}selected{% endif %}>400 points</option>\r\n                    <option value=\"500\" {% if question.points == 500 %}selected{% endif %}>500 points</option>\r\n                </select>\r\n            </div>\r\n        </div>\r\n        {% endfor %}\r\n        <div class=\"form-group-inline\">\r\n            <label for=\"custom_category\">Category Name:</label>\r\n            <input type=\"text\" id=\"custom_category\" name=\"custom_category\" required>\r\n            <small>Enter a category name these questions</small>\r\n        </div>\r\n\r\n        <div class=\"form-group form-actions\">\r\n            <button type=\"submit\" class=\"button\">Add Selected Questions to Question Bank</button>\r\n            <button class=\"button secondary\"><a class=\"text-clear\" href=\"{{ url_for('ai_question_generator') }}\">Cancel</a></button>\r\n        </div>\r\n\r\n    </form>\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"generator-instructions\">\r\n    <h3>Instructions</h3>\r\n    <ol>\r\n        <li>Enter a prompt describing the questions you want to generate</li>\r\n        <li>Customize the generation options (question type, difficulty, etc.)</li>\r\n        <li>Click \"Generate Questions\" to create AI-generated questions</li>\r\n        <li>Review the generated questions</li>\r\n        <li>Select which questions to include in your question bank</li>\r\n        <li>Assign categories and point values to each question</li>\r\n        <li>Click \"Add Selected Questions to Question Bank\" to save them</li>\r\n    </ol>\r\n\r\n    <h3>Tips for Better Results</h3>\r\n    <ul>\r\n        <li>Be specific in your prompt about the subject matter and difficulty level</li>\r\n        <li>Include any specific requirements or constraints in your prompt</li>\r\n        <li>For multiple-choice questions, specify how many options you want</li>\r\n        <li>Request explanations if you want the AI to provide reasoning for correct answers</li>\r\n        <li>Select the appropriate language (English or Arabic) for your questions</li>\r\n        <li>If you're not satisfied with the results, try refining your prompt and generating again</li>\r\n    </ul>\r\n</div>\r\n</div>\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        const form = document.getElementById('generatorForm');\r\n        const generateButton = document.getElementById('generateButton');\r\n        const progressContainer = document.getElementById('progressContainer');\r\n        const progressBar = document.getElementById('progressBar');\r\n        const progressStatus = document.getElementById('progressStatus');\r\n\r\n        // Reference categories selection\r\n        const categoryItems = document.querySelectorAll('.category-item');\r\n        const hiddenInputsContainer = document.getElementById('hidden-inputs-container');\r\n        const selectedCategoriesText = document.getElementById('selected-categories-text');\r\n        const selectedCategories = new Set();\r\n\r\n        // Add click event listener to each category item\r\n        categoryItems.forEach(item => {\r\n            item.addEventListener('click', function() {\r\n                const categoryId = this.getAttribute('data-category-id');\r\n\r\n                // Toggle selection\r\n                if (selectedCategories.has(categoryId)) {\r\n                    // Remove from selected categories\r\n                    selectedCategories.delete(categoryId);\r\n                    this.classList.remove('selected');\r\n\r\n                    // Remove hidden input\r\n                    const inputToRemove = document.getElementById(`category-input-${categoryId}`);\r\n                    if (inputToRemove) {\r\n                        hiddenInputsContainer.removeChild(inputToRemove);\r\n                    }\r\n                } else {\r\n                    // Add to selected categories\r\n                    selectedCategories.add(categoryId);\r\n                    this.classList.add('selected');\r\n\r\n                    // Create hidden input\r\n                    const hiddenInput = document.createElement('input');\r\n                    hiddenInput.type = 'hidden';\r\n                    hiddenInput.name = 'reference_categories[]';\r\n                    hiddenInput.value = categoryId;\r\n                    hiddenInput.id = `category-input-${categoryId}`;\r\n                    hiddenInputsContainer.appendChild(hiddenInput);\r\n                }\r\n\r\n                // Update selected categories text\r\n                if (selectedCategories.size === 0) {\r\n                    selectedCategoriesText.textContent = 'None';\r\n                } else {\r\n                    const selectedNames = Array.from(selectedCategories).map(id => {\r\n                        const item = document.querySelector(`.category-item[data-category-id=\"${id}\"]`);\r\n                        return item ? item.textContent : id;\r\n                    });\r\n                    selectedCategoriesText.textContent = selectedNames.join(', ');\r\n                }\r\n            });\r\n        });\r\n\r\n        // Define the stages of AI question generation\r\n        const stages = [\r\n            { percent: 10, message: \"Validating API key...\" },\r\n            { percent: 20, message: \"Testing API connection...\" },\r\n            { percent: 30, message: \"Preparing prompt...\" },\r\n            { percent: 40, message: \"Connecting to OpenAI...\" },\r\n            { percent: 50, message: \"Generating questions...\" },\r\n            { percent: 70, message: \"Receiving response...\" },\r\n            { percent: 80, message: \"Parsing questions...\" },\r\n            { percent: 90, message: \"Validating questions...\" },\r\n            { percent: 95, message: \"Finalizing...\" },\r\n            { percent: 100, message: \"Complete! Loading questions...\" }\r\n        ];\r\n\r\n        form.addEventListener('submit', function(event) {\r\n            // Prevent the default form submission\r\n            event.preventDefault();\r\n\r\n            // Show loading state on button\r\n            generateButton.textContent = 'Generating...';\r\n            generateButton.disabled = true;\r\n\r\n            // Show progress container\r\n            progressContainer.style.display = 'block';\r\n\r\n            // Simulate progress through the stages\r\n            let currentStage = 0;\r\n\r\n            // Update progress status with the first stage\r\n            updateProgress(stages[0].percent, stages[0].message);\r\n\r\n            // Set up interval to update progress\r\n            const progressInterval = setInterval(function() {\r\n                currentStage++;\r\n\r\n                if (currentStage < stages.length) {\r\n                    // Update progress with the current stage\r\n                    updateProgress(stages[currentStage].percent, stages[currentStage].message);\r\n                } else {\r\n                    // Clear the interval when all stages are complete\r\n                    clearInterval(progressInterval);\r\n\r\n                    // Submit the form after all stages are complete\r\n                    form.submit();\r\n                }\r\n            }, 2000); // Update every 2 seconds\r\n\r\n            // Function to update progress bar and status\r\n            function updateProgress(percent, message) {\r\n                progressBar.style.width = percent + '%';\r\n                progressStatus.textContent = message;\r\n                progressStatus.className = 'progress-status active';\r\n            }\r\n        });\r\n    });\r\n</script>\r\n{% endblock %}\r\n
