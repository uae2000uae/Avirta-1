tion\": \"Which American manufacturer produced the EV1, one of the first modern electric cars?\",\r\n    \"correct_answer\": \"General Motors\",\r\n    \"explanation\": \"General Motors produced the EV1 in the late 1990s.\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0001386\",\r\n    \"category_id\": \"car_brands\",\r\n    \"created_at\": \"2025-06-03T23:59:23.625365\",\r\n    \"updated_at\": \"2025-06-07T12:24:19.856202\",\r\n    \"active\": true,\r\n    \"use_count\": 1\r\n  },\r\n  {\r\n    \"type\": \"text\",\r\n    \"question\": \"Which Italian luxury brand is famous for its signature trident logo?\",\r\n    \"correct_answer\": \"Maserati\",\r\n    \"explanation\": \"Maserati's logo features a trident, inspired by the Fountain of Neptune in Bologna, Italy.\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0001387\",\r\n    \"category_id\": \"car_brands\",\r\n    \"created_at\": \"2025-06-03T23:59:23.664361\",\r\n    \"updated_at\": \"2025-06-07T12:38:40.292024\",\r\n    \"active\": true,\r\n    \"use_count\": 1\r\n  },\r\n  {\r\n    \"type\": \"text\",\r\n    \"question\": \"Which Chinese automotive company owns Volvo Cars?\",\r\n    \"correct_answer\": \"Geely\",\r\n    \"explanation\": \"Chinese company Geely acquired Volvo Cars from Ford in 2010.\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0001388\",\r\n    \"category_id\": \"car_brands\",\r\n    \"created_at\": \"2025-06-03T23:59:23.703375\",\r\n    \"updated_at\": \"2025-06-03T23:59:23.703375\",\r\n    \"active\": true,\r\n    \"use_count\": 0\r\n  }\r\n]
