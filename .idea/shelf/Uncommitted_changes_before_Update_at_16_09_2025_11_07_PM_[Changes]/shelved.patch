<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"gamebase.html\" %}\r\n\r\n{% block extra_head %}\r\n    <script src=\"{{ url_for('static', filename='js/livestatus.js') }}\"></script>\r\n    <script src=\"{{ url_for('static', filename='js/gametools.js') }}\"></script>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"page-section\" data-room-id=\"{{ room.room_id }}\" data-player-name=\"{{ player_name }}\" data-is-host=\"{{ is_host|default('false')|lower }}\">\r\n  <div class=\"room-header\">\r\n    <h2 class=\"text-center\">{{ room.name }}</h2>\r\n\t  <p class=\"text-center\"><strong>Host:</strong> {{ room.host }} | <strong>Room ID: </strong><span>{{ room.room_id }} | </span><strong> Players:</strong> {{ room.players|join(', ') }}</p>\r\n  </div>\r\n  <div class=\"section\">\r\n    <div>\r\n      <p class=\"blue-box\">Your Name: <span><strong>{{ player_name }}</strong></span> | Current Turn: <span><strong class=\"red-badge\">{{ current_player }}</strong></span></p>\r\n      <p class=\"turn-indicator\">{% if current_player == player_name %}It's your turn!{% else %}It's {{ current_player }}'s turn...{% endif %}</p>\r\n    </div>\r\n    <div class=\"form-actions\">\r\n      <button id=\"double-points-btn\" class=\"dp tool-btn {% if not player_tools.double_points %}disabled-button{% endif %}\" {% if not player_tools.double_points %}disabled=\"disabled\"{% endif %}>\r\n        Double Points | مضاعفة النقاط\r\n      </button>\r\n    </div>\r\n  </div>\r\n<br>\r\n  <!-- Live Game Status Section -->\r\n  <div class=\"section\">\r\n    <p><em>Game Status...</em></p>\r\n    <div class=\"status-container\">\r\n      <div id=\"status-updates\" class=\"status-updates\">\r\n        <p class=\"status-message\">Waiting for game updates...</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Leaderboard Section -->\r\n  <div class=\"leaderboard-section\">\r\n    <div class=\"leaderboard-header\">\r\n      <h3>Leaderboard | النتـــائـــج</h3>\r\n    </div>\r\n\r\n    <div class=\"leaderboard-display\">\r\n      <table class=\"leaderboard-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Rank</th>\r\n            <th>Player</th>\r\n            <th>Score</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"leaderboard-body\">\r\n          {% if leaderboard %}\r\n            {% for player, score in leaderboard %}\r\n              <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ player }}</td>\r\n                <td>{{ score }}</td>\r\n              </tr>\r\n            {% endfor %}\r\n          {% else %}\r\n            <tr>\r\n              <td colspan=\"3\">No scores yet. Start answering questions to see the leaderboard!</td>\r\n            </tr>\r\n          {% endif %}\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"game-actions\">\r\n    <a href=\"{{ url_for('leave_game', room_id=room.room_id) }}\" class=\"button\">Leave Game | مغادرة اللعبة</a>\r\n  </div>\r\n</div> <!-- End of page-section -->\r\n{% endblock %}\r\n\r\n{% block scripts %}\r\n<script>\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    // Setup scroll position saving\r\n    setupScrollPositionSaving();\r\n\r\n    // Setup check for updates\r\n    function checkForUpdate() {\r\n        fetch('/notify_game_room')\r\n            .then(response => response.json())\r\n            .then(data => {\r\n                if (data.refresh) {\r\n                    window.location.reload();  // Refresh joined_room.html when signal is received\r\n                }\r\n            })\r\n            .catch(error => console.error('Error checking for updates:', error));\r\n    }\r\n\r\n    setInterval(checkForUpdate, 1000);  // Check every 1 second\r\n});\r\n</script>\r\n<script>\r\n/**\r\n * Setup scroll position saving functionality\r\n * Saves the scroll position when navigating away from a page\r\n * Restores the scroll position when returning to a page\r\n */\r\nfunction setupScrollPositionSaving() {\r\n    // Get the current page path to use as a unique key\r\n    const pagePath = window.location.pathname;\r\n    const scrollKey = 'avirta_scroll_' + pagePath;\r\n\r\n    // Restore scroll position if it exists in localStorage\r\n    const savedScrollPosition = localStorage.getItem(scrollKey);\r\n    if (savedScrollPosition) {\r\n        // Restore immediately without delay\r\n        window.scrollTo(0, parseInt(savedScrollPosition));\r\n    }\r\n\r\n    // Save scroll position when user navigates away or refreshes\r\n    window.addEventListener('beforeunload', function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    });\r\n\r\n    // Add event listeners to all form submit buttons to save position before submission\r\n    document.querySelectorAll('form').forEach(form => {\r\n        form.addEventListener('submit', function() {\r\n            localStorage.setItem(scrollKey, window.scrollY);\r\n        });\r\n    });\r\n\r\n    // Save scroll position more frequently (every 1 second)\r\n    setInterval(function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    }, 1000);\r\n}\r\n</script>\r\n{% endblock %}\r\n
