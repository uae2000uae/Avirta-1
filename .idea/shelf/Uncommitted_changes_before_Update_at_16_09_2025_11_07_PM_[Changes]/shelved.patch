<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n<link href=\"../../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"gamebase.html\" %}\r\n\r\n{% block extra_head %}\r\n    <script src=\"{{ url_for('static', filename='js/livestatus.js') }}\"></script>\r\n    <script src=\"{{ url_for('static', filename='js/gametools.js') }}\"></script>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"page-section\" data-room-id=\"{{ room.room_id }}\" data-player-name=\"{{ player_name }}\" data-is-host=\"{{ is_host|default('false')|lower }}\">\r\n    <h1 class=\"text-center text-nomargin\">{{ room.name }}</h1>\r\n    <p class=\"text-center\"><strong>Host: </strong>{{ room.host }} | <strong>Room ID: </strong><span>{{ room.room_id }}</span></p>\r\n\r\n    <!-- Game Board Info Section -->\r\n    <div class=\"section\">\r\n    <div class=\"form-group\">\r\n        <div class=\"form-group-inline-grid\">\r\n\t\t<div class=\"stat-card\">\r\n                <strong>Total Questions:</strong> {{ stats.total_questions }}\r\n            </div>\r\n\t\t<div class=\"stat-card\">\r\n                <strong>Selected Categories:</strong> {{ room.categories|length }}\r\n            </div>\r\n\t\t<div class=\"stat-card\">\r\n                <strong>Point Values:</strong> {{ room.point_values|join(', ') }}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n  <br>\r\n    <!-- Question Display Section -->\r\n    <div class=\"section\">\r\n    <!-- Current Question Info Section -->\r\n        <div class=\"form-group-inline-grid\">\r\n            <div class=\"text-center\">\r\n                <strong>Question:</strong> {{ stats.current_question_number }} of {{ stats.total_questions }}\r\n            </div>\r\n            <div class=\"text-center\">\r\n                <strong>Category:</strong> {{ current_question.category_id|replace('_', ' ')|title if current_question else 'N/A' }}\r\n            </div>\r\n            <div class=\"text-center\">\r\n                <strong>Points:</strong> {{ current_question.points if current_question else 'N/A' }}\r\n            </div>\r\n        </div>\r\n      <div class=\"question-display\" id=\"question-container\">\r\n            {% if current_question and stats.question_revealed %}\r\n                <div class=\"question-text\" dir=\"{% if current_question.question|is_arabic %}rtl{% else %}ltr{% endif %}\">{{ current_question.question }}</div>\r\n                {% if current_question.options %}\r\n                    <div class=\"form-options\">\r\n                        {% for option in current_question.options %}\r\n                            <div class=\"button-no-hover\">{{ option }}</div>\r\n                        {% endfor %}\r\n                    </div>\r\n                {% elif current_question.type == 'true_false' %}\r\n                    <div class=\"form-options\">\r\n                        <div class=\"button-no-hover\">True or False? | صــح أم خطــأ؟</div>\r\n                    </div>\r\n                {% endif %}\r\n            {% else %}\r\n                {% if is_host %}\r\n                    <form action=\"{{ url_for('fastest_reveal_question') }}\" method=\"post\" class=\"form-actions\">\r\n                        <input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\">\r\n                        <button type=\"submit\" class=\"button\">Reveal Question | أظهـــر الســــؤال</button>\r\n                    </form>\r\n                {% endif %}\r\n            {% endif %}\r\n    <!-- Answer Display Section -->\r\n        <div>\r\n            {% if current_question and stats.answer_revealed %}\r\n                <div dir=\"{% if current_question.correct_answer|is_arabic %}rtl{% else %}ltr{% endif %}\"><h2 class=\"text-center\">{{ current_question.correct_answer }}</h2></div>\r\n            {% else %}\r\n                {% if is_host and stats.question_revealed and not stats.answer_revealed %}\r\n                    <div class=\"timer-container\"><p>Time remaining:</p><h4><span id=\"timer\">15</span></h4><p dir=rtl>الوقت المتبقي :</p></div>\r\n                    <form action=\"{{ url_for('fastest_reveal_answer') }}\" method=\"post\" class=\"form-actions\">\r\n                        <input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\">\r\n                        <button type=\"submit\" class=\"button\">Reveal Answer | أظهــر الجـــواب</button>\r\n                    </form>\r\n                {% endif %}\r\n            {% endif %}\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n    <!-- Player Scoring Section -->\r\n\t{% if current_question and stats.answer_revealed %}\r\n<br>\r\n    <div class=\"section\">\r\n        <h4 class=\"text-center\">Who answered correctly first? | مــــن أول مــن جـــاوب صــــح ؟</h4>\r\n        <div class=\"content-section\">\r\n\t\t\t<div class=\"form-group-inline-grid\">\r\n            {% for player in room.players %}\r\n                <form action=\"{{ url_for('fastest_award_points') }}\" method=\"post\" class=\"form-group\">\r\n                    <input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\">\r\n                    <input type=\"hidden\" name=\"player_name\" value=\"{{ player }}\">\r\n                    <button type=\"submit\" class=\"player-button\" {% if not is_host or not stats.answer_revealed %}disabled{% endif %}>\r\n                        {{ player }}\r\n                    </button>\r\n                </form>\r\n            {% endfor %}\r\n\t\t\t</div>\r\n            <!-- No one answered button -->\r\n            <form action=\"{{ url_for('fastest_next_question') }}\" method=\"post\" class=\"form-actions clear\">\r\n                <input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\">\r\n                <button type=\"submit\" class=\"delete-button\" {% if not is_host or not stats.answer_revealed %}disabled{% endif %}>No one | لا أحــد</button>\r\n            </form>\r\n        </div>\r\n    </div>\r\n\t{% endif %}\r\n\r\n<br>\r\n    <!-- Navigation Buttons -->\r\n    <div class=\"form-actions\"> \r\n        <a href=\"{{ url_for('fastest_leaderboard', room_id=room.room_id) }}\" class=\"button\">Leaderboard | عرض النتائج</a>\r\n        <a href=\"{{ url_for('end_game', room_id=room.room_id) }}\" class=\"button red-button\">End Game | إنهاء اللعبة</a>\r\n    </div>\r\n<br>\r\n    <!-- Live Game Status Section -->\r\n    <div class=\"section\">\r\n        <p><em>Game Status...</em></p>\r\n        <div class=\"status-container\">\r\n            <div id=\"status-updates\" class=\"status-updates\">\r\n                <p class=\"status-message\">Waiting for game updates...</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n{% endblock %}\r\n\r\n{% block scripts %}\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        // Setup scroll position saving\r\n        setupScrollPositionSaving();\r\n    });\r\n\r\n    /**\r\n     * Setup scroll position saving functionality\r\n     * Saves the scroll position when navigating away from a page\r\n     * Restores the scroll position when returning to a page\r\n     */\r\n    function setupScrollPositionSaving() {\r\n        // Get the current page path to use as a unique key\r\n        const pagePath = window.location.pathname;\r\n        const scrollKey = 'avirta_scroll_' + pagePath;\r\n\r\n        // Restore scroll position if it exists in localStorage\r\n        const savedScrollPosition = localStorage.getItem(scrollKey);\r\n        if (savedScrollPosition) {\r\n            // Restore immediately without delay\r\n            window.scrollTo(0, parseInt(savedScrollPosition));\r\n        }\r\n\r\n        // Save scroll position when user navigates away or refreshes\r\n        window.addEventListener('beforeunload', function() {\r\n            localStorage.setItem(scrollKey, window.scrollY);\r\n        });\r\n\r\n        // Add event listeners to all form submit buttons to save position before submission\r\n        document.querySelectorAll('form').forEach(form => {\r\n            form.addEventListener('submit', function() {\r\n                localStorage.setItem(scrollKey, window.scrollY);\r\n            });\r\n        });\r\n\r\n        // Add event listeners to the Reveal Answer button specifically\r\n        const revealAnswerForm = document.querySelector('form[action*=\"fastest_reveal_answer\"]');\r\n        if (revealAnswerForm) {\r\n            revealAnswerForm.addEventListener('submit', function() {\r\n                localStorage.setItem(scrollKey, window.scrollY);\r\n            });\r\n        }\r\n\r\n        // Save scroll position more frequently (every 1 second)\r\n        setInterval(function() {\r\n            localStorage.setItem(scrollKey, window.scrollY);\r\n        }, 1000);\r\n    }\r\n\r\n    // Timer functionality\r\n    let timerInterval;\r\n    let seconds = 15; // Start from 15 seconds\r\n    let isPulsating = false;\r\n\r\n    function startTimer() {\r\n        if (timerInterval) {\r\n            clearInterval(timerInterval);\r\n        }\r\n\r\n        // Reset timer to 15 seconds\r\n        seconds = 15;\r\n        updateTimerDisplay();\r\n\r\n        // Remove pulsating class if it exists\r\n        const timerElement = document.getElementById('timer');\r\n        timerElement.classList.remove('timer-pulsating');\r\n        timerElement.style.color = ''; // Reset color\r\n        isPulsating = false;\r\n\r\n        // Start countdown\r\n        timerInterval = setInterval(function() {\r\n            seconds--;\r\n\r\n            // When timer reaches 5 seconds, add pulsating effect and change color to red\r\n            if (seconds <= 5 && seconds > 0 && !isPulsating) {\r\n                const timerElement = document.getElementById('timer');\r\n                timerElement.classList.add('timer-pulsating');\r\n                timerElement.style.color = 'var(--error-color)'; // Red color\r\n                isPulsating = true;\r\n            }\r\n\r\n            // When timer reaches 0, stop pulsating\r\n            if (seconds <= 0) {\r\n                if (isPulsating) {\r\n                    const timerElement = document.getElementById('timer');\r\n                    timerElement.classList.remove('timer-pulsating');\r\n                    isPulsating = false;\r\n                }\r\n                clearInterval(timerInterval);\r\n            }\r\n\r\n            updateTimerDisplay();\r\n        }, 1000);\r\n    }\r\n\r\n    function stopTimer() {\r\n        if (timerInterval) {\r\n            clearInterval(timerInterval);\r\n            timerInterval = null;\r\n        }\r\n\r\n        // Remove pulsating effect when timer stops\r\n        if (isPulsating) {\r\n            const timerElement = document.getElementById('timer');\r\n            timerElement.classList.remove('timer-pulsating');\r\n            timerElement.style.color = ''; // Reset color\r\n            isPulsating = false;\r\n        }\r\n    }\r\n\r\n    function updateTimerDisplay() {\r\n        const timerElement = document.getElementById('timer');\r\n        if (timerElement) {\r\n            timerElement.textContent = seconds.toString().padStart(2, '0');\r\n        }\r\n    }\r\n</script>\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        const pageSection = document.querySelector('.page-section');\r\n\r\n        // Setup scroll position saving\r\n        setupScrollPositionSaving();\r\n\r\n        // Track question and answer state\r\n        let wasQuestionRevealed = false;\r\n        let wasAnswerRevealed = false;\r\n\r\n        // Setup polling for game updates\r\n        function checkForUpdate() {\r\n            fetch('/api/fastest_game_updates/{{ room.room_id }}')\r\n                .then(response => response.json())\r\n                .then(data => {\r\n                    if (data.refresh) {\r\n                        window.location.reload();  // Refresh page when signal is received\r\n                        return;\r\n                    }\r\n\r\n                    // Check if question was just revealed (transition from not revealed to revealed)\r\n                    if (!wasQuestionRevealed && data.question_revealed && !data.answer_revealed) {\r\n                        // Start the timer when question is revealed\r\n                        startTimer();\r\n                        wasQuestionRevealed = true;\r\n                    }\r\n\r\n                    // Check if answer was just revealed (transition from not revealed to revealed)\r\n                    if (!wasAnswerRevealed && data.answer_revealed) {\r\n                        // Stop the timer when answer is revealed\r\n                        stopTimer();\r\n                        wasAnswerRevealed = true;\r\n                    }\r\n\r\n                    // Reset tracking if we move to a new question\r\n                    if (!data.question_revealed) {\r\n                        wasQuestionRevealed = false;\r\n                        wasAnswerRevealed = false;\r\n                    }\r\n\r\n                    // Update question and answer sections if needed\r\n                    updateQuestionSection(data);\r\n                    updateAnswerSection(data);\r\n\r\n                    // Update status messages\r\n                    updateStatusMessages(data);\r\n                })\r\n                .catch(error => console.error('Error checking for updates:', error));\r\n        }\r\n\r\n        // Function to update the question section\r\n        function updateQuestionSection(data) {\r\n            const questionContainer = document.getElementById('question-container');\r\n            if (!questionContainer) return;\r\n\r\n            // If question is revealed, show it\r\n            if (data.question_revealed && data.current_question) {\r\n                // Only update if content has changed\r\n                const questionText = data.current_question.question || '';\r\n                const currentText = questionContainer.querySelector('.question-text')?.textContent || '';\r\n\r\n                if (questionText && questionText !== currentText) {\r\n                    questionContainer.innerHTML = '';\r\n\r\n                    const questionTextDiv = document.createElement('div');\r\n                    questionTextDiv.className = 'question-text';\r\n                    questionTextDiv.textContent = questionText;\r\n                    questionContainer.appendChild(questionTextDiv);\r\n\r\n                    // Add options if available\r\n                    if (data.current_question.options && data.current_question.options.length > 0) {\r\n                        const optionsList = document.createElement('div');\r\n                        optionsList.className = 'options-list';\r\n\r\n                        data.current_question.options.forEach(option => {\r\n                            const optionItem = document.createElement('div');\r\n                            optionItem.className = 'option-item';\r\n                            optionItem.textContent = option;\r\n                            optionsList.appendChild(optionItem);\r\n                        });\r\n\r\n                        questionContainer.appendChild(optionsList);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        // Function to update the answer section\r\n        function updateAnswerSection(data) {\r\n            const answerContainer = document.getElementById('answer-container');\r\n            if (!answerContainer) return;\r\n\r\n            // If answer is revealed, show it\r\n            if (data.answer_revealed && data.current_question) {\r\n                // Only update if content has changed\r\n                const answerText = data.current_question.correct_answer || '';\r\n                const currentText = answerContainer.querySelector('.answer-text')?.textContent || '';\r\n\r\n                if (answerText && answerText !== currentText) {\r\n                    answerContainer.innerHTML = `<div class=\"answer-text\">${answerText}</div>`;\r\n                }\r\n            }\r\n\r\n            // Update player buttons based on answer revealed state\r\n            const playerButtons = document.querySelectorAll('.player-button');\r\n            const isHost = pageSection.getAttribute('data-is-host') === 'true';\r\n            playerButtons.forEach(button => {\r\n                button.disabled = !data.answer_revealed || !isHost;\r\n            });\r\n        }\r\n\r\n        // Function to update status messages\r\n        function updateStatusMessages(data) {\r\n            const statusUpdates = document.getElementById('status-updates');\r\n            if (!statusUpdates || !data.events) return;\r\n\r\n            // Clear the \"Waiting for game updates...\" message if it's the first update\r\n            if (statusUpdates.querySelector('.status-message')?.textContent === 'Waiting for game updates...') {\r\n                statusUpdates.innerHTML = '';\r\n            }\r\n\r\n            // Add the most recent events (up to 10)\r\n            const recentEvents = data.events.slice(-10);\r\n            const existingMessages = Array.from(statusUpdates.querySelectorAll('.status-message')).map(el => el.dataset.timestamp);\r\n\r\n            recentEvents.forEach(event => {\r\n                // Skip events we've already displayed\r\n                if (existingMessages.includes(event.timestamp)) {\r\n                    return;\r\n                }\r\n\r\n                const messageElement = document.createElement('p');\r\n                messageElement.className = 'status-message';\r\n                messageElement.textContent = event.data.message;\r\n                messageElement.dataset.timestamp = event.timestamp;\r\n\r\n                // Add appropriate class based on event type\r\n                if (event.type === 'answer_submitted' || event.type === 'points_awarded') {\r\n                    messageElement.classList.add('status-success');\r\n                } else if (event.type === 'player_joined' || event.type === 'player_left') {\r\n                    messageElement.classList.add('status-info');\r\n                } else if (event.type === 'question_revealed' || event.type === 'answer_revealed') {\r\n                    messageElement.classList.add('status-info');\r\n                } else if (event.type === 'next_question') {\r\n                    messageElement.classList.add('status-warning');\r\n                }\r\n\r\n                // Add to the top of the list\r\n                statusUpdates.insertBefore(messageElement, statusUpdates.firstChild);\r\n\r\n                // Limit the number of status updates to 10\r\n                while (statusUpdates.children.length > 10) {\r\n                    statusUpdates.removeChild(statusUpdates.lastChild);\r\n                }\r\n            });\r\n        }\r\n\r\n        setInterval(checkForUpdate, 1000);  // Check every 1 second\r\n    });\r\n</script>\r\n{% endblock %}\r\n
