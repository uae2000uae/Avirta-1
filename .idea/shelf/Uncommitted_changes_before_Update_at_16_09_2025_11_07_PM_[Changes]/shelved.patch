<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}Reported Questions - Avirta{% endblock %}\r\n\r\n{% block extra_head %}\r\n<style>\r\n    .no-reports {\r\n        margin-top: 20px;\r\n        padding: 20px;\r\n        background-color: var(--bg-color-light);\r\n        border-radius: 5px;\r\n        text-align: center;\r\n    }\r\n</style>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<h1>Reported Questions</h1>\r\n\r\n{% if not is_authenticated %}\r\n<div class=\"login-form\">\r\n    <h2>Admin Login</h2>\r\n    {% if login_error %}\r\n    <div class=\"error-message\">{{ login_error }}</div>\r\n    {% endif %}\r\n    <form method=\"POST\" action=\"{{ url_for('admin_controls') }}\">\r\n        <div class=\"form-group\">\r\n            <label for=\"username\">Username:</label>\r\n            <input type=\"text\" id=\"username\" name=\"username\" required>\r\n        </div>\r\n        <br>\r\n        <div class=\"form-group\">\r\n            <label for=\"password\">Password:</label>\r\n            <input type=\"password\" id=\"password\" name=\"password\" required>\r\n        </div>\r\n        <div class=\"form-actions\">\r\n            <button type=\"submit\" class=\"button\">Login</button>\r\n        </div>\r\n    </form>\r\n</div>\r\n{% else %}\r\n<div class=\"admin-dashboard\">\r\n    <div class=\"page-section\">\r\n       <div>\r\n            <form class=\"form-group stack\" method=\"GET\" action=\"{{ url_for('reported_questions') }}\">\r\n\t\t\t\t<div><label class=\"fill\" for=\"status\">Filter by Status:</label></div>\r\n\t            <div class=\"fill\">\r\n                    <select id=\"status\" name=\"status\">\r\n                        <option value=\"\">All</option>\r\n                        <option value=\"pending\" selected>Pending</option>\r\n                        <option value=\"reviewed\">Reviewed</option>\r\n                        <option value=\"rejected\">Rejected</option>\r\n                    </select>\r\n                    <button type=\"submit\" class=\"button\">Filter</button>\r\n                </div>\r\n            </form>\r\n        </div>\r\n        <br>\r\n        {% if reports %}\r\n        <div class=\"sextion\">\r\n            <table class=\"data-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th>Question</th>\r\n                        <th>Category</th>\r\n                        <th>Reported At</th>\r\n                        <th>Status</th>\r\n                        <th>Actions</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for report in reports %}\r\n                    <tr>\r\n                        <td>{{ report.question_data.question if report.question_data else 'Question deleted' }}</td>\r\n                        <td>{{ report.question_data.category_id if report.question_data else 'N/A' }}</td>\r\n                        <td>{{ report.reported_at }}</td>\r\n                        <td>\r\n                            <span class=\"status-badge status-{{ report.status }}\">{{ report.status }}</span>\r\n                        </td>\r\n                        <td>\r\n                            <div class=\"action-buttons\">\r\n                                {% if report.question_data %}\r\n                                <button class=\"button\"><a href=\"{{ url_for('edit_reported_question', report_id=report.report_id) }}\" class=\"text-clear\">Edit</a></button>\r\n                                {% else %}\r\n                                <button class=\"button\" disabled title=\"Question has been deleted\">Edit</button>\r\n                                {% endif %}\r\n                                <form method=\"POST\" action=\"{{ url_for('update_report_status') }}\" class=\"form-group clear\">\r\n                                    <input type=\"hidden\" name=\"report_id\" value=\"{{ report.report_id }}\">\r\n                                    <input type=\"hidden\" name=\"status\" value=\"reviewed\">\r\n                                    <button type=\"submit\" class=\"button\">Reviewed</button>\r\n                                </form>\r\n                                <form method=\"POST\" action=\"{{ url_for('update_report_status') }}\" class=\"form-group clear\">\r\n                                    <input type=\"hidden\" name=\"report_id\" value=\"{{ report.report_id }}\">\r\n                                    <input type=\"hidden\" name=\"status\" value=\"rejected\">\r\n                                    <button type=\"submit\" class=\"button\">Reject</button>\r\n                                </form>\r\n                            </div>\r\n                        </td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n        {% else %}\r\n        <div class=\"section\">\r\n            <p>No reported questions found.</p>\r\n        </div>\r\n        {% endif %}\r\n    </div>\r\n</div>\r\n{% endif %}\r\n<script>\r\n/**\r\n * Setup scroll position saving functionality\r\n * Saves the scroll position when navigating away from a page\r\n * Restores the scroll position when returning to a page\r\n */\r\nfunction setupScrollPositionSaving() {\r\n    // Get the current page path to use as a unique key\r\n    const pagePath = window.location.pathname;\r\n    const scrollKey = 'avirta_scroll_' + pagePath;\r\n\r\n    // Restore scroll position if it exists in localStorage\r\n    const savedScrollPosition = localStorage.getItem(scrollKey);\r\n    if (savedScrollPosition) {\r\n        // Restore immediately without delay\r\n        window.scrollTo(0, parseInt(savedScrollPosition));\r\n    }\r\n\r\n    // Save scroll position when user navigates away or refreshes\r\n    window.addEventListener('beforeunload', function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    });\r\n\r\n    // Add event listeners to all form submit buttons to save position before submission\r\n    document.querySelectorAll('form').forEach(form => {\r\n        form.addEventListener('submit', function() {\r\n            localStorage.setItem(scrollKey, window.scrollY);\r\n        });\r\n    });\r\n\r\n    // Save scroll position more frequently (every 1 second)\r\n    setInterval(function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    }, 1000);\r\n}\r\n</script>\r\n{% endblock %}\r\n
