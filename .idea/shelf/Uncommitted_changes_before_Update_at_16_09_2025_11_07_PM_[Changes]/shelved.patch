+<script defer>
+(function(){
+  const table = document.getElementById('questions-table');
+  if(!table) return;
+  const categoryId = table.getAttribute('data-category-id');
+  const tbody = document.getElementById('questions-body');
+  const loadMoreBtn = document.getElementById('load-more');
+  const loadingEl = document.getElementById('loading');
+  let offset = 0;
+  const limit = 50;
+  let total = null;
+  let loading = false;
+
+  function rowHtml(item){
+    const optionsHtml = (item.type === 'multiple_choice' && item.options && item.options.length)
+      ? ('<strong>Options:</strong><ul>' + item.options.map(o=>`<li>${escapeHtml(o)}${o===item.correct_answer?' (Correct)':''}</li>`).join('') + '</ul>')
+      : (`<strong>Answer:</strong> ${escapeHtml(String(item.correct_answer||''))}`);
+
+    return `
+      <tr class="question-row" data-id="${item.id}">
+        <td>${escapeHtml(String(item.id))}</td>
+        <td>${escapeHtml(String(item.question||''))}</td>
+        <td>${escapeHtml(String(item.type||''))}</td>
+        <td>${Number(item.points)||0}</td>
+        <td>${Number(item.use_count)||0}</td>
+        <td class="question-actions">
+          <a href="${editUrl(item.id)}" class="edit-icon" title="Edit Question"><i class="fas fa-edit"></i></a>
+          <a href="#" class="delete-icon" title="Delete Question" data-id="${item.id}" onclick="confirmDelete(this); return false;"><i class="fas fa-trash-alt"></i></a>
+        </td>
+      </tr>
+      <tr class="question-details-row" id="details-${item.id}" style="display:none;">
+        <td colspan="6"><div class="question-details">${optionsHtml}</div></td>
+      </tr>
+    `;
+  }
+
+  function editUrl(id){
+    // Use Jinja to build base and replace placeholder
+    return "{{ url_for('edit_question', question_id='__ID__') }}".replace('__ID__', id);
+  }
+
+  function escapeHtml(s){
+    return s.replace(/[&<>"']/g, function(ch){
+      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;','\'':'&#39;'}[ch]);
+    });
+  }
+
+  async function loadMore(){
+    if(loading) return; loading = true;
+    loadMoreBtn.style.display = 'none';
+    loadingEl.style.display = '';
+    try{
+      const url = `/api/questions?category_id=${encodeURIComponent(categoryId)}&offset=${offset}&limit=${limit}`;
+      const res = await fetch(url, {credentials:'same-origin'});
+      if(!res.ok) throw new Error('Failed to load');
+      const data = await res.json();
+      total = data.total;
+      const html = data.items.map(rowHtml).join('');
+      tbody.insertAdjacentHTML('beforeend', html);
+      // attach toggle handlers
+      Array.from(tbody.querySelectorAll('tr.question-row')).forEach(tr => {
+        tr.onclick = function(){
+          const id = this.getAttribute('data-id');
+          const details = document.getElementById('details-'+id);
+          if(details){ details.style.display = (details.style.display==='none'||!details.style.display)?'table-row':'none'; }
+        };
+      });
+      offset += data.items.length;
+    }catch(e){
+      console.error(e);
+    }finally{
+      loading = false;
+      loadingEl.style.display = 'none';
+      if(total === null || offset < total){
+        loadMoreBtn.style.display = '';
+      } else {
+        loadMoreBtn.style.display = 'none';
+      }
+    }
+  }
+
+  loadMoreBtn.addEventListener('click', loadMore);
+
+  // Infinite-scroll-ish: load more when near bottom
+  window.addEventListener('scroll', function(){
+    if(loading) return;
+    const rect = loadMoreBtn.getBoundingClientRect();
+    if(rect.top < window.innerHeight + 100){
+      loadMore();
+    }
+  });
+
+  // Initial fetch
+  loadMore();
+})();
+</script>
