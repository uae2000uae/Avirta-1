+#!/bin/bash
+
+echo "Setting up Avirta project environment..."
+
+# Create and activate conda environment
+conda create -y -n avirta python=3.12.7
+source activate avirta
+
+# Install requirements
+pip install -r requirements.txt
+
+echo "Environment setup complete. Activate with: source activate avirta"
