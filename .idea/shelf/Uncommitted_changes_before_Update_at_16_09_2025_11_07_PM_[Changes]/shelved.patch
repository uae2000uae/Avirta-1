<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}Avirta - Join Room{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"join-room-section\">\r\n    <h2>Join a Game Room</h2>\r\n    <p>Enter the Room ID provided by the host and your name to join an existing game room.</p>\r\n\r\n    <form action=\"{{ url_for('join_room') }}\" method=\"post\">\r\n        <div class=\"form-group\">\r\n            <label for=\"room_id\">Room ID:</label>\r\n            <input type=\"text\" id=\"room_id\" name=\"room_id\" required placeholder=\"Enter the Room ID\">\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n            <label for=\"player_name\">Your Name:</label>\r\n            <input type=\"text\" id=\"player_name\" name=\"player_name\" required placeholder=\"Enter your name\">\r\n        </div>\r\n\r\n        <div class=\"form-actions\">\r\n            <button type=\"submit\">Join Room</button>\r\n            <button class=\"button secondary\"><a href=\"{{ url_for('index') }}\" class=\"text-clear\">Cancel</a></button>\r\n        </div>\r\n    </form>\r\n</div>\r\n\r\n{% endblock %}\r\n
