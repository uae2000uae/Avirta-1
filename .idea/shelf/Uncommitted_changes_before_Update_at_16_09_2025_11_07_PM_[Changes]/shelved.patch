<+>/* Avirta Game - Main Stylesheet */\r\n\r\n/* Cairo Font Family */\r\n@font-face {\r\n    font-family: 'Cairo';\r\n    src: url('../fonts/Cairo/static/Cairo-Regular.ttf') format('truetype');\r\n    font-weight: 400;\r\n    font-style: normal;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'Cairo';\r\n    src: url('../fonts/Cairo/static/Cairo-Bold.ttf') format('truetype');\r\n    font-weight: 700;\r\n    font-style: oblique;\r\n}\r\n\r\n/* Color Theme Variables */\r\n:root {\r\n    /* Hide scrollbar for the entire document */\r\n    scrollbar-width: none; /* Firefox */\r\n    -ms-overflow-style: none; /* IE and Edge */\r\n\r\n    /* Primary Colors */\r\n    --primary-color-light: #346176;\r\n    --primary-color: #1e3644;\r\n    --primary-color-dark: #0e212e;\r\n    --primary-color2-light: #f6efdd;\r\n    --primary-color2: #e2c695;\r\n    --primary-color2-dark: #c58e3f;\r\n\r\n    /* Secondary Colors */\r\n    --secondary-color-dark: #87949a;\r\n    --secondary-color: #6c757d;\r\n    --secondary-color-hover: #4f565c;\r\n    --secondary-color-light: #363639;\r\n\r\n    /* Background Colors */\r\n    --bg-color-lightest: #B6CEDA;\r\n    --bg-color-lighter: #346176;\r\n    --bg-color-light: #1e3745;\r\n    --bg-color: #0f202d;\r\n\r\n    /* Text Colors */\r\n    --text-color2: #7B9EAE;\r\n    --text-color2-dark: #B6CEDA;\r\n    --text-color: #e0c494;\r\n    --text-color-dark: #c78f40;\r\n    --text-color-white: #ffffff;\r\n\r\n    /* Status Colors */\r\n    --success-color-light: #d4edda;\r\n    --success-color: #489e5c;\r\n    --success-color-dark: #155724;\r\n    --success-bg: #243c1e;\r\n    --success-text: #a1d2a7;\r\n\r\n    --error-color-light: #f8d7da;\r\n    --error-color: #dc3545;\r\n    --error-color-dark: #721c24;\r\n    --error-bg: #8c0000;\r\n    --error-text: #fde9ec;\r\n\r\n    --info-color-light: #005470;\r\n    --info-color: #0087a6;\r\n    --info-color-dark: #ccf2ff;\r\n\r\n    --warning-bg: #8f5e2b;\r\n    --warning-text: #ffeebe;\r\n    --warning-color: #ff9900;\r\n\r\n    /* Border Colors */\r\n    --border-color: #e0c494;\r\n    --border-color-light: #eee;\r\n\r\n    /* Common Styling */\r\n    --border-radius-small: 3px;\r\n    --border-radius: 4px;\r\n    --border-radius-large: 5px;\r\n    --border-radius-xlarge: 10px;\r\n\r\n    --box-shadow: 0 2px 5px rgba(0, 0, 0, 50);\r\n    --box-shadow-hover: 0 4px 8px rgba(0, 0, 0, 0.1);\r\n\r\n    /* Spacing */\r\n    --spacing-zero: 0;\r\n    --spacing-xx: 1px;\r\n    --spacing-xs: 3px;\r\n    --spacing-sm: 6px;\r\n    --spacing-md: 9px;\r\n    --spacing-lg: 15px;\r\n    --spacing-xl: 20px;\r\n    --spacing-xxl: 60px;\r\n\r\n    /* Font Sizes */\r\n    --font-size-small: 14px;\r\n    --font-size-normal: 16px;\r\n    --font-size-large: 18px;\r\n    --font-size-xl: 24px;\r\n\r\n    /* Grid Breakpoints */\r\n    --grid-breakpoint-sm: 150px;\r\n    --grid-breakpoint-md: 200px;\r\n    --grid-breakpoint-lg: 250px;\r\n    --grid-breakpoint-xl: 300px;\r\n}\r\n\r\n/* Base styles */\r\n/* Universal selector to hide scrollbars for all elements */\r\n* {\r\n    scrollbar-width: none; /* Firefox */\r\n    -ms-overflow-style: none; /* IE and Edge */\r\n}\r\n\r\n*::-webkit-scrollbar {\r\n    display: none; /* Chrome, Safari, Opera */\r\n}\r\n\r\nhtml::-webkit-scrollbar {\r\n    display: none; /* Hide scrollbar for Chrome, Safari and Opera */\r\n}\r\n\r\nbody {\r\n    font-family: Cairo, sans-serif;\r\n    line-height: 1.6;\r\n    margin: 0;\r\n    padding: 0;\r\n    background-color: var(--bg-color);\r\n    color: var(--text-color);\r\n    /* Hide scrollbar but allow scrolling */\r\n    -ms-overflow-style: none;  /* IE and Edge */\r\n    scrollbar-width: none;  /* Firefox */\r\n}\r\n\r\n/* Hide scrollbar for Chrome, Safari and Opera */\r\nbody::-webkit-scrollbar {\r\n    display: none;\r\n}\r\n\r\n.container {\r\n    width: 90%;\r\n    margin: 0 auto;\r\n    padding: var(--spacing-lg);\r\n}\r\n\r\n.hidden {\r\n    display: none;\r\n}\r\n\r\n/* Header and navigation */\r\nheader {\r\n    background: linear-gradient(to top right, var(--bg-color-lighter), var(--bg-color)); /* Gradient from left to right */\r\n    background-color: var(--primary-color);\r\n    color: var(--text-color-white);\r\n    padding: 1rem;\r\n    text-align: center;\r\n    margin: 0;\r\n    position: relative;\r\n}\r\n\r\nh1 {\r\n    margin: 10px;\r\n}\r\n\r\n\r\nh3 {\r\n    margin: 5px;\r\n\tborder-bottom: solid 1px var(--text-color-white);\r\n\tcolor: var(--text-color-white);\r\n\r\n}\r\nnav {\r\n    background-color: var(--primary-color-light);\r\n    padding: 0.5rem;\r\n}\r\n\r\nnav ul {\r\n    list-style-type: none;\r\n    margin: 0;\r\n    padding: 0;\r\n    display: flex;\r\n    justify-content: center;\r\n}\r\n\r\nnav ul li {\r\n    margin: 0 var(--spacing-sm);\r\n}\r\n\r\nnav ul li a {\r\n    color: var(--text-color-white);\r\n    text-decoration: none;\r\n    padding: var(--spacing-xs) var(--spacing-sm);\r\n    border-radius: var(--border-radius-small);\r\n}\r\n\r\nnav ul li a:hover {\r\n    background-color: var(--primary-color-dark);\r\n}\r\n.timestamp-info {\r\n    position: absolute;\r\n    top: 2px;\r\n    left: 2px;\r\n    font-size: 10px;\r\n    color: lightgray;\r\n    background-color: rgba(255,255,255,0.05);\r\n    padding: 2px 5px;\r\n    border-radius: 3px;\r\n    z-index: 1000;\r\n    max-width: 300px;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n}\r\n/* Main content area */\r\nmain {\r\n    padding: var(--spacing-lg);\r\n}\r\n\r\n/* Form elements */\r\nform {\r\n    background-color: var(--bg-color-lighter);\r\n    padding: var(--spacing-lg);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    margin: 0 auto;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--spacing-md);\r\n}\r\n\r\nlabel {\r\n    display: block;\r\n    margin-bottom: var(--spacing-zero);\r\n    font-weight: lighter;\r\n}\r\n\r\ninput[type=\"text\"],\r\ninput[type=\"number\"],\r\nselect {\r\n    width: 100%;\r\n    padding: 8px;\r\n    margin-bottom: var(--spacing-md);\r\n    border: 1px solid var(--border-color);\r\n    border-radius: var(--border-radius);\r\n    box-sizing: border-box;\r\n}\r\n\r\nbutton, .button {\r\n    font-family: Cairo, sans-serif;\r\n    background-color: var(--primary-color);\r\n    color: var(--text-color-white);\r\n    border: none;\r\n    padding-left: var(--spacing-md);\r\n    padding-right: var(--spacing-md);\r\n    margin: var(--spacing-xx);\r\n    border-radius: var(--border-radius);\r\n    cursor: pointer;\r\n    font-size: var(--font-size-normal);\r\n    text-wrap: wrap;\r\n    text-decoration: none;\r\n    display: inline-block;\r\n\ttext-align: center;\r\n}\r\n.text-clear {\r\n    text-decoration: none;\r\n    color: var(--text-color-white);\r\n\r\n}\r\nbutton:hover, .button:hover {\r\n    background-color: var(--primary-color-dark);\r\n}\r\n\r\n.disabled-button {\r\n    opacity: 0.2;\r\n    cursor: not-allowed;\r\n}\r\n\r\n.button.large {\r\n\tpadding: var(--spacing-md);\r\n\tpadding-left: var(--spacing-xl);\t\r\n\tpadding-right: var(--spacing-xl);\r\n}\t\r\n\r\n/* Game board styling */\r\n.game-board {\r\n    display: flex;\r\n    flex-direction: row;\r\n    flex-wrap: nowrap; /* Ensures everything stays in one row */\r\n    gap: var(--spacing-md);\r\n    margin-bottom: var(--spacing-lg);\r\n}\r\n\r\n.category {\r\n    flex: 1; /* Makes all categories take the same space */\r\n    min-width: 50px; /* Ensures boxes don't shrink too much */\r\n    text-align: center; /* Centers text */\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    overflow: hidden;\r\n}\r\n\r\n.category-header { /*for categories cards*/\r\n    background-color: var(--primary-color);\r\n    color: var(--text-color-white);\r\n    padding: var(--spacing-xs);\r\n    border-radius: var(--border-radius) var(--border-radius) 0 0;\r\n    text-align: center;\r\n    font-weight: bold;\r\n    display: grid;\r\n    justify-content: center;\r\n    align-items: center;\r\n    word-wrap: normal;\r\n}\r\n.category-header-grid { /*for category head in game board */\r\n    background-color: var(--primary-color);\r\n    color: var(--text-color-white);\r\n    padding: var(--spacing-xs);\r\n    border-radius: var(--border-radius) var(--border-radius) 0 0;\r\n    text-align: center;\r\n    font-weight: bold;\r\n    display: grid;\r\n    justify-content: center;\r\n    align-items: center;\r\n    word-wrap: normal;\r\n    font-size: min(1.6vw, 18px); /* Adjusts size dynamically */\t\r\n\theight: min(4.8vw, 300px);/* Adjusts size dynamically */\r\n    max-height: 53px;\r\n}\r\n.question-list {\r\n    padding: var(--spacing-xs);\r\n\tflex-direction: column;\r\n\tcolumn-fill: auto;\r\n}\r\n.question-box {\r\n    padding: var(--spacing-xs);\r\n    background-color: var(--primary-color2-light);\r\n\r\n}\r\n.question-item {\r\n    margin-bottom: var(--spacing-xs);\r\n}\r\n\r\n.question-button {\r\n    width: 100%;\r\n    padding: var(--spacing-zero);\r\n    background-color: var(--primary-color2);\r\n    color: #000;\r\n    border: none;\r\n    border-radius: var(--border-radius-large);\r\n    cursor: pointer;\r\n    font-size: 16px;\r\n}\r\n\r\n.question-button:hover {\r\n    background-color: var(--primary-color2-dark);\r\n}\r\n\r\n.question-button:disabled {\r\n    background-color: var(--primary-color2);\r\n}\r\n\r\n/* Double points effect */\r\n.question-button.doubled {\r\n    background-color: var(--success-color-dark);\r\n    color: var(--success-color-light); /* Black text */\r\n    animation: pulse 1s infinite;\r\n}\r\n\r\n@keyframes pulse {\r\n    0% { transform: scale(0.99); }\r\n    50% { transform: scale(1.03); }\r\n    100% { transform: scale(0.99); }\r\n}\r\n\r\n@keyframes textPulse {\r\n    0% { transform: scale(1); text-shadow: 0 0 0 transparent; }\r\n    50% { transform: scale(1.15); text-shadow: 0 0 10px rgba(220, 53, 69, 0.5); }\r\n    100% { transform: scale(1); text-shadow: 0 0 0 transparent; }\r\n}\r\n\r\n/* Timer styling */\r\n.timer-container {\r\n    /* Fixed container to prevent layout shifts */\r\n    height: 4em;\r\n    display: flex;\r\n    align-items: center;\r\n\tgrid-template-columns: repeat(auto-fit, minmax(50px, 150px));\r\n    justify-content: center;\r\n    overflow: visible; /* Allow the timer to visually overflow without affecting layout */\r\n}\r\n\r\n#timer {\r\n    font-size: 2em;\r\n    font-weight: bold;\r\n    transition: color 0.3s ease;\r\n    display: inline-block;\r\n    /* Fixed dimensions to prevent layout shifts */\r\n    min-width: 1.5em;\r\n    text-align: center;\r\n    transform-origin: center center;\r\n}\r\n\r\n.timer-pulsating {\r\n    animation: textPulse 1s infinite;\r\n}\r\n\r\n/* Question display styling */\r\n.question-display {\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    padding: var(--spacing-md);\r\n    margin-bottom: var(--spacing-md);\r\n}\r\n\r\n/* Flash messages - updated for animation */\r\n.flash-messages {\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    z-index: 1000;\r\n    margin-bottom: 0;\r\n    text-align: center;\r\n}\r\n\r\n/* Message styles - for notifications, alerts, etc. */\r\n.message {\r\n    padding: var(--spacing-sm);\r\n    border-radius: var(--border-radius);\r\n    margin-bottom: var(--spacing-sm);\r\n}\r\n\r\n.flash-message {\r\n    border-radius: 0 0 var(--border-radius) var(--border-radius);\r\n    animation: slideDown 0.5s ease-out forwards, slideUp 0.5s ease-in forwards 4.5s;\r\n    transform: translateY(-100%);\r\n}\r\n\r\n@keyframes slideDown {\r\n    0% {\r\n        transform: translateY(-100%);\r\n    }\r\n    100% {\r\n        transform: translateY(0);\r\n    }\r\n}\r\n\r\n@keyframes slideUp {\r\n    0% {\r\n        opacity: 1;\r\n        transform: translateY(0);\r\n    }\r\n    100% {\r\n        opacity: 0;\r\n        transform: translateY(-100%);\r\n    }\r\n}\r\n\r\n/* Flash message variants */\r\n.flash-message.success {\r\n    background-color: var(--success-color-light);\r\n    color: var(--success-color-dark);\r\n}\r\n\r\n.flash-message.error {\r\n    background-color: var(--error-color-light);\r\n    color: var(--error-color-dark);\r\n}\r\n\r\n.flash-message.result-correct {\r\n    background-color: var(--success-bg);\r\n    color: var(--success-text);\r\n}\r\n\r\n/* Current player styles */\r\n.current-turn {\r\n    margin: var(--spacing-lg) 0;\r\n    padding: var(--spacing-md);\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius);\r\n    border-left: 4px solid var(--primary-color-light);\r\n}\r\n\r\n.current-player {\r\n    font-weight: bold;\r\n}\r\n\r\n.your-turn {\r\n    color: var(--success-color);\r\n}\r\n\r\n/* Tool button styles */\r\n.tool-buttons {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--spacing-md);\r\n    margin-top: var(--spacing-md);\r\n}\r\n\r\n.tool-btn {\r\n    cursor: pointer;\r\n    transition: all 0.3s ease;\r\n}\r\n\r\n.dp {\r\n    background-color: var(--primary-color-light);\r\n}\r\n\r\n.cq {\r\n    background-color: var(--primary-color-light);\r\n}\r\n\r\n.sq {\r\n    background-color: var(--primary-color-light);\r\n}\r\n\r\n.tool-btn:hover:not([disabled]) {\r\n    transform: translateY(-2px);\r\n    box-shadow: var(--box-shadow-hover);\r\n}\r\n\r\n.tool-btn:active:not([disabled]) {\r\n    transform: translateY(0);\r\n    box-shadow: none;\r\n}\r\n\r\n/* Live status styles */\r\n.live-status-section {\r\n    margin: var(--spacing-xl) 0;\r\n    padding: var(--spacing-lg);\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius);\r\n    border: 1px solid var(--border-color);\r\n}\r\n\r\n.status-container {\r\n    max-height: 300px;\r\n    overflow-y: auto;\r\n    padding: var(--spacing-md);\r\n    background-color: var(--bg-color);\r\n    border-radius: var(--border-radius);\r\n}\r\n\r\n.status-updates {\r\n    display: flex;\r\n    flex-direction: column;\r\n}\r\n\r\n.status-message {\r\n    margin: var(--spacing-xs) 0;\r\n    padding: var(--spacing-xs) var(--spacing-sm);\r\n    border-radius: var(--border-radius);\r\n    background-color: var(--bg-color-lighter);\r\n    border-left: 3px solid var(--text-color);\r\n}\r\n\r\n.status-success {\r\n    background-color: var(--success-bg);\r\n    color: var(--success-text);\r\n    border-left-color: var(--success-color);\r\n}\r\n\r\n.status-error {\r\n    background-color: var(--error-bg);\r\n    color: var(--error-color-light);\r\n    border-left-color: var(--error-color);\r\n}\r\n\r\n.status-info {\r\n    background-color: var(--bg-color-lighter);\r\n}\r\n\r\n.status-warning {\r\n    margin: var(--spacing-xs) 0;\r\n    padding: var(--spacing-xs) var(--spacing-sm);\r\n    border-radius: var(--border-radius);\r\n    background-color: var(--bg-color-lighter);\r\n    border-left: 3px solid var(--text-color);\r\n}\r\n\r\n.turn-indicator {\r\n    margin-top: var(--spacing-xs);\r\n    font-style: italic;\r\n}\r\n\r\n/* Leaderboard */\r\n.leaderboard {\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    padding: var(--spacing-lg);\r\n    margin-bottom: var(--spacing-lg);\r\n}\r\n\r\n.leaderboard-title {\r\n    font-size: 24px;\r\n    margin-bottom: var(--spacing-lg);\r\n    text-align: center;\r\n}\r\n\r\n.leaderboard-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n}\r\n\r\n.leaderboard-table th,\r\n.leaderboard-table td {\r\n    padding: var(--spacing-sm);\r\n    text-align: center;\r\n    border-bottom: 1px solid var(--border-color);\r\n}\r\n\r\n.leaderboard-table th {\r\n    background-color: var(--bg-color-lighter);\r\n    font-weight: bold;\r\n}\r\n\r\n.leaderboard-table tr:nth-child(even) {\r\n    background-color: var(--bg-color-light);\r\n}\r\n\r\n.leaderboard-table tr:hover {\r\n    background-color: var(--secondary-color-light);\r\n}\r\n\r\n/* Content section - generic container for page content */\r\n.content-section {\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    padding: var(--spacing-lg);\r\n    margin-bottom: var(--spacing-lg);\r\n}\r\n\r\n.content-section.mb-large {\r\n    margin-bottom: var(--spacing-xxl);\r\n}\r\n\r\n/* Leaderboard page styles */\r\n.leaderboard-section {\r\n    /* Using content-section for consistent styling */\r\n    margin-bottom: var(--spacing-xxl);\r\n}\r\n\r\n.leaderboard-header {\r\n    margin-bottom: var(--spacing-lg);\r\n    padding-bottom: var(--spacing-sm);\r\n    border-bottom: 1px solid var(--border-color-light);\r\n    text-align: center;\r\n}\r\n\r\n.leaderboard-display {\r\n    padding: var(--spacing-lg);\r\n}\r\n\r\n.leaderboard-table,\r\n.leaderboard-table table {\r\n    /* Using data-table for consistent styling */\r\n    margin-bottom: var(--spacing-xl);\r\n}\r\n\r\n.leaderboard-table td {\r\n    padding: var(--spacing-md); /* Override data-table padding */\r\n}\r\n\r\n.leaderboard-table tr:first-child td {\r\n    font-weight: bold;\r\n}\r\n\r\n.no-scores {\r\n    text-align: center;\r\n    padding: var(--spacing-xl);\r\n    background-color: var(--bg-color-light);\r\n    border-radius: var(--border-radius-large);\r\n    margin-bottom: var(--spacing-xl);\r\n}\r\n\r\n.leaderboard-actions {\r\n    display: flex;\r\n    justify-content: center;\r\n    margin-top: var(--spacing-lg);\r\n}\r\n\r\n.actions {\r\n    margin: var(--spacing-lg);\r\n}\r\n\r\n/* Data table - generic table styling */\r\n.data-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: var(--spacing-md);\r\n}\r\n\r\n.data-table th,\r\n.data-table td {\r\n    padding: var(--spacing-sm);\r\n    text-align: left;\r\n    border-bottom: 1px solid var(--border-color);\r\n}\r\n\r\n.data-table th {\r\n    background-color: var(--bg-color-lighter);\r\n    font-weight: bold;\r\n}\r\n\r\n.data-table tr:nth-child(even) {\r\n    background-color: var(--bg-color-light);\r\n}\r\n\r\n.data-table tr:hover {\r\n    background-color: var(--secondary-color-light);\r\n}\r\n\r\n/* Questions table */\r\n.questions-table {\r\n    /* Using data-table for consistent styling */\r\n    margin-top: var(--spacing-lg);\r\n}\r\n\r\n/* Category grid */\r\n.category-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\r\n    gap: var(--spacing-lg);\r\n    margin-top: var(--spacing-lg);\r\n}\r\n\r\n.category-card {\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    padding: var(--spacing-sm);\r\n}\r\n\r\n.edit-icon {\r\n    color: var(--info-color);\r\n    font-size: 1.2em;\r\n    margin-right: 0;\r\n}\r\n\r\n.delete-icon {\r\n    color: var(--error-color);\r\n    font-size: 1.2em;\r\n    background: none;\r\n    border: none;\r\n    padding: 0;\r\n    cursor: pointer;\r\n}\r\n\r\n.category-actions-icons {\r\n    display: block;\r\n    justify-content: center;\r\n    gap: var(--spacing-md);\r\n    flex-basis: 100%;\r\n    margin-top: var(--spacing-xs);\r\n}\r\n\r\n.question-actions {\r\n    white-space: nowrap;\r\n    text-align: center;\r\n}\r\n\r\n.question-count {\r\n    font-weight: bold;\r\n    color: var(--info-color-dark);\r\n    margin: var(--spacing-sm) 0;\r\n}\r\n\r\n.category-actions {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: var(--spacing-sm);\r\n    margin-top: var(--spacing-md);\r\n}\r\n\r\n.category-actions .button {\r\n    text-align: center;\r\n}\r\n\r\n/* Game room */\r\n.game-room-section {\r\n    /* Using content-section for consistent styling */\r\n    margin-bottom: var(--spacing-xxl);\r\n}\r\n\r\n.room-header {\r\n    margin-bottom: var(--spacing-lg);\r\n    padding-bottom: var(--spacing-sm);\r\n    border-bottom: 1px solid var(--border-color-light);\r\n}\r\n\r\n.room-id {\r\n    font-weight: bold;\r\n    background-color: var(--bg-color-dark);\r\n    padding: var(--spacing-xs) var(--spacing-xs);\r\n    border-radius: var(--border-radius-small);\r\n}\r\n\r\n.section {\r\n    margin-bottom: var(--spacing-xs);\r\n    padding: var(--spacing-md);\r\n    background-color: var(--bg-color-light);\r\n    border-radius: var(--border-radius-large);\r\n}\r\n\r\n.tools-container {\r\n    display: flex;\r\n    gap: var(--spacing-md);\r\n    flex-wrap: wrap;\r\n}\r\n\r\n.tool {\r\n    flex: 1;\r\n    min-width: var(--grid-breakpoint-md);\r\n    padding: var(--spacing-md);\r\n    border-radius: var(--border-radius-large);\r\n}\r\n\r\n.tool h5 {\r\n    margin-top: 0;\r\n}\r\n\r\n.tool select {\r\n    width: 100%;\r\n    margin-bottom: var(--spacing-sm);\r\n}\r\n\r\n.game-board-section {\r\n    margin-bottom: var(--spacing-lg);\r\n    margin-top: var(--spacing-lg);\r\n}\r\n\r\n.game-actions {\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: var(--spacing-xs);\r\n    margin-top: var(--spacing-lg);\r\n}\r\n\r\n/* Form groups and additional form elements */\r\n/* Form group styles - organized by size and layout */\r\n\r\n/* Base form group styles */\r\n.form-group {\r\n    margin-bottom: var(--spacing-zero);\r\n    display: contents;\r\n    flex-grow: 1;\r\n}\r\n\r\n/* Form group layout variants */\r\n.form-group.flow-root {\r\n    display: flow-root;\r\n    align-content: flex-start;\r\n}\r\n\r\n.form-group.grid {\r\n    flex-basis: 100%;\r\n    display: inline-block;\r\n    grid-template-columns: repeat(auto-fill, minmax(var(--grid-breakpoint-lg), 1fr));\r\n    gap: var(--spacing-lg);\r\n}\r\n\r\n.form-group.grid1 {\r\n    flex-basis: 100%;\r\n    display: inline-block;\r\n    grid-template-columns: repeat(auto-fill, minmax(200px, 350px));\r\n    gap: var(--spacing-lg);\r\n}\r\n\r\n.form-group.inline {\r\n    display: inline-grid;\r\n    width: 100%;\r\n    flex-basis: 100%;\r\n    gap: var(--spacing-sm);\r\n}\r\n\r\n.form-group.full-margin {\r\n    margin: var(--spacing-xx);\r\n    flex-basis: 100%;\r\n    gap: var(--spacing-xs);\r\n}\r\n\r\n.form-group.align-end {\r\n    align-content: flex-end;\r\n    gap: var(--spacing-md);\r\n}\r\n\r\n.form-group.centered {\r\n    width: 100%;\r\n\talign-content: center;\r\n    justify-content: center;\r\n    gap: var(--spacing-md);\r\n}\r\n\r\n.form-group.stack {\r\n\tdisplay: inline-flex;\r\n    justify-content: flex-start;\r\n    gap: var(--spacing-sm);\r\n}\r\n/* Form group width variants */\r\n.form-group.equal-lg {\r\n    margin: var(--spacing-xs);\r\n\tgap: var(--spacing-xs);\r\n    display: inline-flex;\r\n    align-content: flex-end;\r\n\twidth: 350px;\r\n\tflex-grow: 1;\r\n\tflex-shrink: 1;\r\n}\r\n\r\n.form-group.equal-md {\r\n    margin: var(--spacing-xs);\r\n\tgap: var(--spacing-xs);\r\n    display: inline-flex;\r\n    align-content: flex-start;\r\n\twidth: 250px;\r\n\tflex-grow: 1;\r\n\tflex-shrink: 1;\r\n}\r\n\r\n.form-group.equal-sm {\r\n    margin: var(--spacing-xs);\r\n\tgap: var(--spacing-xs);\r\n    display: inline-flex;\r\n    align-content: flex-end;\r\n\twidth: 150px;\r\n\tflex-grow: 1;\r\n\tflex-shrink: 1;\r\n}\r\n\r\n\r\n/* Legacy class names for backward compatibility */\r\n.form-group-grid { \r\n    margin-bottom: var(--spacing-xs); \r\n    display: flex; \r\n    flex-basis: 100%; \r\n    gap: var(--spacing-xs); \r\n    flex-wrap: wrap;\r\n}\r\n\r\n.form-group-inline { \r\n    margin: var(--spacing-zero);\r\n    display: inline-grid; \r\n    width: 100%; \r\n    gap: var(--spacing-md);\r\n}\r\n\r\n.form-group-inline-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));\r\n    gap: var(--spacing-md);\r\n    margin: var(--spacing-zero);\r\n}\r\n\r\n.form-group-xx { \r\n    margin: var(--spacing-zero);\r\n    display: flex;\r\n    flex-basis: 100%;\r\n    gap: var(--spacing-xs);\r\n}\r\n\r\n.form-group-grid1 { \r\n    margin-bottom: var(--spacing-zero); \r\n    display: flex; \r\n    flex-grow: 1; \r\n\tflex-wrap: wrap;\r\n    align-content: flex-start;\r\n    gap: var(--spacing-md);\r\n    grid-template-columns: repeat(auto-fill, minmax(200px, 350px));\r\n}\r\n\r\n.form-group-grid2 { \r\n    margin-bottom: var(--spacing-zero); \r\n    display: flex; \r\n    flex-grow: 1; \r\n    align-content: flex-end; \r\n    gap: var(--spacing-md);\r\n}\r\n\r\n.form-group-grid3 { \r\n    margin-bottom: var(--spacing-zero); \r\n    display: flex; \r\n    width: 100%; \r\n    justify-content: center; \r\n    gap: var(--spacing-md);\r\n}\r\n\r\n.form-group-equal-lg { \r\n    margin: var(--spacing-zero); \r\n    display: grid;\r\n\tcolumn-fill: balance;\r\n    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\r\n    gap: var(--spacing-sm);\r\n}\r\n\r\n.form-group-equal-md { \r\n    margin: var(--spacing-zero); \r\n    display: grid;\r\n\tcolumn-fill: balance;\r\n    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\r\n    gap: var(--spacing-sm);\r\n}\r\n\r\n.form-group-equal-sm { \r\n    margin-top: var(--spacing-zero); \r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\r\n    gap: var(--spacing-sm);\r\n}\r\n.form-actions {\r\n    margin-top: var(--spacing-sm);\r\n    display: flex;\r\n    justify-content: center;\r\n\tvertical-align: baseline;\r\n    flex-basis: 100%;\r\n    gap: var(--spacing-sm);\r\n}\r\n\r\n.form-actions.clear {\r\n\tbackground-color: transparent;\r\n\tpadding: 0;\r\n\tbox-shadow: 0 0 0 rgba(0, 0, 0, 0);\r\n}\r\n.form.clear {\r\n\tbackground-color: transparent;\r\n\tpadding: 0;\r\n\tbox-shadow: 0 0 0 rgba(0, 0, 0, 0);\r\n}\r\n\r\ntextarea {\r\n    width: 100%;\r\n    padding: 8px;\r\n    border: 1px solid var(--border-color);\r\n    border-radius: var(--border-radius);\r\n    box-sizing: border-box;\r\n    resize: vertical;\r\n}\r\n\r\n.checkbox-group label {\r\n    display: inline;\r\n    margin-left: var(--spacing-xs);\r\n}\r\n\r\ninput[type=\"file\"] {\r\n    width: 100%;\r\n    padding: 8px;\r\n    border: 1px solid var(--border-color);\r\n    border-radius: var(--border-radius);\r\n    box-sizing: border-box;\r\n}\r\n\r\nsmall {\r\n    display: block;\r\n    margin-top: var(--spacing-xs);\r\n    color: var(--text-color-light);\r\n}\r\n\r\n/* Import page styles */\r\n.import-section {\r\n    /* Using content-section for consistent styling */\r\n}\r\n\r\n.template-links {\r\n    margin: var(--spacing-lg) 0;\r\n    padding: var(--spacing-md);\r\n    background-color: var(--bg-color-light);\r\n    border-radius: var(--border-radius-large);\r\n}\r\n\r\n.template-buttons {\r\n    font-family: Cairo, sans-serif;\r\n    display: flex;\r\n    gap: var(--spacing-sm);\r\n    margin-top: var(--spacing-sm);\r\n}\r\n\r\n.import-instructions {\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    padding: var(--spacing-lg);\r\n}\r\n\r\n.import-instructions h2 {\r\n    margin-top: 0;\r\n}\r\n\r\n.import-instructions ol,\r\n.import-instructions ul {\r\n    padding-left: var(--spacing-lg);\r\n}\r\n\r\n.import-instructions li {\r\n    margin-bottom: var(--spacing-sm);\r\n}\r\n\r\n/* Edit category page styles */\r\n\r\n.button.secondary {\r\n    background-color: var(--secondary-color);\r\n}\r\n\r\n/* Edit category page styles */\r\n\r\n.button.red-button {\r\n    background-color: var(--error-color);\r\n}\r\n\r\n.button.red-button:hover {\r\n    background-color: var(--error-color-dark);\r\n}\r\n\r\n.button.secondary:hover {\r\n    background-color: var(--secondary-color-hover);\r\n}\r\n.button-no-hover {\r\n    background-color: var(--primary-color);\r\n    padding-left: var(--spacing-md);\r\n    padding-right: var(--spacing-md);\r\n    margin: var(--spacing-xx);\r\n    border-radius: var(--border-radius);\r\n    text-wrap: wrap;\r\n    display: inline-block;\r\n\ttext-align: center;\r\n}\r\n\r\n/* Question page styles */\r\n.question-section {\r\n    /* Using content-section for consistent styling */\r\n    margin-bottom: 60px;\r\n}\r\n\r\n/* Result page styles */\r\n.result-section {\r\n    /* Using content-section for consistent styling */\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.result-header {\r\n    margin-bottom: var(--spacing-lg);\r\n    padding-bottom: var(--spacing-sm);\r\n    border-bottom: 1px solid var(--border-color-light);\r\n}\r\n\r\n.result-display {\r\n\talign-content: center;\r\n    text-align: center;\r\n    padding: var(--spacing-lg);\r\n}\r\n\r\n.result {\r\n    padding: var(--spacing-xx);\r\n    border-radius: var(--border-radius-xlarge);\r\n\tborder: solid 2px;\r\n    margin-left: 15%;\r\n    margin-right: 15%;\r\n}\r\n\r\n.result.correct{\r\n    background-color: var(--success-bg);\r\n    color: var(--success-text);\r\n    animation: zoomin 1s;\r\n    animation-timing-function: ease-in;\r\n    animation-name: zoomin;\r\n    animation-duration: 0.3s;\r\n\r\n}\r\n@keyframes zoomin {\r\n    0% {transform: scale(0);opacity: 0;}\r\n    80% {transform: scale(1.3);opacity: 70%;}\r\n    90% {transform: scale(0.80);}\r\n    100% {transform: scale(1);opacity: 100%;}\r\n}\r\n\r\n.result.incorrect {\r\n    background-color: var(--error-bg);\r\n    color: var(--error-text);\r\n    animation: zoomin 1s;\r\n    animation-timing-function: ease-in;\r\n    animation-name: zoomin;\r\n    animation-duration: 0.3s;\r\n}\r\n\r\n.result-icon {\r\n    font-size: 35px;\r\n    margin: var(--spacing-md) 0;\r\n}\r\n\r\n.score-display {\r\n    margin-top: var(--spacing-xl);\r\n    padding: var(--spacing-lg);\r\n    background-color: var(--bg-color-light);\r\n    border-radius: var(--border-radius-large);\r\n}\r\n\r\n.score {\r\n    font-size: 48px;\r\n    font-weight: bold;\r\n    color: var(--primary-color-light);\r\n}\r\n\r\n.result-actions {\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: var(--spacing-md);\r\n    margin-top: var(--spacing-xl);\r\n}\r\n\r\n/* Answer display */\r\n.answer-display {\r\n    margin: 20px 0;\r\n    padding: 15px;\r\n    background-color: var(--bg-color-light);\r\n    border-radius: 5px;\r\n}\r\n\r\n/* Report button */\r\n.report-button {\r\n    margin-top: 10px;\r\n    padding: 5px 10px;\r\n    background-color: var(--secondary-color);\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-size: 0.9em;\r\n    border: 1px solid var(--text-color);\r\n    color: var(--text-color);\r\n}\r\n\r\n.report-button:hover {\r\n    background-color: var(--secondary-color-hover);\r\n}\r\n\r\n.report-confirmation {\r\n    margin-top: 10px;\r\n    padding: 10px;\r\n    background-color: var(--bg-color-light);\r\n    border: 1px solid var(--text-color);\r\n    border-radius: 4px;\r\n}\r\n\r\n.confirm-report {\r\n    background-color: #dc3545;\r\n    color: white;\r\n}\r\n\r\n.cancel-report {\r\n    background-color: #6c757d;\r\n    color: white;\r\n}\r\n\r\n/* Modal styles */\r\n.modal {\r\n    display: none;\r\n    position: fixed;\r\n    z-index: 1000;\r\n    left: 0;\r\n    top: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    background-color: rgba(0, 0, 0, 0.5);\r\n    animation: fadeIn 0.3s;\r\n}\r\n\r\n.modal-content {\r\n    position: relative;\r\n    background-color: var(--bg-color);\r\n    margin: 15% auto;\r\n    padding: 20px;\r\n    border: 1px solid #888;\r\n    width: 80%;\r\n    max-width: 500px;\r\n    border-radius: 5px;\r\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\r\n    animation: slideIn 0.3s;\r\n    text-align: center;\r\n}\r\n\r\n.close-modal {\r\n    position: absolute;\r\n    top: 10px;\r\n    right: 15px;\r\n    color: var(--text-color);\r\n    font-size: 28px;\r\n    font-weight: bold;\r\n    cursor: pointer;\r\n}\r\n\r\n.close-modal:hover,\r\n.close-modal:focus {\r\n    color: black;\r\n    text-decoration: none;\r\n}\r\n\r\n@keyframes fadeIn {\r\n    from {opacity: 0}\r\n    to {opacity: 1}\r\n}\r\n@keyframes fadeOut {\r\n    from {opacity: 1}\r\n    to {opacity: 0}\r\n}\r\n\r\n.modal.fade-out {\r\n    animation: fadeOut 0.3s forwards;\r\n    pointer-events: none; /* Allows interaction with the page */\r\n}\r\n\r\n@keyframes slideIn {\r\n    from {transform: translateY(-50px); opacity: 0;}\r\n    to {transform: translateY(0); opacity: 1;}\r\n}\r\n\r\n.question-header {\r\n    margin-bottom: var(--spacing-lg);\r\n    padding-bottom: var(--spacing-sm);\r\n    border-bottom: 1px solid var(--border-color-light);\r\n}\r\n\r\n/* Badge styles - for small labels and indicators */\r\n.badge {\r\n    display: inline-block;\r\n    padding: 3px 8px;\r\n    border-radius: var(--border-radius-small);\r\n    font-weight: bold;\r\n}\r\n\r\n/* Legacy class names for backward compatibility */\r\n.blue-badge { background-color: var(--info-color-light); color: var(--info-color-dark); }\r\n.green-badge { background-color: var(--success-bg); color: var(--success-text); }\r\n.red-badge { background-color: var(--error-bg); color: var(--error-text); }\r\n\r\n/* Colored box styles for highlighting content */\r\n.colored-box {\r\n\tmargin: 0;\r\n\tpadding: 10px;\r\n\tbackground-color: var(--bg-color-light);\r\n\tborder-radius: 5px;\r\n\tborder-left: 4px solid;\r\n    border-left-color: var(--secondary-color-dark);\r\n}\r\n\r\n.colored-box.blue {\r\n\tborder-left-color: var(--info-color);\r\n}\r\n\r\n.colored-box.green {\r\n\tborder-left-color: var(--success-color);\r\n}\r\n\r\n/* Legacy class names for backward compatibility */\r\n.blue-box {\r\n    margin: 0;\r\n    padding: var(--spacing-md);\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius);\r\n    border-left: 4px solid var(--info-color);\r\n}\r\n\r\n.green-box {\r\n    margin: 0;\r\n    padding: var(--spacing-xs);\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius);\r\n    border-left: 4px solid var(--success-color);\r\n}\r\n\r\n.question-text {\r\n    font-size: var(--font-size-xl);\r\n    margin-bottom: var(--spacing-md);\r\n    padding: var(--spacing-lg);\r\n    background-color: var(--bg-color-light);\r\n    border-radius: var(--border-radius-large);\r\n    border-left: 5px solid var(--text-color);\r\n}\r\n\r\n.options {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: var(--spacing-md);\r\n    margin-bottom: var(--spacing-xl);\r\n}\r\n\r\n.option {\r\n    display: flex;\r\n    flex-grow: 1;\r\n    max-width: 25%;\r\n    align-items: center;\r\n    padding: var(--spacing-md);\r\n    background-color: var(--bg-color-dark);\r\n    border-radius: var(--border-radius-large);\r\n    cursor: pointer;\r\n    transition: background-color 0.2s;\r\n    text-decoration: none;\r\n}\r\n\r\n.option:hover {\r\n    background-color: var(--bg-color-darker);\r\n}\r\n\r\n.option input[type=\"radio\"] {\r\n    margin-right: var(--spacing-sm);\r\n}\r\n\r\n.text-answer {\r\n    margin-bottom: var(--spacing-xl);\r\n}\r\n\r\n.text-answer label {\r\n    display: block;\r\n    margin-bottom: var(--spacing-sm);\r\n    font-weight: bold;\r\n}\r\n\r\n.text-answer input[type=\"text\"] {\r\n    width: 100%;\r\n    padding: var(--spacing-sm);\r\n    font-size: var(--font-size-normal);\r\n    border: 1px solid var(--border-color);\r\n    border-radius: var(--border-radius-large);\r\n}\r\n\r\n.inline-form {\r\n    display: inline;\r\n}\r\n\r\n/* Create room styles */\r\n.page-section, .join-room-section {\r\n    /* Using content-section for consistent styling */\r\n    margin-bottom: var(--spacing-md);\r\n}\r\n\r\n.categories-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fill, minmax(var(--grid-breakpoint-md), 1fr));\r\n    gap: var(--spacing-sm);\r\n    margin-top: var(--spacing-sm);\r\n}\r\n\r\n.category-checkbox {\r\n    display: flex;\r\n    align-items: center;\r\n\tbackground-color: var(--bg-color-light);\r\n    padding: var(--spacing-xs);\r\n    border-radius: var(--border-radius);\r\n}\r\n\r\n.category-checkbox input[type=\"checkbox\"] {\r\n    margin-right: var(--spacing-sm);\r\n}\r\n\r\n/* Utility classes */\r\n.text-center {\r\n    text-align: center;\r\n\tmargin: var(--spacing-xs);\r\n}\r\n\r\n.text-nomargin {\r\n\tmargin: 0;\r\n}\r\n\r\n/* Categories inline container */\r\n.categories-inline-container {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: var(--spacing-sm);\r\n    margin-bottom: var(--spacing-md);\r\n}\r\n\r\n.category-item {\r\n    background-color: var(--bg-color-light);\r\n    color: var(--text-color-white);\r\n\tfont-size: var(--font-size-small);\r\n    padding: var(--spacing-xs) var(--spacing-sm);\r\n    border-radius: var(--border-radius);\r\n    cursor: pointer;\r\n    transition: background-color 0.2s;\r\n    user-select: none;\r\n}\r\n\r\n.category-item:hover {\r\n    background-color: var(--primary-color-light);\r\n}\r\n\r\n.category-item.selected {\r\n    background-color: var(--primary-color2-dark);\r\n    color: var(--text-color-white);\r\n    font-weight: bold;\r\n}\r\n\r\n.selected-categories-container {\r\n    margin-top: var(--spacing-sm);\r\n    margin-bottom: var(--spacing-sm);\r\n    font-size: var(--font-size-small);\r\n}\r\n\r\n.mt-20 {\r\n    margin-top: var(--spacing-lg);\r\n}\r\n\r\n.mb-20 {\r\n    margin-bottom: var(--spacing-lg);\r\n}\r\n\r\n/* Home page styles */\r\n.welcome-section {\r\n    /* Using content-section for consistent styling */\r\n    margin-bottom: 60px;\r\n}\r\n\r\n.features {\r\n    display: flex;\r\n    gap: var(--spacing-lg);\r\n    margin: var(--spacing-xl) 0;\r\n}\r\n\r\n.feature {\r\n    flex: 1;\r\n    background-color: var(--bg-color-light);\r\n    padding: var(--spacing-lg);\r\n    border-radius: var(--border-radius-large);\r\n    text-align: center;\r\n}\r\n\r\n.how-to-play {\r\n    margin-top: var(--spacing-xl);\r\n}\r\n\r\n.how-to-play ol {\r\n    padding-left: var(--spacing-lg);\r\n}\r\n\r\n.how-to-play ul {\r\n    padding-left: var(--spacing-lg);\r\n    margin-top: var(--spacing-sm);\r\n}\r\n\r\n/* Delete button and danger zone */\r\n.delete-section {\r\n    margin-top: var(--spacing-xl);\r\n    padding: var(--spacing-md);\r\n    border: 2px solid var(--error-color);\r\n    border-radius: var(--border-radius-large);\r\n    background-color: var(--error-bg);\r\n}\r\n\r\n.delete-section h3 {\r\n    color: var(--error-color);\r\n    margin-top: 0;\r\n}\r\n\r\n.delete-button {\r\n    background-color: var(--error-color) !important;\r\n    color: white !important;\r\n}\r\n\r\n.delete-button:hover {\r\n    background-color: var(--error-color-dark) !important;\r\n}\r\n.success-button {\r\n    background-color: var(--success-color) !important;\r\n    color: white !important;\r\n}\r\n\r\n.success-button:hover {\r\n    background-color: var(--success-color-dark) !important;\r\n}\r\n\r\n/* Statistics styles */\r\n.stats-container {\r\n    /* Using content-section for consistent styling */\r\n}\r\n\r\n.stats-overview {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    gap: var(--spacing-lg);\r\n    margin-bottom: var(--spacing-lg);\r\n}\r\n\r\n.stat-card {\r\n    flex: 1;\r\n\tdisplay: grid;\r\n    background-color: var(--bg-color-lighter);\r\n    padding: var(--spacing-md);\r\n    border-radius: var(--border-radius-large);\r\n    text-align: center;\r\n    border-left: 5px solid var(--info-color);\r\n}\r\n\r\n.stat-card h3 {\r\n    margin-top: 0;\r\n    color: var(--text-color-light);\r\n    font-size: 1rem;\r\n}\r\n\r\n.stat-value {\r\n    font-size: 2rem;\r\n    font-weight: bold;\r\n    color: var(--text-color);\r\n    margin: var(--spacing-sm) 0;\r\n}\r\n\r\n.stats-details {\r\n    display: flex;\r\n    gap: var(--spacing-lg);\r\n    flex-wrap: wrap;\r\n}\r\n\r\n.stat-section {\r\n    flex: 1;\r\n    min-width: 250px;\r\n    background-color: var(--bg-color-light);\r\n    padding: var(--spacing-md);\r\n    border-radius: var(--border-radius-large);\r\n}\r\n\r\n.stat-section h3 {\r\n    margin-top: 0;\r\n    padding-bottom: var(--spacing-xs);\r\n    border-bottom: 1px solid var(--border-color-light);\r\n    color: var(--text-color-light);\r\n}\r\n\r\n.stats-table {\r\n\twidth: 100%;\r\n\ttext-align: center;\r\n    /* Using data-table for consistent styling */\r\n}\r\n\r\n.stats-table tr:nth-child(even) {\r\n    background-color: var(--bg-color-lighter); /* Override data-table background */\r\n}\r\n\r\n/* This file can be expanded with additional styles as needed */\r\n\r\n/* Footer */\r\nfooter {\r\n    background-color: var(--primary-color);\r\n    color: var(--text-color-white);\r\n    text-align: center;\r\n    padding: 0;\r\n    position: sticky;\r\n    bottom: 0;\r\n    width: 100%;\r\n    height: 2vh;\r\n    min-height: 25px;\r\n    z-index: 1000; /* Ensure footer is on top of all other elements */\r\n}\r\n\r\n/* Admin link styles */\r\n.admin-link {\r\n    color: var(--bg-color-darkest);\r\n    font-size: 0.8em;\r\n    text-decoration: none;\r\n    margin-left: 10px;\r\n    opacity: 0.5;\r\n    transition: opacity 0.3s ease;\r\n}\r\n\r\n.admin-link:hover {\r\n    opacity: 1;\r\n    text-decoration: underline;\r\n}\r\n\r\n.admin-link.hidden {\r\n    opacity: 0.1;\r\n}\r\n\r\n/* Admin login in header */\r\n.admin-login-container {\r\n    position: absolute;\r\n    top: 50%;\r\n    right: 20px;\r\n    display: flex;\r\n    align-items: center;\r\n    transform: translateY(-50%);\r\n}\r\n\r\n.admin-login-btn {\r\n    background-color: var(--primary-color-dark);\r\n    color: var(--text-color-white);\r\n    border: none;\r\n    padding: 5px 10px;\r\n    border-radius: var(--border-radius-small);\r\n    cursor: pointer;\r\n    font-size: 0.8em;\r\n    transition: background-color 0.3s ease;\r\n}\r\n\r\n.admin-login-btn:hover {\r\n    background-color: var(--primary-color);\r\n}\r\n\r\n.admin-login-dropdown {\r\n    position: absolute;\r\n    top: 100%;\r\n    right: 0;\r\n    background-color: var(--bg-color-dark);\r\n    border-radius: var(--border-radius);\r\n    box-shadow: var(--box-shadow);\r\n    padding: 15px;\r\n    width: 250px;\r\n    z-index: 1001;\r\n    display: none;\r\n}\r\n\r\n.admin-login-dropdown input[type=\"text\"],\r\n.admin-login-dropdown input[type=\"password\"] {\r\n    width: 100%;\r\n    padding: 8px;\r\n    margin-bottom: 10px;\r\n    border: 1px solid var(--border-color);\r\n    border-radius: var(--border-radius);\r\n    box-sizing: border-box;\r\n}\r\n\r\n.admin-login-dropdown .form-group {\r\n    margin-bottom: 15px;\r\n\tcolor: var(--info-color-dark);\r\n}\r\n\r\n.admin-login-dropdown.show {\r\n    display: block;\r\n}\r\n\r\n.admin-welcome {\r\n    color: var(--text-color-white);\r\n    font-size: 0.9em;\r\n    margin-right: 10px;\r\n}\r\n\r\n.admin-logout-form {\r\n    display: inline;\r\n\tmargin: 0;\r\n\tpadding: 0;\r\n\r\n}\r\n\r\n.admin-logout-btn {\r\n    background-color: var(--error-color-dark);\r\n    color: var(--text-color-white);\r\n    border: none;\r\n    padding: 3px 8px;\r\n    border-radius: var(--border-radius-large);\r\n    cursor: pointer;\r\n    font-size: 0.8em;\r\n    transition: background-color 0.3s ease;\r\n}\r\n\r\n.admin-logout-btn:hover {\r\n    background-color: var(--error-color);\r\n}\r\n\r\n.admin-controls-link {\r\n    background-color: var(--primary-color);\r\n    color: var(--text-color-white);\r\n    border: none;\r\n    padding: 3px 8px;\r\n    border-radius: var(--border-radius-large);\r\n    cursor: pointer;\r\n    font-size: 0.8em;\r\n    transition: background-color 0.3s ease;\r\n    text-decoration: none;\r\n    display: inline-block;\r\n    margin-right: 10px;\r\n}\r\n\r\n.admin-controls-link:hover {\r\n    background-color: var(--primary-color-light);\r\n    color: var(--text-color-white);\r\n    text-decoration: none;\r\n}\r\n\r\n/* Host controls styles */\r\n.host-controls {\r\n    margin: 15px 0;\r\n    padding: 15px;\r\n    background-color: var(--bg-color-light);\r\n    border-radius: 5px;\r\n    border-left: 4px solid var(--success-color);\r\n}\r\n\r\n.host-action-selector {\r\n    margin-top: 10px;\r\n}\r\n\r\n.host-action-selector select {\r\n    padding: 5px;\r\n    border-radius: 3px;\r\n    border: 1px solid var(--border-color);\r\n}\r\n\r\n.host-acting-banner {\r\n    position: fixed;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    background-color: var(--success-color);\r\n    color: white;\r\n    text-align: center;\r\n    padding: 10px;\r\n    z-index: 1000;\r\n    display: none;\r\n}\r\n\r\n.new-game-action {\r\n    margin-top: 20px;\r\n    text-align: center;\r\n}\r\n\r\n/* Answer section styles */\r\n#answer-section {\r\n    display: none;\r\n    width: 100%;\r\n}\r\n\r\n.player-button {\r\n    display: flex;\r\n    flex-grow: 1;\r\n\twidth: 100%;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 5px;\r\n    background-color: var(--success-color);\r\n    color: white;\r\n    border: none;\r\n    border-radius: 10px;\r\n    cursor: pointer;\r\n    transition: background-color 0.2s;\r\n    font-size: 16px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    margin: 0px;\r\n}\r\n.player-button:hover {\r\n\tbackground-color: var(--success-color-dark)\r\n}\r\n\r\n/* Option button styles */\r\n.option-button {\r\n    display: flex;\r\n    flex-grow: 1;\r\n    max-width: 24%;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 15px;\r\n    background-color: var(--success-color);\r\n    color: white;\r\n    border: none;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n    transition: background-color 0.2s;\r\n    font-size: 16px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    margin: 5px;\r\n}\r\n\r\n.option-button:hover {\r\n    background-color: var(--success-color-dark);\r\n}\r\n\r\n.option-button span {\r\n    display: inline-block;\r\n    width: 100%;\r\n}\r\n.form-options {\r\n    margin-top: var(--spacing-zero);\r\n    display: flex;\r\n    justify-content: center;\r\n\tvertical-align: baseline;\r\n    flex-basis: 100%;\r\n    gap: var(--spacing-lg);\r\n}\r\n\r\n/* Host acting info */\r\n.host-acting-info {\r\n    margin: 10px 0;\r\n    padding: 10px;\r\n    color: var(--primary-color);\r\n    border-radius: 5px;\r\n    border: solid;\r\n    border-color: var(--primary-color);\r\n    text-align: center;\r\n}\r\n\r\n.host-acting-info p {\r\n    margin: 0;\r\n    font-weight: bold;\r\n}\r\n\r\n.host-acting-info strong {\r\n    text-decoration: underline;\r\n}\r\n\r\n/* Admin controls page styles */\r\n.login-form {\r\n    max-width: 400px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n\tcolor: var(--info-color-dark);\r\n    background-color: var(--bg-color-light);\r\n    border-radius: var(--border-radius);\r\n    box-shadow: var(--box-shadow);\r\n}\r\n\r\n.admin-dashboard {\r\n    margin-top: 20px;\r\n}\r\n\r\n.inner-section {\r\n    margin-bottom: 5px;\r\n    padding: 20px;\r\n    background-color: var(--bg-color);\r\n    border-radius: var(--border-radius);\r\n    box-shadow: var(--box-shadow);\r\n}\r\n\r\n.form {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n    margin-top: 15px;\r\n}\r\n\r\n.logs-container {\r\n    margin-top: 15px;\r\n    max-height: 300px;\r\n    overflow-y: auto;\r\n\r\n}\r\n.logs-table {\r\n\twidth: 100%;\r\n}\r\n.logs-table th {\r\n    background-color: var(--bg-color-lighter); /* Override data-table header background */\r\n    color: var(--text-color-white); /* Override data-table header text color */\r\n}\r\n\r\n.error-message {\r\n    /* Using message class for consistent styling */\r\n    color: var(--error-color);\r\n    background-color: var(--error-color-light);\r\n    padding: 10px; /* Override default padding */\r\n}\r\n\r\n.warning-message {\r\n    /* Using message class for consistent styling */\r\n    color: #856404;\r\n    background-color: #fff3cd;\r\n    border: 1px solid #ffeeba;\r\n    padding: 10px; /* Override default padding */\r\n}\r\n\r\n.warning-message a {\r\n    color: #533f03;\r\n    text-decoration: underline;\r\n    font-weight: bold;\r\n}\r\n\r\n.info-text {\r\n    color: var(--text-color-light);\r\n    font-size: 0.9em;\r\n    font-style: italic;\r\n    display: block;\r\n    margin: 10px 0;\r\n    text-align: center;\r\n}\r\n\r\n.form-container {\r\n\tbackground-color: var(--bg-color-lighter);\r\n    padding: var(--spacing-lg);\r\n    border-radius: var(--border-radius-large);\r\n    box-shadow: var(--box-shadow);\r\n    margin: 0 auto;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n\tjustify-content: center;\r\n    gap: var(--spacing-md);\r\n}\r\n/* Progress indicator styles */\r\n.progress-container {\r\n    width: 75%;\r\n    margin: 20px 0;\r\n    padding: 15px;\r\n    background-color: var(--bg-color);\r\n    border: 1px solid;\r\n    border-radius: 5px;\r\n    text-align: center;\r\n}\r\n\r\n.progress-bar-container {\r\n    width: 100%;\r\n    height: 15px;\r\n    background-color: #e0e0e0;\r\n    border-radius: 10px;\r\n    margin: 15px 0;\r\n    overflow: hidden;\r\n}\r\n\r\n.progress-bar {\r\n    height: 100%;\r\n    width: 0;\r\n    background-color: #4CAF50;\r\n    border-radius: 10px;\r\n    transition: width 0.5s ease;\r\n}\r\n\r\n.progress-status {\r\n    font-size: 14px;\r\n    color: var(--secondary-color);\r\n    margin-top: 10px;\r\n}\r\n\r\n\r\n.progress-status.active {\r\n    animation: pulse 1.5s infinite;\r\n    font-weight: bold;\r\n    color: var(--secondary-color-dark);\r\n}\r\n\r\n/*from ai_question_history_details.html*/\r\n\r\n.batch-navigation {\r\n    margin: 20px 0;\r\n    background-color: #f5f5f5;\r\n    padding: 15px;\r\n    border-radius: 5px;\r\n}\r\n\r\n.navigation-controls {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n}\r\n\r\n.nav-button {\r\n    min-width: 150px;\r\n    text-align: center;\r\n}\r\n\r\n.nav-button.disabled {\r\n    opacity: 0.5;\r\n    cursor: not-allowed;\r\n}\r\n\r\n.batch-counter {\r\n    font-weight: bold;\r\n    font-size: 1.1em;\r\n}\r\n\r\n.metadata-section {\r\n    margin: 20px 0;\r\n    padding: 20px;\r\n    background-color: #f9f9f9;\r\n    border-radius: 5px;\r\n    border-left: 4px solid #3498db;\r\n}\r\n\r\n.metadata-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n    gap: 15px;\r\n}\r\n\r\n.metadata-item {\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.metadata-label {\r\n    font-weight: bold;\r\n    display: block;\r\n    margin-bottom: 5px;\r\n\tcolor: var(--text-color-white)\r\n}\r\n\r\n.metadata-value {\r\n    display: block;\r\n    padding: 5px 10px;\r\n    background-color: var(--text-color-white);\r\n\tcolor: var(--primary-color);\r\n    border-radius: 3px;\r\n    border: 1px solid #ddd;\r\n}\r\n\r\n.questions-section {\r\n    margin-top: 30px;\r\n}\r\n\r\n.question-card {\r\n    margin-bottom: 20px;\r\n    padding: 20px;\r\n    background-color: #fff;\r\n    border-radius: 5px;\r\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\r\n    border-left: 4px solid #2ecc71;\r\n}\r\n\r\n.question-card h3 {\r\n    margin-top: 0;\r\n    padding-bottom: 10px;\r\n    border-bottom: 1px solid #eee;\r\n    color: #333;\r\n}\r\n\r\n.question-content {\r\n    margin-top: 15px;\r\n}\r\n\r\n.question-content p {\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.question-content ul {\r\n    margin-left: 20px;\r\n}\r\n\r\n/* To fill a line regardless of the containing class */\r\n.fill {\r\n\tdisplay: inline-flex;\r\n\talign-items: flex-start;\r\n\twidth: 100%;\r\n\tGap: 15px;\r\n\tpadding: 0;\r\n\tmargin: 0;\r\n}\r\n.fill-stack {\r\n\tdisplay: inline;\r\n\talign-items: flex-start;\r\n\twidth: 100%;\r\n\tGap: 15px;\r\n\tpadding: 0;\r\n\tmargin: 0;\r\n}\r\n\r\n/* Modal styles for system dialog alerts */\r\n.modal {\r\n    display: none;\r\n    position: fixed;\r\n    z-index: 1000;\r\n    left: 0;\r\n    top: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    background-color: rgba(0, 0, 0, 0.5);\r\n    animation: fadeIn 0.3s ease-out;\r\n}\r\n\r\n.modal-content {\r\n    background-color: var(--bg-color-lighter);\r\n    margin: 15% auto;\r\n    padding: var(--spacing-lg);\r\n    border: 1px solid var(--border-color);\r\n    border-radius: var(--border-radius-large);\r\n    width: 80%;\r\n    max-width: 500px;\r\n    text-align: center;\r\n    color: var(--text-color-white);\r\n    box-shadow: var(--box-shadow);\r\n    animation: slideIn 0.3s ease-out;\r\n}\r\n\r\n.modal-content p {\r\n    margin: 0;\r\n    font-size: var(--font-size-normal);\r\n    line-height: 1.5;\r\n}\r\n\r\n.close-modal {\r\n    color: var(--text-color);\r\n    float: right;\r\n    font-size: 28px;\r\n    font-weight: bold;\r\n    cursor: pointer;\r\n    line-height: 1;\r\n}\r\n\r\n.close-modal:hover,\r\n.close-modal:focus {\r\n    color: var(--error-color);\r\n}\r\n\r\n.modal.fade-out {\r\n    animation: fadeOut 0.3s ease-in;\r\n}\r\n\r\n@keyframes fadeIn {\r\n    from { opacity: 0; }\r\n    to { opacity: 1; }\r\n}\r\n\r\n@keyframes fadeOut {\r\n    from { opacity: 1; }\r\n    to { opacity: 0; }\r\n}\r\n\r\n@keyframes slideIn {\r\n    from { \r\n        transform: translateY(-50px);\r\n        opacity: 0;\r\n    }\r\n    to { \r\n        transform: translateY(0);\r\n        opacity: 1;\r\n    }\r\n}\r\n
