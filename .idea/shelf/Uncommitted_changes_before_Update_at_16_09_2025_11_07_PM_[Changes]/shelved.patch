<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"gamebase.html\" %}\r\n\r\n{% block extra_head %}\r\n    <script src=\"{{ url_for('static', filename='js/livestatus.js') }}\"></script>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"result-section\">\r\n<div class=\"result-display\">\r\n      {% if is_correct %}\r\n          <div class=\"result correct zoomin\">\r\n                <div class=\"result-icon\">Correct ✓ صــــــح</div>\r\n                <p>Great job, {{ current_player }}!</p>\r\n            </div>\r\n        {% else %}\r\n            <div class=\"result incorrect zoomin\">\r\n                <div class=\"result-icon\">Wrong ✗ خـطـــــأ</div>\r\n                <p>Sorry, {{ current_player }}.</p>\r\n            </div>\r\n        {% endif %}\r\n<br>\r\n        <div class=\"section\">\r\n            <div class=\"blue-box\" dir=\"{% if question_text|is_arabic %}rtl{% else %}ltr{% endif %}\">{{ question_text }}</div>\r\n            <div class=\"answer-text\" dir=\"{% if correct_answer|is_arabic %}rtl{% else %}ltr{% endif %}\"><h2>{{ correct_answer }}</h2></div>\r\n            {% if current_question and current_question.explanation %}\r\n            <div class=\"info-text\" dir=\"{% if current_question.explanation|is_arabic %}rtl{% else %}ltr{% endif %}\">{{ current_question.explanation }}</div>\r\n            {% endif %}\r\n            {% if current_question %}\r\n            <div>\r\n                <button id=\"report-btn\" class=\"report-button\"><i class=\"fas fa-flag\"></i></button>\r\n            </div>\r\n            {% endif %}\r\n\r\n        </div><br>\r\n<div class=\"form-actions\"> <a href=\"{{ url_for('game_room', room_id=room_id) }}\" class=\"button\" id=\"return-to-game\">Return to Game Board</a> </div>\r\n        <br>\r\n        <h3>Current Scores | النتائج الحالية</h3>\r\n        <div class=\"leaderboard-display\">\r\n\t\t\t<table class=\"leaderboard-table\">\r\n\t\t\t\t<thead>\r\n\t\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t  <th>Player | اللاعب</th>\r\n\t\t\t\t\t\t  <th>Score | النتيجة</th>\r\n\t\t\t\t\t\t</tr>\r\n\t\t\t\t</thead>\r\n\t\t\t\t<tbody>              \r\n\t\t\t\t\t{% for player, player_score in leaderboard %}\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t<td>{{ player }}</td>\r\n\t\t\t\t\t<td>{{ player_score }}</td>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t\t{% endfor %}\r\n\t\t\t\t</tbody>\r\n\t\t\t</table>\r\n\t\t</div>\r\n    </div>\r\n</div>\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        const reportBtn = document.getElementById('report-btn');\r\n        const modal = document.getElementById('report-modal');\r\n        const closeBtn = document.querySelector('.close-modal');\r\n        const cancelBtn = document.querySelector('.cancel-report');\r\n\r\n        // Set flag when returning to game board\r\n        const returnToGameBtn = document.getElementById('return-to-game');\r\n        if (returnToGameBtn) {\r\n            returnToGameBtn.addEventListener('click', function() {\r\n                localStorage.setItem('returning_from_result', 'true');\r\n            });\r\n        }\r\n\r\n        // Show modal when report button is clicked\r\n        if (reportBtn) {\r\n            reportBtn.addEventListener('click', function() {\r\n                modal.style.display = 'block';\r\n            });\r\n        }\r\n\r\n        // Hide modal when close button is clicked\r\n        if (closeBtn) {\r\n            closeBtn.addEventListener('click', function() {\r\n                modal.style.display = 'none';\r\n            });\r\n        }\r\n\r\n        // Hide modal when cancel button is clicked\r\n        if (cancelBtn) {\r\n            cancelBtn.addEventListener('click', function() {\r\n                modal.style.display = 'none';\r\n            });\r\n        }\r\n\r\n        // Hide modal when clicking outside the modal content\r\n        window.addEventListener('click', function(event) {\r\n            if (event.target === modal) {\r\n                modal.style.display = 'none';\r\n            }\r\n        });\r\n    });\r\n</script>\r\n\r\n<!-- Floating message box for report confirmation -->\r\n<div id=\"report-modal\" class=\"modal\">\r\n    <div class=\"modal-content\">\r\n        <span class=\"close-modal\">&times;</span>\r\n\t\t<p>Would you like to report this question for review?</p><p dir=\"rtl\">هل تريد الإبلاغ عن هذا السؤال للمراجعة؟</p>\r\n        <form action=\"{{ url_for('report_question') }}\" method=\"post\" class=\"form-actions\">\r\n            <input type=\"hidden\" name=\"question_id\" value=\"{{ current_question.id if current_question else '' }}\">\r\n            <input type=\"hidden\" name=\"room_id\" value=\"{{ room_id }}\">\r\n            <input type=\"hidden\" name=\"is_correct\" value=\"{{ is_correct }}\">\r\n            <button type=\"submit\" class=\"button confirm-report\">Yes | نعـم</button>\r\n            <button type=\"button\" class=\"button cancel-report\">No | إلغاء</button>\r\n        </form>\r\n    </div>\r\n</div>\r\n{% endblock %}\r\n
