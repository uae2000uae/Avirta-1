<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}Question Bank - Avirta{% endblock %}\r\n\r\n{% block content %}\r\n<style>\r\n    .admin-actions {\r\n        margin-bottom: 20px;\r\n        display: flex;\r\n        justify-content: flex-end;\r\n    }\r\n\r\n    .primary-button {\r\n        background-color: var(--primary-color, #4a6fa5);\r\n        color: white;\r\n        font-weight: bold;\r\n        padding: 8px 16px;\r\n        border-radius: var(--border-radius, 4px);\r\n        border: none;\r\n        cursor: pointer;\r\n        transition: background-color 0.3s;\r\n    }\r\n\r\n    .primary-button:hover {\r\n        background-color: var(--primary-color-dark, #3a5985);\r\n    }\r\n\r\n    .primary-button:disabled {\r\n        background-color: #cccccc;\r\n        cursor: not-allowed;\r\n    }\r\n\r\n    /* Dropdown styles */\r\n    .dropdown {\r\n        position: relative;\r\n        display: inline-block;\r\n    }\r\n\r\n    .dropdown-toggle {\r\n        cursor: pointer;\r\n    }\r\n\r\n    .dropdown-menu {\r\n        display: none;\r\n        position: absolute;\r\n        background-color: var(--background-color, #ffffff);\r\n        min-width: 120px;\r\n        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);\r\n        z-index: 1;\r\n        border-radius: var(--border-radius, 4px);\r\n        overflow: hidden;\r\n    }\r\n\r\n    .dropdown-menu a {\r\n        color: var(--text-color, #333333);\r\n        padding: 8px 12px;\r\n        text-decoration: none;\r\n        display: block;\r\n        text-align: left;\r\n    }\r\n\r\n    .dropdown-menu a:hover {\r\n        background-color: var(--hover-color, #f1f1f1);\r\n    }\r\n\r\n    .dropdown:hover .dropdown-menu {\r\n        display: block;\r\n    }\r\n\r\n</style>\r\n\r\n<div class=\"back-navigation\">\r\n    <a href=\"{{ url_for('admin_controls') }}\" class=\"button\"><i class=\"fas fa-arrow-left\"></i> Back to Admin Controls</a>\r\n</div>\r\n<h2>Question Bank</h2>\r\n\r\n\r\n{% if stats %}\r\n<h3>Database Statistics</h3>\r\n<div class=\"stats-container\">\r\n    <div class=\"stats-overview\">\r\n        <div class=\"stat-card\">\r\n            <h3>Total Questions</h3>\r\n            <p class=\"stat-value\">{{ stats.total_questions }}</p>\r\n        </div>\r\n        <div class=\"stat-card\">\r\n            <h3>Active Questions</h3>\r\n            <p class=\"stat-value\">{{ stats.active_questions }}</p>\r\n        </div>\r\n        <div class=\"stat-card\">\r\n            <h3>Categories</h3>\r\n            <p class=\"stat-value\">{{ stats.total_categories }}</p>\r\n        </div>\r\n        <div class=\"stat-card\">\r\n            <h3>Total Uses</h3>\r\n            <p class=\"stat-value\">{{ stats.total_uses }}</p>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"stats-details\">\r\n        <div class=\"stat-section\">\r\n            <h3>Points Distribution</h3>\r\n            <table class=\"stats-table\">\r\n                <tr>\r\n                    <th>Points</th>\r\n                    <th>Count</th>\r\n                </tr>\r\n                {% for points, count in stats.points_distribution.items() %}\r\n                <tr>\r\n                    <td>{{ points }}</td>\r\n                    <td>{{ count }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n            </table>\r\n        </div>\r\n\r\n        <div class=\"stat-section\">\r\n            <h3>Question Types</h3>\r\n            <table class=\"stats-table\">\r\n                <tr>\r\n                    <th>Type</th>\r\n                    <th>Count</th>\r\n                </tr>\r\n                {% for type, count in stats.question_types.items() %}\r\n                <tr>\r\n                    <td>{{ type }}</td>\r\n                    <td>{{ count }}</td>\r\n                </tr>\r\n                {% endfor %}\r\n            </table>\r\n        </div>\r\n    </div>\r\n</div>\r\n{% endif %}\r\n\r\n<h3>Categories</h3>\r\n<div class=\"categories-list\">\r\n    {% if categories %}\r\n        <div class=\"category-grid\">\r\n            {% for category_id, category in categories.items() %}\r\n                <div class=\"category-card\">\r\n                    <div class=\"category-header\">\r\n                      <h3>{{ category.name }}</h3>\r\n                        {% if session.get('admin_authenticated') %}\r\n                        <div class=\"category-actions-icons\">\r\n                            <a href=\"{{ url_for('edit_category', category_id=category_id) }}\" class=\"edit-icon\" title=\"Edit Category\">\r\n                                <i class=\"fas fa-edit\"></i>\r\n                            </a>\r\n                            <a href=\"#\" class=\"delete-icon\" title=\"Delete Category\" data-id=\"{{ category_id }}\" onclick=\"confirmDelete(this); return false;\">\r\n                                <i class=\"fas fa-trash-alt\"></i>\r\n                            </a>\r\n\t\t\t\t\t\t\t</div>\r\n                        {% endif %}\r\n                    </div>\r\n                    <p>ID: {{ category_id }}</p>\r\n                    <p class=\"question-count\">Questions: {{ category.question_count }}</p>\r\n                    <p class=\"question-count\">Usage: {{ category.usage_percentage }}%</p>\r\n                    <div class=\"category-actions\">\r\n                        {% if session.get('admin_authenticated') %}\r\n                        <a href=\"{{ url_for('view_questions', category_id=category_id) }}\" class=\"button\">Questions</a>\r\n                        <div class=\"dropdown\">\r\n                            <button class=\"button dropdown-toggle\">Export</button>\r\n                            <div class=\"dropdown-menu\">\r\n                                <a href=\"{{ url_for('export_questions', category_id=category_id, format='csv') }}\">CSV</a>\r\n                                <a href=\"{{ url_for('export_questions', category_id=category_id, format='xlsx') }}\">Excel</a>\r\n                                <a href=\"{{ url_for('export_questions', category_id=category_id, format='json') }}\">JSON</a>\r\n                            </div>\r\n                        </div>\r\n                        {% else %}{% endif %}\r\n                    </div>\r\n                </div>\r\n            {% endfor %}\r\n        </div>\r\n    {% else %}\r\n        <p>No questions found. Please add or import new questions</p>\r\n    {% endif %}\r\n</div>\r\n\r\n{% if session.get('download_file') %}\r\n<script>\r\n    // Automatically trigger download if there's a file in the session\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        // Create a hidden iframe to trigger the download\r\n        var iframe = document.createElement('iframe');\r\n        iframe.style.display = 'none';\r\n        iframe.src = \"{{ url_for('download_exported_file') }}\";\r\n        document.body.appendChild(iframe);\r\n    });\r\n</script>\r\n{% endif %}\r\n<script>\r\n/**\r\n * Setup scroll position saving functionality\r\n * Saves the scroll position when navigating away from a page\r\n * Restores the scroll position when returning to a page\r\n */\r\nfunction setupScrollPositionSaving() {\r\n    // Get the current page path to use as a unique key\r\n    const pagePath = window.location.pathname;\r\n    const scrollKey = 'avirta_scroll_' + pagePath;\r\n\r\n    // Restore scroll position if it exists in localStorage\r\n    const savedScrollPosition = localStorage.getItem(scrollKey);\r\n    if (savedScrollPosition) {\r\n        // Restore immediately without delay\r\n        window.scrollTo(0, parseInt(savedScrollPosition));\r\n    }\r\n\r\n    // Save scroll position when user navigates away or refreshes\r\n    window.addEventListener('beforeunload', function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    });\r\n\r\n    // Add event listeners to all form submit buttons to save position before submission\r\n    document.querySelectorAll('form').forEach(form => {\r\n        form.addEventListener('submit', function() {\r\n            localStorage.setItem(scrollKey, window.scrollY);\r\n        });\r\n    });\r\n\r\n    // Save scroll position more frequently (every 1 second)\r\n    setInterval(function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    }, 1000);\r\n}\r\n\r\n</script>\r\n<script>\r\n    function confirmDelete(element) {\r\n        const categoryId = element.getAttribute('data-id');\r\n        if (confirm('Are you sure you want to delete ALL questions in this category? This action cannot be undone.')) {\r\n            window.location.href = \"{{ url_for('delete_category_questions', category_id='PLACEHOLDER') }}\".replace('PLACEHOLDER', categoryId);\r\n        }\r\n    }\r\n\r\n</script>\r\n\r\n{% endblock %}\r\n
