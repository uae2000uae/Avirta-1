<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}{% if editing %}Edit Question{% else %}Add Question{% endif %} - Avirta{% endblock %}\r\n\r\n{% block content %}\r\n<h1>{% if editing %}Edit Question{% else %}Add New Question{% endif %}</h1>\r\n\r\n<div class=\"actions\">\r\n    <a href=\"{{ url_for('admin_controls') }}\" class=\"button\">Back to Admin Controls</a>\r\n</div>\r\n\r\n<form action=\"{{ url_for('add_question_page', question_id=question.id if editing else None) }}\" method=\"POST\" class=\"form-group-xx\">\r\n    {% if editing %}\r\n    <input type=\"hidden\" name=\"question_id\" value=\"{{ question.id }}\">\r\n    <div class=\"form-group-equal-sm\">\r\n        <label for=\"display_question_id\">Question ID:</label>\r\n        <input type=\"text\" id=\"display_question_id\" value=\"{{ question.id }}\" readonly>\r\n    </div>\r\n    {% endif %}\r\n    \r\n\r\n    <div class=\"form-group-equal-sm\">\r\n      <label for=\"type\">Question Type:</label>\r\n        <select id=\"type\" name=\"type\" required onchange=\"toggleQuestionType()\">\r\n            <option value=\"\">Select a type</option>\r\n            <option value=\"multiple_choice\" {% if editing and question.type == 'multiple_choice' %}selected{% endif %}>Multiple Choice</option>\r\n            <option value=\"true_false\" {% if editing and question.type == 'true_false' %}selected{% endif %}>True/False</option>\r\n            <option value=\"text\" {% if editing and question.type == 'text' %}selected{% endif %}>Text</option>\r\n        </select>\r\n    </div>\r\n\r\n    <div class=\"form-group-equal-sm\">\r\n        <label for=\"category_id\">Category:</label>\r\n        <select id=\"category_id\" name=\"category_id\" required>\r\n            <option value=\"\">Select a category</option>\r\n            {% for category_id, category in categories.items() %}\r\n                <option value=\"{{ category_id }}\" {% if editing and question.category_id == category_id %}selected{% endif %}>{{ category.name }}</option>\r\n            {% endfor %}\r\n        </select>\r\n    </div>\r\n\r\n    <div class=\"form-group-equal-sm\">\r\n        <label for=\"points\">Points:</label>\r\n        <select id=\"points\" name=\"points\" required>\r\n            <option value=\"\">Select points</option>\r\n            <option value=\"100\" {% if editing and question.points == 100 %}selected{% endif %}>100 points</option>\r\n            <option value=\"200\" {% if editing and question.points == 200 %}selected{% endif %}>200 points</option>\r\n            <option value=\"300\" {% if editing and question.points == 300 %}selected{% endif %}>300 points</option>\r\n            <option value=\"400\" {% if editing and question.points == 400 %}selected{% endif %}>400 points</option>\r\n            <option value=\"500\" {% if editing and question.points == 500 %}selected{% endif %}>500 points</option>\r\n        </select>\r\n    </div>\r\n    <div class=\"form-group-inline\">\r\n      <label for=\"question\">Question Text:</label>\r\n      <textarea id=\"question\" name=\"question\" rows=\"1\" required>{% if editing %}{{ question.question }}{% endif %}</textarea>\r\n    </div>\r\n    <div id=\"multiple_choice_options\" style=\"display: none;\" class=\"form-group-grid\">\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"option_1\">Option 1:</label>\r\n            <input type=\"text\" id=\"option_1\" name=\"option_1\" {% if editing and question.type == 'multiple_choice' and question.options|length > 0 %}value=\"{{ question.options[0] }}\"{% endif %}>\r\n        </div>\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"option_2\">Option 2:</label>\r\n            <input type=\"text\" id=\"option_2\" name=\"option_2\" {% if editing and question.type == 'multiple_choice' and question.options|length > 1 %}value=\"{{ question.options[1] }}\"{% endif %}>\r\n        </div>\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"option_3\">Option 3:</label>\r\n            <input type=\"text\" id=\"option_3\" name=\"option_3\" {% if editing and question.type == 'multiple_choice' and question.options|length > 2 %}value=\"{{ question.options[2] }}\"{% endif %}>\r\n        </div>\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"option_4\">Option 4:</label>\r\n            <input type=\"text\" id=\"option_4\" name=\"option_4\" {% if editing and question.type == 'multiple_choice' and question.options|length > 3 %}value=\"{{ question.options[3] }}\"{% endif %}>\r\n        </div>\r\n\t\t<br>\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"correct_answer\">Correct Answer:</label>\r\n            <select id=\"correct_answer\" name=\"correct_answer\">\r\n                <option value=\"\">Select correct answer</option>\r\n                {% if editing and question.type == 'multiple_choice' %}\r\n                    {% for option in question.options %}\r\n                        <option value=\"{{ option }}\" {% if question.correct_answer == option %}selected{% endif %}>{{ option }}</option>\r\n                    {% endfor %}\r\n                {% else %}\r\n                    <option value=\"\" class=\"option-placeholder\" disabled>Add options above first</option>\r\n                {% endif %}\r\n            </select>\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"true_false_options\" style=\"display: none;\" class=\"form-group-grid\">\r\n        <div class=\"form-group-equal-sm\">\r\n            <label for=\"correct_answer_tf\">Correct Answer:</label>\r\n            <select id=\"correct_answer_tf\" name=\"correct_answer_tf\">\r\n                <option value=\"\">Select correct answer</option>\r\n                <option value=\"True\" {% if editing and question.type == 'true_false' and question.correct_answer == 'True' %}selected{% endif %}>True</option>\r\n                <option value=\"False\" {% if editing and question.type == 'true_false' and question.correct_answer == 'False' %}selected{% endif %}>False</option>\r\n            </select>\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"text_options\" style=\"display: none;\" class=\"form-group-grid\">\r\n        <div class=\"form-group\">\r\n            <label for=\"correct_answer\">Correct Answer:</label>\r\n            <input type=\"text\" id=\"correct_answer_text\" name=\"correct_answer_text\" {% if editing and question.type == 'text' %}value=\"{{ question.correct_answer }}\"{% endif %}>\r\n        </div>\r\n    </div>\r\n    <div class=\"form-group-inline\">\r\n      <label for=\"explanation\">Explanation:</label>\r\n      <textarea id=\"explanation\" name=\"explanation\" rows=\"1\">{% if editing %}{{ question.explanation }}{% endif %}</textarea>\r\n    </div>\r\n\t\t<div class=\"form-group form-actions\">\r\n        <button type=\"submit\" name=\"action\" value=\"save_close\" class=\"button\">Save and Close</button>\r\n        <button type=\"submit\" name=\"action\" value=\"save_next\" class=\"button\">{% if editing %}Save and Open Next{% else %}Save and Add Another{% endif %}</button>\r\n            <button class=\"button secondary\"><a class=\"text-clear\" href=\"{{ url_for('admin_controls')}}\">Cancel</a></button>\r\n\t\t\t{% if editing %}\r\n\t\t\t<button class=\"delete-button\"><a class=\"text-clear\" href=\"#\" title=\"Delete Question\" data-id=\"{{ question.id }}\" onclick=\"confirmDelete(this); return false;\">Delete</a></button>\r\n\t\t\t{% endif %}\r\n    </div>\r\n</form>\r\n<script>\r\n    function toggleQuestionType() {\r\n        const questionType = document.getElementById('type').value;\r\n        const multipleChoiceOptions = document.getElementById('multiple_choice_options');\r\n        const trueFalseOptions = document.getElementById('true_false_options');\r\n        const textOptions = document.getElementById('text_options');\r\n\r\n        if (questionType === 'multiple_choice') {\r\n            multipleChoiceOptions.style.display = 'block';\r\n            trueFalseOptions.style.display = 'none';\r\n            textOptions.style.display = 'none';\r\n        } else if (questionType === 'true_false') {\r\n            multipleChoiceOptions.style.display = 'none';\r\n            trueFalseOptions.style.display = 'block';\r\n            textOptions.style.display = 'none';\r\n        } else if (questionType === 'text') {\r\n            multipleChoiceOptions.style.display = 'none';\r\n            trueFalseOptions.style.display = 'none';\r\n            textOptions.style.display = 'block';\r\n        } else {\r\n            multipleChoiceOptions.style.display = 'none';\r\n            trueFalseOptions.style.display = 'none';\r\n            textOptions.style.display = 'none';\r\n        }\r\n    }\r\n\r\n    // Update correct answer dropdown when options change\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n        // Initialize question type display\r\n        toggleQuestionType();\r\n        \r\n        // Initialize options for multiple choice\r\n        if (document.getElementById('type').value === 'multiple_choice') {\r\n            updateCorrectAnswerOptions();\r\n        }\r\n\r\n        const optionInputs = [\r\n            document.getElementById('option_1'),\r\n            document.getElementById('option_2'),\r\n            document.getElementById('option_3'),\r\n            document.getElementById('option_4')\r\n        ];\r\n\r\n        const correctAnswerSelect = document.getElementById('correct_answer');\r\n\r\n        optionInputs.forEach(input => {\r\n            input.addEventListener('input', updateCorrectAnswerOptions);\r\n        });\r\n\r\n        function updateCorrectAnswerOptions() {\r\n            // Clear existing options\r\n            correctAnswerSelect.innerHTML = '<option value=\"\">Select correct answer</option>';\r\n\r\n            // Add new options based on input values\r\n            optionInputs.forEach((input, index) => {\r\n                if (input.value.trim() !== '') {\r\n                    const option = document.createElement('option');\r\n                    option.value = input.value;\r\n                    option.textContent = input.value;\r\n                    correctAnswerSelect.appendChild(option);\r\n                }\r\n            });\r\n\r\n            // Show placeholder if no options are available\r\n            if (correctAnswerSelect.options.length <= 1) {\r\n                const placeholder = document.createElement('option');\r\n                placeholder.value = '';\r\n                placeholder.textContent = 'Add options above first';\r\n                placeholder.disabled = true;\r\n                placeholder.className = 'option-placeholder';\r\n                correctAnswerSelect.appendChild(placeholder);\r\n            }\r\n        }\r\n    });\r\n    function confirmDelete(element) {\r\n        const questionId = element.getAttribute('data-id');\r\n        if (confirm('Are you sure you want to delete this question? This action cannot be undone.')) {\r\n            window.location.href = \"{{ url_for('delete_question', question_id='PLACEHOLDER') }}\".replace('PLACEHOLDER', questionId);\r\n        }\r\n    }\r\n</script>\r\n{% endblock %}\r\n
