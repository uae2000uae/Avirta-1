+import re
+from flask import abort, Response
+
+
+def _minify_css(css_text: str) -> str:
+    """Very small CSS minifier: strips comments and extra whitespace/newlines."""
+    css_text = re.sub(r"/\*.*?\*/", "", css_text, flags=re.S)
+    css_text = re.sub(r"\s+", " ", css_text)
+    css_text = re.sub(r"\s*([{}:;,])\s*", r"\1", css_text)
+    css_text = css_text.replace(";}", "}")
+    return css_text.strip()
+
+
+def _minify_js(js_text: str) -> str:
+    """Very small JS minifier: strips line/block comments and collapses whitespace.
+    This is simplistic but adequate for our small scripts. Avoids touching content inside strings.
+    """
+    # Remove /* ... */
+    js_text = re.sub(r"/\*.*?\*/", "", js_text, flags=re.S)
+    # Remove // ... endline
+    js_text = re.sub(r"(^|[^:])//.*$", r"\1", js_text, flags=re.M)
+    # Collapse whitespace
+    js_text = re.sub(r"\s+", " ", js_text)
+    return js_text.strip()
+
+
+@app.route('/static-min/<path:filename>')
+def minified_static(filename: str):
+    """Serve minified CSS/JS on-the-fly with cache headers. Falls back to normal static for other types."""
+    file_path = os.path.join(app.static_folder, filename)
+    if not os.path.isfile(file_path):
+        abort(404)
+
+    mimetype = None
+    minified = None
+
+    try:
+        if filename.endswith('.css'):
+            mimetype = 'text/css; charset=utf-8'
+            with open(file_path, 'r', encoding='utf-8') as f:
+                minified = _minify_css(f.read())
+        elif filename.endswith('.js'):
+            mimetype = 'application/javascript; charset=utf-8'
+            with open(file_path, 'r', encoding='utf-8') as f:
+                minified = _minify_js(f.read())
+        else:
+            # For non-CSS/JS, just serve normally
+            return send_file(file_path)
+
+        resp = Response(minified)
+        resp.mimetype = mimetype
+        # Cache aggressively for 7 days
+        resp.headers['Cache-Control'] = 'public, max-age=604800, immutable'
+        return resp
+    except Exception:
+        # Fallback: serve original if minification fails
+        return send_file(file_path)
+
