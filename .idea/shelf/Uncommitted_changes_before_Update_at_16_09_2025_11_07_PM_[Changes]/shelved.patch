ة أساسية، مثل إزالة السموم، تصنيع البروتينات، وإنتاج المواد الكيميائية التي تساعد على الهضم\",\r\n    \"points\": 400,\r\n    \"id\": \"Q0000770\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    \"created_at\": \"2025-05-27T02:44:24.485488\",\r\n    \"updated_at\": \"2025-05-31T11:33:23.923947\",\r\n    \"active\": true,\r\n    \"use_count\": 1\r\n  },\r\n  {\r\n    \"type\": \"text\",\r\n    \"question\": \"ما اسم العملية التي يتم فيها تحويل الطاقة الكيميائية إلى طاقة حرارية في جسم الإنسان؟\",\r\n    \"correct_answer\": \"الأيض (التمثيل الغذائي) أو التنفس الخلوي\",\r\n    \"explanation\": \"التنفس الخلوي جزء من الأيض، حيث يركز على إنتاج الطاقة، بينما الأيض يشمل جميع العمليات الحيوية التي تحافظ على وظائف الجسم\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0000771\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    \"created_at\": \"2025-05-27T02:44:24.489488\",\r\n    \"updated_at\": \"2025-06-01T10:59:24.044001\",\r\n    \"active\": true,\r\n    \"use_count\": 3\r\n  },\r\n  {\r\n    \"type\": \"multiple_choice\",\r\n    \"question\": \"أي من التالي هو أصغر جزيء يمكن أن يوجد بشكل مستقل؟\",\r\n    \"options\": [\r\n      \"النواة\",\r\n      \"الفوتون\",\r\n      \"الأيون\",\r\n      \"البروتون\"\r\n    ],\r\n    \"correct_answer\": \"الفوتون\",\r\n    \"explanation\": \"وهو الوحدة الأساسية للضوء والطاقة الكهرومغناطيسية. الفوتونات ليس لها كتلة، لكنها تحمل الطاقة وتتحرك بسرعة الضوء في الفراغ\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0000772\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    \"created_at\": \"2025-05-27T02:44:24.494491\",\r\n    \"updated_at\": \"2025-06-07T12:37:48.541853\",\r\n    \"active\": true,\r\n    \"use_count\": 3\r\n  },\r\n  {\r\n    \"type\": \"true_false\",\r\n    \"question\": \"يوجد الحمض النووي (DNA) فقط داخل نواة الخلية.\",\r\n    \"correct_answer\": \"False\",\r\n    \"explanation\": \"الحمض النووي يوجد أيضًا في الميتوكوندريا وبعض العضيات الأخرى.\",\r\n    \"points\": 400,\r\n    \"id\": \"Q0000773\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    \"created_at\": \"2025-05-27T02:44:24.498495\",\r\n    \"updated_at\": \"2025-05-31T15:06:30.889202\",\r\n    \"active\": true,\r\n    \"use_count\": 1\r\n  },\r\n  {\r\n    \"type\": \"multiple_choice\",\r\n    \"question\": \"أي من الحيوانات هذه يستطيع العيش في المياه العذبة والمالحة؟\",\r\n    \"options\": [\r\n      \"السلحفاة البحرية\",\r\n      \"الدولفين\",\r\n      \"سمكة السلمون\",\r\n      \"الحوت الأبيض\"\r\n    ],\r\n    \"correct_answer\": \"سمكة السلمون\",\r\n    \"explanation\": \"سمك السلمون يقضي جزءًا من حياته في المياه العذبة قبل أن ينتقل إلى المياه المالحة\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0000774\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    \"created_at\": \"2025-05-27T02:44:24.502500\",\r\n    \"updated_at\": \"2025-06-27T04:47:14.669350\",\r\n    \"active\": true,\r\n    \"use_count\": 3\r\n  },\r\n  {\r\n    \"type\": \"multiple_choice\",\r\n    \"question\": \"أي من التالي هو اسم وحدة قياس الطاقة في النظام الدولي؟\",\r\n    \"options\": [\r\n      \"جول\",\r\n      \"واط\",\r\n      \"أمبير\",\r\n      \"فولت\"\r\n    ],\r\n    \"correct_answer\": \"جول\",\r\n    \"explanation\": \"يُعرَّف بأنه مقدار الطاقة المبذولة عندما تؤثر قوة مقدارها 1 نيوتن على جسم وتحركه لمسافة 1 متر\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0000775\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    \"created_at\": \"2025-05-27T02:44:24.506497\",\r\n    \"updated_at\": \"2025-05-31T04:07:45.327108\",\r\n    \"active\": true,\r\n    \"use_count\": 2\r\n  },\r\n  {\r\n    \"type\": \"text\",\r\n    \"question\": \"ما اسم العملية التي يتم فيها تحويل غاز الأكسجين إلى ثاني أكسيد الكربون في خلايا الجسم؟\",\r\n    \"correct_answer\": \"التنفس الخلوي الهوائي\",\r\n    \"explanation\": \"خلال هذه العملية، يتم استخدام الأكسجين لتكسير الجلوكوز وإنتاج ATP، وهو مصدر الطاقة الأساسي للخلايا، وينتج عن ذلك ثاني أكسيد الكربون كمُخلف يتم التخلص منه عبر الرئتين\",\r\n    \"points\": 500,\r\n    \"id\": \"Q0000776\",\r\n    \"category_id\": \"علوم_عامة\",\r\n    