<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"gamebase.html\" %}\r\n\r\n{% block extra_head %}\r\n    <script src=\"{{ url_for('static', filename='js/livestatus.js') }}\"></script>\r\n    <script src=\"{{ url_for('static', filename='js/gametools.js') }}\"></script>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"page-section\" data-room-id=\"{{ room.room_id }}\" data-player-name=\"{{ player_name }}\" data-is-host=\"{{ is_host|default('false')|lower }}\" data-board-completed=\"{{ room.is_board_completed()|lower }}\">\r\n    <h1 class=\"text-center text-nomargin\">{{ room.name }}</h1>\r\n\t<p class=\"text-center\"><strong>Host: </strong>{{ room.host }} | <strong>Room ID: </strong><span>{{ room.room_id }}</span></p>\r\n  <div class=\"section\">\r\n    <div><p class=\"blue-box\"><strong>Current Turn: </strong><span></span>\r\n\t\t  {% for player in room.players %}\r\n\t\t\t{% if player == current_player %}\r\n\t\t\t  <span class=\"button\">{{ player }}</span>\r\n\t\t\t{% else %}\r\n\t\t\t  <text class=\"button secondary\">{{ player }}</text>\r\n\t\t\t{% endif %}\r\n\t\t\t{% if not loop.last %}{% endif %}\r\n\t\t  {% endfor %}\r\n\t\t</p>\r\n    </div>\r\n\r\n\t\t<form action=\"{{ url_for('use_tool') }}\" method=\"post\" class=\"form-actions clear\">\r\n\t\t  <input type=\"hidden\" name=\"tool_name\" value=\"double_points\" class=\"form-actions\">\r\n\t\t  <div>\r\n\t\t\t<button type=\"submit\" id=\"double-points-btn\" class=\"dp tool-btn\" {% if not player_tools.double_points %}disabled=\"disabled\" style=\"opacity: 0.3; cursor: not-allowed;\" title=\"This tool has already been used\"{% endif %}>\r\n\t\t\t  Double Points | ضعف النقاط\r\n\t\t\t</button>\r\n\t\t  </div>\r\n\t\t</form>\r\n\r\n  </div>\r\n\r\n  <div class=\"game-board-section\">\r\n    {% if available_questions %}\r\n      <div class=\"game-board\">\r\n        {% for category_id, points_dict in available_questions.items() %}\r\n          {% if points_dict %}\r\n            <div class=\"category\" data-category=\"{{ category_id }}\">\r\n              <div class=\"category-header-grid\">\r\n                {{ category_id|replace('_', ' ')|title }}\r\n              </div>\r\n              <div class=\"question-list\">\r\n                {% for points, question_info in points_dict.items() %}\r\n                  <div class=\"question-item\" data-points=\"{{ points }}\">\r\n                    <form action=\"{{ url_for('select_question') }}\" method=\"post\" class=\"question-box\">\r\n                      <input type=\"hidden\" name=\"category_id\" value=\"{{ category_id }}\">\r\n                      <input type=\"hidden\" name=\"points\" value=\"{{ points }}\">\r\n                      <input type=\"hidden\" name=\"acting_player\" class=\"acting-player-input\" value=\"\">\r\n                      <button type=\"submit\" class=\"question-button {% if question_info.doubled %}doubled{% endif %}\" \r\n\t\t\t\t\t\t\t{% if question_info.answered %}\r\n\t\t\t\t\t\t\tdisabled=\"disabled\" \r\n                          style=\"opacity: 0.5; cursor: not-allowed;\"\r\n                          {% if not question_info.answered %}\r\n                            title=\"It's {{ current_player }}'s turn\"\r\n                          {% endif %}\r\n                        {% endif %}\r\n                        {% if question_info.doubled %}\r\n                          title=\"Double Points Active!\"\r\n                        {% endif %}>\r\n                        <strong>{{ question_info.points }}{% if question_info.doubled %}!{% endif %}</strong>\r\n                      </button>\r\n                    </form>\r\n                  </div>\r\n                {% endfor %}\r\n              </div>\r\n            </div>\r\n          {% endif %}\r\n        {% endfor %}\r\n      </div>\r\n    {% else %}\r\n      <div>\r\n        <form action=\"{{ url_for('reset_game') }}\" method=\"post\" class=\"form-actions clear\">\r\n          <input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\"><p>No questions available | لا توجد أسئلة في النظام</p>\r\n        </form>\r\n      </div>\r\n    {% endif %}\r\n  </div>\r\n\r\n  <div class=\"form-actions\"> \r\n    <a href=\"{{ url_for('leaderboard', room_id=room.room_id) }}\" class=\"button\">Leaderboard | عــرض النتائــج</a>\r\n    <a href=\"{{ url_for('end_game', room_id=room.room_id) }}\" class=\"button red-button\">End Game | إنهاء اللعبة</a>\r\n  </div>\r\n\r\n  {% if room.is_board_completed() %}\r\n    <div>\r\n      <form action=\"{{ url_for('reset_game') }}\" method=\"post\" class=\"form-actions clear\">\r\n        <input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\"><p>Game Ended | انتهت اللعبة</p>\r\n\t\t</form>\r\n    </div>\r\n  {% endif %}\r\n<br>\r\n  <!-- Live Game Status Section -->\r\n  <div class=\"section\">\r\n    <p><em>Game Status...</em></p>\r\n    <div class=\"status-container\">\r\n      <div id=\"status-updates\" class=\"status-updates\">\r\n        <p class=\"status-message\">Waiting for game updates...</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div> <!-- End of game-room-section -->\r\n{% endblock %}\r\n\r\n{% block scripts %}\r\n<script>\r\n  // JavaScript to handle host actions\r\n  document.addEventListener('DOMContentLoaded', function() {\r\n    const actingPlayerInputs = document.querySelectorAll('.acting-player-input');\r\n    const currentPlayer = \"{{ current_player }}\";\r\n\r\n    // Set all acting_player inputs to the current player\r\n    actingPlayerInputs.forEach(input => {\r\n      input.value = currentPlayer;\r\n    });\r\n\r\n    // Visual feedback for the host - banner removed as per requirements\r\n    document.body.classList.add('host-acting');\r\n\r\n    // Setup scroll position saving\r\n    setupScrollPositionSaving();\r\n\r\n    // Check if returning from result page and if the board is completed\r\n    if (localStorage.getItem('returning_from_result') === 'true') {\r\n      // Clear the flag\r\n      localStorage.removeItem('returning_from_result');\r\n\r\n      // Get the board completion status\r\n      const isBoardCompleted = document.querySelector('.page-section').getAttribute('data-board-completed') === 'true';\r\n\r\n      // Only show the game over modal if the board is completed\r\n      if (isBoardCompleted) {\r\n        // Add a 1-second delay before showing the modal\r\n        setTimeout(() => {\r\n          showGameOverModal();\r\n        }, 1000);\r\n      }\r\n    }\r\n  });\r\n\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    function checkForUpdate() {\r\n        fetch('/notify_game_room')\r\n            .then(response => response.json())\r\n            .then(data => {\r\n                if (data.refresh) {\r\n                    window.location.reload();  // Refresh game_room.html when signal is received\r\n                }\r\n            })\r\n            .catch(error => console.error('Error checking for updates:', error));\r\n    }\r\n\r\n    setInterval(checkForUpdate, 1000);  // Check every 1 seconds\r\n});\r\n\r\n/**\r\n * Setup scroll position saving functionality\r\n * Saves the scroll position when navigating away from a page\r\n * Restores the scroll position when returning to a page\r\n */\r\nfunction setupScrollPositionSaving() {\r\n    // Get the current page path to use as a unique key\r\n    const pagePath = window.location.pathname;\r\n    const scrollKey = 'avirta_scroll_' + pagePath;\r\n\r\n    // Restore scroll position if it exists in localStorage\r\n    const savedScrollPosition = localStorage.getItem(scrollKey);\r\n    if (savedScrollPosition) {\r\n        // Restore immediately without delay\r\n        window.scrollTo(0, parseInt(savedScrollPosition));\r\n    }\r\n\r\n    // Save scroll position when user navigates away or refreshes\r\n    window.addEventListener('beforeunload', function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    });\r\n\r\n    // Add event listeners to all form submit buttons to save position before submission\r\n    document.querySelectorAll('form').forEach(form => {\r\n        form.addEventListener('submit', function() {\r\n            localStorage.setItem(scrollKey, window.scrollY);\r\n        });\r\n    });\r\n\r\n    // Save scroll position more frequently (every 1 second)\r\n    setInterval(function() {\r\n        localStorage.setItem(scrollKey, window.scrollY);\r\n    }, 1000);\r\n}\r\n\r\n/**\r\n * Display a game over modal with a button to go to the leaderboard\r\n */\r\nfunction showGameOverModal() {\r\n    // Create modal elements\r\n    const modalOverlay = document.createElement('div');\r\n    modalOverlay.className = 'modal';\r\n    modalOverlay.id = 'game-over-modal';\r\n\r\n    const modalContent = document.createElement('div');\r\n    modalContent.className = 'modal-content';\r\n\r\n    const closeButton = document.createElement('span');\r\n    closeButton.className = 'close-modal';\r\n    closeButton.innerHTML = '&times;';\r\n    closeButton.title = 'Close';\r\n\r\n    const messageElement = document.createElement('p');\r\n    messageElement.innerHTML = 'Game Over! All questions have been answered.<br><span dir=\"rtl\">انتهت اللعبة! تمت الإجابة على جميع الأسئلة.</span>';\r\n\r\n    const leaderboardButton = document.createElement('a');\r\n    leaderboardButton.href = \"{{ url_for('leaderboard', room_id=room.room_id) }}\";\r\n    leaderboardButton.className = 'button';\r\n    leaderboardButton.textContent = 'Go to Leaderboard | عــرض النتائــج';\r\n\r\n    // Assemble the modal\r\n    modalContent.appendChild(closeButton);\r\n    modalContent.appendChild(messageElement);\r\n    modalContent.appendChild(leaderboardButton);\r\n    modalOverlay.appendChild(modalContent);\r\n\r\n    // Add to the document\r\n    document.body.appendChild(modalOverlay);\r\n\r\n    // Display the modal\r\n    modalOverlay.style.display = 'block';\r\n\r\n    // Event listeners for closing the modal\r\n    closeButton.addEventListener('click', () => {\r\n        modalOverlay.style.display = 'none';\r\n        if (modalOverlay.parentNode) {\r\n            modalOverlay.parentNode.removeChild(modalOverlay);\r\n        }\r\n    });\r\n\r\n    modalOverlay.addEventListener('click', (event) => {\r\n        if (event.target === modalOverlay) {\r\n            modalOverlay.style.display = 'none';\r\n            if (modalOverlay.parentNode) {\r\n                modalOverlay.parentNode.removeChild(modalOverlay);\r\n            }\r\n        }\r\n    });\r\n\r\n    // Allow closing with Escape key\r\n    document.addEventListener('keydown', function escapeHandler(event) {\r\n        if (event.key === 'Escape') {\r\n            modalOverlay.style.display = 'none';\r\n            if (modalOverlay.parentNode) {\r\n                modalOverlay.parentNode.removeChild(modalOverlay);\r\n            }\r\n            document.removeEventListener('keydown', escapeHandler);\r\n        }\r\n    });\r\n}\r\n\r\n</script>\r\n\r\n{% endblock %}\r\n
