<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"gamebase.html\" %}\r\n\r\n{% block title %}Avirta - Question{% endblock %}\r\n\r\n{% block extra_head %}\r\n<style>\r\n{% if acting_player %}\r\n    .host-acting-info {\r\n        margin: 10px 0;\r\n        padding: 10px;\r\n        color: var(--primary-color);\r\n        border-radius: 5px;\r\n\t\tborder: solid;\r\n\t\tborder-color: var(--primary-color);\r\n        text-align: center;\r\n    }\r\n\r\n    .host-acting-info p {\r\n        margin: 0;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .host-acting-info strong {\r\n        text-decoration: underline;\r\n    }\r\n{% endif %}\r\n\r\n</style>\r\n{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"page-section\">\r\n    <div class=\"question-header\">\r\n        <h2>Question</h2>\r\n        <p>Category: <span class=\"category-badge\">{{ question.category_id|capitalize }}</span> | Points: <span class=\"points-badge\">{{ question.points }}</span>{% if question.doubled %} (Doubled!){% endif %}</p>\r\n        {% if acting_player %}\r\n            <div> \r\n                <p class=\"green-box\">You are answering on behalf of: <strong>{{ acting_player }}</strong></p>\r\n            </div>\r\n        {% endif %}\r\n    </div>\r\n\r\n    <div class=\"question-display\">\r\n        <div class=\"question-text\" dir=\"{% if question.question|is_arabic %}rtl{% else %}ltr{% endif %}\">{{ question.question }}</div>\r\n\r\n        {% if question.type == 'text' %}\r\n            <div class=form-container>\r\n                <button type=\"button\" id=\"show-answer-btn\" onclick=\"showAnswer()\">Show Answer إظهار الجواب</button>\r\n                <div id=\"answer-section\" style=\"display: none; width: 100%;\">\r\n                    <div class=\"form-group\">\r\n                        <div class=\"answer-text\" dir=\"{% if question.correct_answer|is_arabic %}rtl{% else %}ltr{% endif %}\"><h2 class=\"text-center\">{{ question.correct_answer }}</h2></div>\r\n                    </div>\r\n                    <div>\r\n\t\t\t\t\t\t<form action=\"{{ url_for('evaluate_answer') }}\" method=\"post\" class=\"form-actions clear\">\r\n\t\t\t\t\t\t\t<input type=\"hidden\" name=\"acting_player\" value=\"{{ acting_player }}\">\r\n\t\t\t\t\t\t\t<button type=\"submit\" name=\"evaluation\" value=\"correct\" class=\"success-button\">Right answer إجابة صحيحة</button>\r\n\t\t\t\t\t\t\t<button type=\"submit\" name=\"evaluation\" value=\"incorrect\" class=\"delete-button\">Wrong answer إجابـة خطـأ</button>\r\n\t\t\t\t\t\t</form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        {% else %}\r\n            <form action=\"{{ url_for('answer_question') }}\" method=\"post\" class=\"answer-form\">\r\n                {% if question.type == 'multiple_choice' %}\r\n                    <div class=\"form-group-grid3\">\r\n                        {% for option in question.options %}\r\n                            <button type=\"button\" class=\"option-button\" onclick=\"submitAnswer('{{ option }}')\">\r\n                                <span dir=\"{% if option|is_arabic %}rtl{% else %}ltr{% endif %}\">{{ option }}</span>\r\n                            </button>\r\n                        {% endfor %}\r\n                    </div>\r\n                {% elif question.type == 'true_false' %}\r\n                    <div class=\"form-group-grid3\">\r\n                        <button type=\"button\" class=\"option-button\" onclick=\"submitAnswer('true')\">True | صحيح</button>\r\n                        <button type=\"button\" class=\"option-button\" onclick=\"submitAnswer('false')\">False | خطــأ</button>\r\n                    </div>\r\n                {% endif %}\r\n            </form>\r\n            <div class=\"form-actions\" style=\"display: none;\">\r\n                <button type=\"submit\">Submit Answer تسجيل الإجابة</button>\r\n            </div>\r\n\t{% endif %}\r\n\t\t\t<br>\r\n            <form id= \"change-question-form\" action=\"{{ url_for('use_tool') }}\" method=\"post\" class=\"form-actions clear\">\r\n                <input type=\"hidden\" name=\"tool_name\" value=\"change_question\">\r\n                <input type=\"hidden\" name=\"acting_player\" value=\"{{ current_player }}\">\r\n\t\t\t\t<button type=\"submit\" id=\"change-question-btn\" class=\"button\" {% if not player_tools or not player_tools.change_question %}disabled=\"disabled\" style=\"opacity: 0.5; cursor: not-allowed;\" title=\"This tool has already been used\"{% endif %}>Change Question | غيــّـــر الســـــؤال</button>\r\n            </form>\r\n\r\n    </div>\r\n</div>\r\n{% endblock %}\r\n\r\n{% block scripts %}\r\n<script>\r\n    function showAnswer() {\r\n        document.getElementById('show-answer-btn').style.display = 'none';\r\n        document.getElementById('answer-section').style.display = 'block';\r\n        document.getElementById('change-question-form').style.display = 'none';\r\n    }\r\n</script>\r\n\r\n<script>\r\n    function submitAnswer(answer) {\r\n        // Create a hidden input for the answer\r\n        const hiddenInput = document.createElement('input');\r\n        hiddenInput.type = 'hidden';\r\n        hiddenInput.name = 'answer';\r\n        hiddenInput.value = answer;\r\n\r\n        // Add the hidden input to the form\r\n        const form = document.querySelector('.answer-form');\r\n        form.appendChild(hiddenInput);\r\n\r\n        // Submit the form\r\n        form.submit();\r\n    }\r\n</script>\r\n\r\n<!-- Include the gametools.js script -->\r\n<script src=\"{{ url_for('static', filename='js/gametools.js') }}\"></script>\r\n\r\n<!-- Add data attributes for the gametools.js script -->\r\n<script>\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    // Add data attributes to the page-section element\r\n    const pageSection = document.querySelector('.page-section');\r\n    if (pageSection) {\r\n        pageSection.dataset.roomId = '{{ room_id }}';\r\n        pageSection.dataset.playerName = '{{ player_name }}';\r\n        pageSection.dataset.currentPlayer = '{{ current_player }}';\r\n    }\r\n});\r\n</script>\r\n{% endblock %}\r\n
