<+><link href=\"../static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"gamebase.html\" %}\r\n\r\n{% block title %}Avirta - Leaderboard{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"leaderboard-section\">\r\n    <div class=\"leaderboard-header\">\r\n        <h2>Leaderboard | النتـــــائـــــج</h2>\r\n    </div>\r\n\r\n    <div class=\"leaderboard-display\">\r\n        {% if leaderboard %}\r\n            <table class=\"leaderboard-table\">\r\n                <thead>\r\n                    <tr>\r\n                        <th>Rank | الترتيب</th>\r\n                        <th>Player | اللاعب</th>\r\n                        <th>Score | النتيجة</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    {% for player, score in leaderboard %}\r\n                        <tr>\r\n                            <td>{{ loop.index }}</td>\r\n                            <td>{{ player }}</td>\r\n                            <td>{{ score }}</td>\r\n                        </tr>\r\n                    {% endfor %}\r\n                </tbody>\r\n            </table>\r\n        {% else %}\r\n            <div class=\"no-scores\">\r\n                <p>No scores yet. Start answering questions to see the leaderboard!</p>\r\n            </div>\r\n        {% endif %}\r\n    </div>\r\n  {% if room.is_board_completed() %}\r\n    <div>\r\n      \t<form class=\"form-actions clear center\">\r\n\t\t<input type=\"hidden\" name=\"room_id\" value=\"{{ room.room_id }}\"><a href=\"{{ url_for('end_game', room_id=room.room_id) }}\" class=\"button large\">End Game | إنهاء اللعبة</a>\r\n\r\n\t\t</form>\r\n    </div>\r\n  {% endif %}\r\n    <div class=\"form-actions\">\r\n        <a href=\"{{ url_for('game_room', room_id=room_id) }}\" class=\"button\">Return to Game Board</a>\r\n\r\n    </div>\r\n</div>\r\n{% endblock %}\r\n
