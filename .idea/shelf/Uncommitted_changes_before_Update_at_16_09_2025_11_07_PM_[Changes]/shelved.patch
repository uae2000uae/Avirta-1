<+><link href=\"/static/css/style.css\" rel=\"stylesheet\" type=\"text/css\">\r\n{% extends \"base.html\" %}\r\n\r\n{% block title %}Admin Controls - Avirta{% endblock %}\r\n\r\n{% block content %}\r\n<div class=\"back-navigation\">\r\n    <a href=\"{{ url_for('index') }}\" class=\"button\"><i class=\"fas fa-arrow-left\"></i> Back to Homepage</a>\r\n</div>\r\n<h1>Admin Controls</h1>\r\n\r\n{% if not is_authenticated %}\r\n<div class=\"login-form\">\r\n    <h2>Admin Login</h2>\r\n    {% if login_error %}\r\n    <div class=\"error-message\">{{ login_error }}</div>\r\n    {% endif %}\r\n    <form method=\"POST\" action=\"{{ url_for('admin_controls') }}\">\r\n        <div class=\"form-group\">\r\n            <label for=\"username\">Username:</label>\r\n            <input type=\"text\" id=\"username\" name=\"username\" required>\r\n        </div>\r\n\t\t<br>\r\n        <div class=\"form-group\">\r\n            <label for=\"password\">Password:</label>\r\n            <input type=\"password\" id=\"password\" name=\"password\" required>\r\n        </div>\r\n        <div class=\"form-actions\">\r\n            <button type=\"submit\" class=\"button\">Login</button>\r\n        </div>\r\n    </form>\r\n</div>\r\n{% else %}\r\n<div class=\"admin-dashboard\">\r\n    <!-- Tab Navigation -->\r\n    <div class=\"admin-tabs\">\r\n        <div class=\"tab-nav\">\r\n            <button class=\"tab-button active\" data-tab=\"game-settings\">General</button>\r\n            <button class=\"tab-button\" data-tab=\"api-settings\">API Settings</button>\r\n            <button class=\"tab-button\" data-tab=\"question-management\">Question Management</button>\r\n            <button class=\"tab-button\" data-tab=\"look-and-feel\">Look and Feel</button>\r\n            <button class=\"tab-button\" data-tab=\"system-info\">System Information</button>\r\n        </div>\r\n\r\n        <!-- Tab Content -->\r\n        <div class=\"section\">\r\n            <!-- Game Settings Tab -->\r\n            <div id=\"game-settings\" class=\"tab-pane active\">\r\n                <div class=\"inner-section\">\r\n                    <h2>Game Settings</h2>\r\n                    <form action=\"{{ url_for('admin_controls') }}\" method=\"POST\" class=\"form-group\">\r\n                        <input type=\"hidden\" name=\"action\" value=\"update_settings\">\r\n                        {% for setting_name, setting_value in admin_setup.game_settings.items() %}\r\n                            {% if not setting_name.startswith('openai_') and not setting_name.startswith('github_') and not setting_name.startswith('primary_color') and not setting_name.startswith('secondary_color') and not setting_name.startswith('bg_color') and not setting_name.startswith('text_color') and not setting_name.startswith('success_') and not setting_name.startswith('error_') and not setting_name.startswith('info_') and not setting_name.startswith('border_') and not setting_name.startswith('spacing_') and not setting_name.startswith('font_') and not setting_name == 'line_height' and not setting_name == 'box_shadow' and not setting_name == 'selected_theme' %}\r\n                      <div class=\"form-group-equal-md\">\r\n                              <label for=\"{{ setting_name }}\">{{ setting_name|replace('_', ' ')|title }}:</label>\r\n                              {% if setting_value is sameas true or setting_value is sameas false %}\r\n\t\t\t\t\t\t  <select id=\"{{ setting_name }}\" name=\"{{ setting_name }}\">\r\n\t\t\t\t\t\t\t<option value=\"true\" {% if setting_value %}selected{% endif %}>Enabled</option>\r\n\t\t\t\t\t\t\t<option value=\"false\" {% if not setting_value %}selected{% endif %}>Disabled</option>\r\n\t\t\t\t\t\t  </select>\r\n                              {% elif setting_name == 'max_categories_per_room' %}\r\n                          <select id=\"{{ setting_name }}\" name=\"{{ setting_name }}\">\r\n                            {% for i in range(3, 8) %}\r\n                              <option value=\"{{ i }}\" {% if setting_value == i %}selected{% endif %}>{{ i }}</option>\r\n                            {% endfor %}\r\n                          </select>\r\n                              {% elif setting_name == 'max_players_per_room' %}\r\n                          <select id=\"{{ setting_name }}\" name=\"{{ setting_name }}\">\r\n                            {% for i in range(2, 9) %}\r\n                              <option value=\"{{ i }}\" {% if setting_value == i %}selected{% endif %}>{{ i }}</option>\r\n                            {% endfor %}\r\n                          </select>\r\n                              {% elif setting_name == 'questions_per_category' %}\r\n                          <select id=\"{{ setting_name }}\" name=\"{{ setting_name }}\">\r\n                            {% for i in range(5, 11) %}\r\n                              <option value=\"{{ i }}\" {% if setting_value == i %}selected{% endif %}>{{ i }}</option>\r\n                            {% endfor %}\r\n                          </select>\r\n                              {% elif setting_value is string %}\r\n\t\t\t\t\t\t  <input type=\"text\" id=\"{{ setting_name }}\" name=\"{{ setting_name }}\" value=\"{{ setting_value }}\">\r\n\t\t\t\t\t\t\t\t {% else %}\r\n\t\t\t\t\t\t  <input type=\"number\" id=\"{{ setting_name }}\" name=\"{{ setting_name }}\" value=\"{{ setting_value }}\">\r\n\t\t\t\t\t\t\t\t  {% endif %}\r\n\t\t\t\t\t\t</div>\r\n\r\n                            {% endif %}\r\n                        {% endfor %}\r\n                        <div class=\"form-actions\">\r\n                          <button type=\"submit\" class=\"button\">Update Settings</button>\r\n                        </div>\r\n                    </form>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- API Settings Tab -->\r\n            <div id=\"api-settings\" class=\"tab-pane\">\r\n                <div class=\"inner-section\">\r\n                    <h2>API Settings</h2>\r\n                    <p>These settings are used for various API integrations. You need to provide your own API keys to use these features.</p>\r\n\r\n                    <!-- Saved Settings Dropdown -->\r\n\t\t\t\t<div class=\"section\">\r\n\t\t\t\t\t<h3>Saved API Settings</h3>\r\n                    \t<div class=\"form-group-grid1\">\r\n                        <form action=\"{{ url_for('admin_controls') }}\" method=\"POST\" class=\"form-group equal-md\">\r\n                          <input type=\"hidden\" name=\"action\" value=\"load_api_settings\">\r\n                          <div class=\"fill-stack\">\r\n                            <label for=\"saved_settings\" class=\"fill\">Saved Settings:</label>\r\n                            <select id=\"saved_settings\" name=\"saved_settings\">\r\n                              <option value=\"\">-- Select Settings --</option>\r\n                              {% for name, settings in admin_setup.get_saved_api_settings().items() %}\r\n                              <option value=\"{{ name }}\">{{ name }}</option>\r\n                              {% endfor %}\r\n                            </select>\r\n                          </div>\r\n                          <div class=\"form-actions\">\r\n                            <button type=\"submit\" class=\"button\">Update</button>\r\n                            <button type=\"submit\" class=\"button delete-button\" formaction=\"{{ url_for('admin_controls') }}\" \r\n                                            onclick=\"this.form.action.value='delete_api_settings'; return confirm('Are you sure you want to delete these settings?');\"> Delete </button>\r\n                          </div>\r\n                        </form>\r\n                      <form action=\"{{ url_for('admin_controls') }}\" method=\"POST\" class=\"form-group equal-md\">\r\n                          <input type=\"hidden\" name=\"action\" value=\"save_api_settings\">\r\n                          <div class=\"fill-stack\">\r\n                            <label for=\"settings_name\" class=\"fill\">Save Current:</label>\r\n                            <input type=\"text\" id=\"settings_name\" name=\"settings_name\" placeholder=\"Enter a name for these settings\" required>\r\n                          </div>\r\n                          <div class=\"form-actions\">\r\n                            <button type=\"submit\" class=\"button\">Save Current Settings</button>\r\n                          </div>\r\n\t\t\t\t\t</form>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t<br>\r\n                    <!-- Current API Settings Form -->\r\n                    <div class=\"section\">\r\n                        <h3>API Settings</h3>\r\n\t\t\t\t\t\t<div class=\"form-group-grid1\">\r\n                        <form action=\"{{ url_for('admin_controls') }}\" method=\"POST\" class=\"form-group equal-md\">\r\n                            <input type=\"hidden\" name=\"action\" value=\"update_api_settings\">\r\n\r\n                            <h4 class=\"fill\">OpenAI API Settings</h4>\r\n                            {% for setting_name, setting_value in admin_setup.game_settings.items() %}\r\n                                {% if setting_name.startswith('openai_') %}\r\n                                <div>\r\n                                    <label for=\"{{ setting_name }}\">{{ setting_name|replace('_', ' ')|title }}:</label>\r\n                                    {% if setting_name == 'openai_api_key' %}\r\n                                        <input type=\"text\" id=\"{{ setting_name }}\" name=\"{{ setting_name }}\" value=\"{{ setting_value }}\" placeholder=\"Enter your OpenAI API key\">\r\n                                    {% elif setting_value is string %}\r\n                                        <input type=\"text\" id=\"{{ setting_name }}\" name=\"{{ setting_name }}\" value=\"{{ setting_value }}\">\r\n                                    {% else %}\r\n                                        <input type=\"number\" id=\"{{ setting_name }}\" name=\"{{ setting_name }}\" value=\"{{ setting_value }}\" step=\"0.1\">\r\n                                    {% endif %}\r\n                                </div>\r\n                                {% endif %}\r\n                            {% endfor %}\r\n\r\n                            <h4 class=\"fill\">GitHub API Settings</h4>\r\n                            <div>\r\n                                <label for=\"github_token\">GitHub Token:</label>\r\n                                <input type=\"text\" id=\"github_token\" name=\"github_token\" value=\"{{ admin_setup.saved_api_settings.get(admin_setup.get_saved_api_settings().keys()|list|first, {}).get('github_token', '') }}\" placeholder=\"Enter your GitHub personal access token\">\r\n                            </div>\r\n                            <div>\r\n                                <label for=\"github_repo_owner\">Repository Owner:</label>\r\n                                <input type=\"text\" id=\"github_repo_owner\" name=\"github_repo_owner\" value=\"{{ admin_setup.saved_api_settings.get(admin_setup.get_saved_api_settings().keys()|list|first, {}).get('github_repo_owner', '') }}\" placeholder=\"GitHub username or organization\">\r\n                            </div>\r\n                            <div>\r\n                                <label for=\"github_repo_name\">Repository Name:</label>\r\n                                <input type=\"text\" id=\"github_repo_name\" name=\"github_repo_name\" value=\"{{ admin_setup.saved_api_settings.get(admin_setup.get_saved_api_settings().keys()|list|first, {}).get('github_repo_name', '') }}\" placeholder=\"Name of the repository\">\r\n                            </div>\r\n                            <div>\r\n                                <label for=\"github_branch\">Branch Name:</label>\r\n                                <input type=\"text\" id=\"github_branch\" name=\"github_branch\" value=\"{{ admin_setup.saved_api_settings.get(admin_setup.get_saved_api_settings().keys()|list|first, {}).get('github_branch', '') }}\" placeholder=\"Branch name (e.g., main)\">\r\n                            </div>\r\n\r\n                            <div class=\"form-actions\">\r\n                                <button type=\"submit\" class=\"button\">Update API Settings</button>\r\n                            </div>\r\n                        </form>\r\n                    </div>\r\n\t\t\t\t\t</div>\r\n                    </div></div>\r\n\r\n            <!-- Question Management Tab -->\r\n            <div id=\"question-management\" class=\"tab-pane\">\r\n                <div class=\"inner-section\">\r\n                    <h2>Question Management</h2>\r\n                    <div class=\"actions\">\r\n\t\t\t\t\t\t<a href=\"{{ url_for('add_question_page') }}\" class=\"button\">Add New Questions</a>\r\n\t\t\t\t\t\t<a href=\"{{ url_for('bulk_import_page') }}\" class=\"button\">Bulk Import</a>\r\n\t\t\t\t\t\t<a href=\"{{ url_for('ai_question_generator') }}\" class=\"button\">Generate with AI</a>\r\n                        <a href=\"{{ url_for('ai_question_history') }}\" class=\"button\">AI Generate History</a>\r\n                        <a href=\"{{ url_for('reported_questions') }}\" class=\"button\">Reported Questions</a>\r\n                        <a href=\"{{ url_for('push_questions_to_github') }}\" class=\"button\">Push to GitHub</a>\r\n                        <a href=\"{{ url_for('question_bank_page') }}\" class=\"button\">Question Bank</a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Look and Feel Tab -->\r\n            <div id=\"look-and-feel\" class=\"tab-pane\">\r\n                <div class=\"inner-section\">\r\n                    <h2>Look and Feel Settings</h2>\r\n                    <p>Select a theme to customize the appearance of the Avirta web app. Changes will be applied immediately and saved for the current session.</p>\r\n\r\n                    <div class=\"theme-selection\">\r\n                        <form id=\"theme-form\" action=\"{{ url_for('admin_controls') }}\" method=\"POST\">\r\n                            <input type=\"hidden\" name=\"action\" value=\"apply_theme\">\r\n\r\n                            <!-- Dark Themes Section -->\r\n                            <h3>Dark Themes</h3>\r\n                            <div class=\"theme-options\">\r\n                                {% for theme in admin_setup.get_available_themes() %}\r\n                                    {% if theme.name.startswith('dark_') %}\r\n                                    <div class=\"theme-option\">\r\n                                        <input type=\"radio\" id=\"theme-{{ theme.name }}\" name=\"theme_name\" value=\"{{ theme.name }}\">\r\n                                        <label for=\"theme-{{ theme.name }}\">\r\n                                            <div class=\"theme-preview {{ theme.name }}\"></div>\r\n                                            <span>{{ theme.display_name }}</span>\r\n                                        </label>\r\n                                    </div>\r\n                                    {% endif %}\r\n                                {% endfor %}\r\n                            </div>\r\n\r\n                            <!-- Light Themes Section -->\r\n                            <h3>Light Themes</h3>\r\n                            <div class=\"theme-options\">\r\n                                {% for theme in admin_setup.get_available_themes() %}\r\n                                    {% if theme.name.startswith('light_') %}\r\n                                    <div class=\"theme-option\">\r\n                                        <input type=\"radio\" id=\"theme-{{ theme.name }}\" name=\"theme_name\" value=\"{{ theme.name }}\">\r\n                                        <label for=\"theme-{{ theme.name }}\">\r\n                                            <div class=\"theme-preview {{ theme.name }}\"></div>\r\n                                            <span>{{ theme.display_name }}</span>\r\n                                        </label>\r\n                                    </div>\r\n                                    {% endif %}\r\n                                {% endfor %}\r\n                            </div>\r\n\r\n                            <div class=\"form-actions theme-apply-button\">\r\n                                <button type=\"submit\" class=\"button\">Apply Selected Theme</button>\r\n                            </div>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <style>\r\n            /* Section styling */\r\n            .section h4 {\r\n                margin-top: 20px;\r\n                margin-bottom: 10px;\r\n                color: var(--text-color-white);\r\n                border-bottom: 1px solid var(--text-color-white);\r\n                padding-bottom: 5px;\r\n            }\r\n\r\n            .theme-selection {\r\n                margin-top: 20px;\r\n            }\r\n\r\n            .theme-options {\r\n                display: flex;\r\n                flex-wrap: wrap;\r\n                gap: 20px;\r\n                margin-top: 15px;\r\n                justify-content: center;\r\n            }\r\n\r\n            .theme-option {\r\n                position: relative;\r\n                width: 150px;\r\n            }\r\n\r\n            .theme-option input[type=\"radio\"] {\r\n                position: absolute;\r\n                opacity: 0;\r\n                width: 0;\r\n                height: 0;\r\n            }\r\n\r\n            .theme-option label {\r\n                display: flex;\r\n                flex-direction: column;\r\n                align-items: center;\r\n                cursor: pointer;\r\n                padding: 10px;\r\n                border-radius: var(--border-radius);\r\n                border: 2px solid transparent;\r\n                transition: all 0.3s ease;\r\n            }\r\n\r\n            .theme-option input[type=\"radio\"]:checked + label {\r\n                border-color: var(--primary-color);\r\n                background-color: rgba(0, 0, 0, 0.1);\r\n            }\r\n\r\n            .theme-preview {\r\n                width: 120px;\r\n                height: 80px;\r\n                border-radius: var(--border-radius-small);\r\n                margin-bottom: 10px;\r\n                box-shadow: var(--box-shadow);\r\n                overflow: hidden;\r\n            }\r\n\r\n            /* Theme preview backgrounds */\r\n            /* Dark Blue Theme */\r\n            .theme-preview.dark_blue_theme {\r\n                background: linear-gradient(to bottom right, #0f202d, #346176);\r\n                border: 1px solid #e0c494;\r\n                position: relative;\r\n            }\r\n\r\n            .theme-preview.dark_blue_theme::after {\r\n                content: \"Aa\";\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                transform: translate(-50%, -50%);\r\n                color: #e0c494;\r\n                font-weight: bold;\r\n                font-size: 24px;\r\n            }\r\n\r\n            /* Dark Purple Theme */\r\n            .theme-preview.dark_purple_theme {\r\n                background: linear-gradient(to bottom right, #1a0d24, #4a2d6a);\r\n                border: 1px solid #e0c4f4;\r\n                position: relative;\r\n            }\r\n\r\n            .theme-preview.dark_purple_theme::after {\r\n                content: \"Aa\";\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                transform: translate(-50%, -50%);\r\n                color: #e0c4f4;\r\n                font-weight: bold;\r\n                font-size: 24px;\r\n            }\r\n\r\n            /* Dark Green Theme */\r\n            .theme-preview.dark_green_theme {\r\n                background: linear-gradient(to bottom right, #0d1f0e, #2e7d32);\r\n                border: 1px solid #c4e0c6;\r\n                position: relative;\r\n            }\r\n\r\n            .theme-preview.dark_green_theme::after {\r\n                content: \"Aa\";\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                transform: translate(-50%, -50%);\r\n                color: #c4e0c6;\r\n                font-weight: bold;\r\n                font-size: 24px;\r\n            }\r\n\r\n            /* Light Blue Theme */\r\n            .theme-preview.light_blue_theme {\r\n                background: linear-gradient(to bottom right, #ffffff, #c3d9dc);\r\n                border: 1px solid #346075;\r\n                position: relative;\r\n            }\r\n\r\n            .theme-preview.light_blue_theme::after {\r\n                content: \"Aa\";\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                transform: translate(-50%, -50%);\r\n                color: #1e595e;\r\n                font-weight: bold;\r\n                font-size: 24px;\r\n            }\r\n\r\n            /* Light Purple Theme */\r\n            .theme-preview.light_purple_theme {\r\n                background: linear-gradient(to bottom right, #ffffff, #e1d5f5);\r\n                border: 1px solid #673ab7;\r\n                position: relative;\r\n            }\r\n\r\n            .theme-preview.light_purple_theme::after {\r\n                content: \"Aa\";\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                transform: translate(-50%, -50%);\r\n                color: #4a148c;\r\n                font-weight: bold;\r\n                font-size: 24px;\r\n            }\r\n\r\n            /* Light Green Theme */\r\n            .theme-preview.light_green_theme {\r\n                background: linear-gradient(to bottom right, #ffffff, #e8f5e9);\r\n                border: 1px solid #2e7d32;\r\n                position: relative;\r\n            }\r\n\r\n            .theme-preview.light_green_theme::after {\r\n                content: \"Aa\";\r\n                position: absolute;\r\n                top: 50%;\r\n                left: 50%;\r\n                transform: translate(-50%, -50%);\r\n                color: #1b5e20;\r\n                font-weight: bold;\r\n                font-size: 24px;\r\n            }\r\n\r\n            .theme-option span {\r\n                font-weight: 500;\r\n                margin-top: 5px;\r\n            }\r\n\r\n            .theme-apply-button {\r\n                margin-top: 20px;\r\n                text-align: center;\r\n            }\r\n\r\n            .theme-apply-button .button {\r\n                padding: 10px 20px;\r\n                font-size: 16px;\r\n                background-color: var(--primary-color);\r\n                color: var(--text-color-white);\r\n                border: none;\r\n                border-radius: var(--border-radius);\r\n                cursor: pointer;\r\n                transition: background-color 0.3s;\r\n            }\r\n\r\n            .theme-apply-button .button:hover {\r\n                background-color: var(--primary-color-light);\r\n            }\r\n            </style>\r\n\r\n            <script>\r\n            document.addEventListener('DOMContentLoaded', function() {\r\n                // Set the initial checked state based on the selected theme\r\n                var selectedTheme = \"{{ admin_setup.game_settings.get('selected_theme', '') }}\";\r\n                if (selectedTheme) {\r\n                    document.getElementById('theme-' + selectedTheme).checked = true;\r\n                }\r\n\r\n                // No event listeners for radio buttons - we're using the submit button now\r\n            });\r\n            </script>\r\n\r\n            <!-- System Information Tab -->\r\n            <div id=\"system-info\" class=\"tab-pane\">\r\n                <div class=\"section\">\r\n                    <h2>System Information</h2>\r\n                    <div class=\"stats-container\">\r\n                        <div class=\"stats-overview\">\r\n                            <div class=\"stat-card\">\r\n                                <h3>Active Sessions</h3>\r\n                                <p class=\"stat-value\">{{ admin_setup.active_sessions|length }}</p>\r\n                            </div>\r\n                            <div class=\"stat-card\">\r\n                                <h3>Admin Users</h3>\r\n                                <p class=\"stat-value\">{{ admin_setup.admins|length }}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"inner-section\">\r\n                    <h2>Recent Logs</h2>\r\n                    <div class=\"logs-container\">\r\n                        <table class=\"logs-table\">\r\n                            <tr>\r\n                                <th>Timestamp</th>\r\n                                <th>Description</th>\r\n                            </tr>\r\n                            {% for log in admin_setup.get_logs(10) %}\r\n                            <tr>\r\n                                <td>{{ log.timestamp }}</td>\r\n                                <td>{{ log.description }}</td>\r\n                            </tr>\r\n                            {% endfor %}\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<!-- Tab Switching JavaScript -->\r\n<script>\r\ndocument.addEventListener('DOMContentLoaded', function() {\r\n    // Get all tab buttons and tab panes\r\n    const tabButtons = document.querySelectorAll('.tab-button');\r\n    const tabPanes = document.querySelectorAll('.tab-pane');\r\n\r\n    // Check if there's a saved active tab in localStorage\r\n    const savedActiveTab = localStorage.getItem('adminActiveTab');\r\n\r\n    // If there's a saved tab, activate it\r\n    if (savedActiveTab) {\r\n        // Remove active class from all buttons and panes\r\n        tabButtons.forEach(btn => btn.classList.remove('active'));\r\n        tabPanes.forEach(pane => pane.classList.remove('active'));\r\n\r\n        // Add active class to the saved tab button and pane\r\n        const savedTabButton = document.querySelector(`.tab-button[data-tab=\"${savedActiveTab}\"]`);\r\n        if (savedTabButton) {\r\n            savedTabButton.classList.add('active');\r\n            const savedTabPane = document.getElementById(savedActiveTab);\r\n            if (savedTabPane) {\r\n                savedTabPane.classList.add('active');\r\n            }\r\n        }\r\n    }\r\n\r\n    // Add event listener for saved settings dropdown\r\n    const savedSettingsDropdown = document.getElementById('saved_settings');\r\n    if (savedSettingsDropdown) {\r\n        savedSettingsDropdown.addEventListener('change', function() {\r\n            const selectedSetting = this.value;\r\n            if (selectedSetting) {\r\n                // Get all the OpenAI settings inputs\r\n                const apiKeyInput = document.getElementById('openai_api_key');\r\n                const modelInput = document.getElementById('openai_model');\r\n                const temperatureInput = document.getElementById('openai_temperature');\r\n                const maxTokensInput = document.getElementById('openai_max_tokens');\r\n\r\n                // Fetch the saved settings from the server\r\n                fetch(`/get_api_settings/${selectedSetting}`)\r\n                .then(response => {\r\n                    if (!response.ok) {\r\n                        throw new Error('Failed to load settings');\r\n                    }\r\n                    return response.json();\r\n                })\r\n                .then(settings => {\r\n                    // Update the input fields with the values from the response\r\n                    if (apiKeyInput && settings.openai_api_key !== undefined) {\r\n                        apiKeyInput.value = settings.openai_api_key;\r\n                    }\r\n                    if (modelInput && settings.openai_model !== undefined) {\r\n                        modelInput.value = settings.openai_model;\r\n                    }\r\n                    if (temperatureInput && settings.openai_temperature !== undefined) {\r\n                        temperatureInput.value = settings.openai_temperature;\r\n                    }\r\n                    if (maxTokensInput && settings.openai_max_tokens !== undefined) {\r\n                        maxTokensInput.value = settings.openai_max_tokens;\r\n                    }\r\n\r\n                    // Show a success message\r\n                    const flashContainer = document.querySelector('.flash-messages');\r\n                    if (!flashContainer) {\r\n                        // Create flash messages container if it doesn't exist\r\n                        const container = document.querySelector('.container');\r\n                        const flashDiv = document.createElement('div');\r\n                        flashDiv.className = 'flash-messages';\r\n                        container.insertBefore(flashDiv, container.firstChild);\r\n                    }\r\n\r\n                    // Create and add the flash message\r\n                    const flashMessage = document.createElement('div');\r\n                    flashMessage.className = 'flash-message success';\r\n                    flashMessage.textContent = `Settings \"${selectedSetting}\" loaded successfully`;\r\n                    document.querySelector('.flash-messages').appendChild(flashMessage);\r\n\r\n                    // Remove the message after 5 seconds\r\n                    setTimeout(() => {\r\n                        flashMessage.remove();\r\n                    }, 5000);\r\n                })\r\n                .catch(error => {\r\n                    console.error('Error loading settings:', error);\r\n\r\n                    // Show an error message\r\n                    const flashContainer = document.querySelector('.flash-messages');\r\n                    if (!flashContainer) {\r\n                        // Create flash messages container if it doesn't exist\r\n                        const container = document.querySelector('.container');\r\n                        const flashDiv = document.createElement('div');\r\n                        flashDiv.className = 'flash-messages';\r\n                        container.insertBefore(flashDiv, container.firstChild);\r\n                    }\r\n\r\n                    // Create and add the flash message\r\n                    const flashMessage = document.createElement('div');\r\n                    flashMessage.className = 'flash-message error';\r\n                    flashMessage.textContent = `Failed to load settings \"${selectedSetting}\". Please try again.`;\r\n                    document.querySelector('.flash-messages').appendChild(flashMessage);\r\n\r\n                    // Remove the message after 5 seconds\r\n                    setTimeout(() => {\r\n                        flashMessage.remove();\r\n                    }, 5000);\r\n                });\r\n            }\r\n        });\r\n    }\r\n\r\n    // Add click event listeners to tab buttons\r\n    tabButtons.forEach(button => {\r\n        button.addEventListener('click', function() {\r\n            // Remove active class from all buttons and panes\r\n            tabButtons.forEach(btn => btn.classList.remove('active'));\r\n            tabPanes.forEach(pane => pane.classList.remove('active'));\r\n\r\n            // Add active class to clicked button\r\n            this.classList.add('active');\r\n\r\n            // Show the corresponding tab pane\r\n            const tabId = this.getAttribute('data-tab');\r\n            document.getElementById(tabId).classList.add('active');\r\n\r\n            // Save the active tab to localStorage\r\n            localStorage.setItem('adminActiveTab', tabId);\r\n        });\r\n    });\r\n\r\n    // Look and Feel Tab JavaScript\r\n\r\n    // Individual style variable settings have been removed, only theme selection is available\r\n});\r\n</script>\r\n\r\n<!-- Tab Styles -->\r\n<style>\r\n/* Back Navigation */\r\n.back-navigation {\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.back-navigation .button {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 5px;\r\n}\r\n\r\n/* API Settings Styles */\r\n.saved-settings-section,\r\n.current-settings-section,\r\n.save-settings-section {\r\n    margin-bottom: 30px;\r\n    padding: 20px;\r\n    background-color: var(--bg-color-lighter);\r\n    border-radius: var(--border-radius);\r\n    box-shadow: var(--box-shadow);\r\n}\r\n\r\n.saved-settings-section h3,\r\n.current-settings-section h3,\r\n.save-settings-section h3 {\r\n    margin-top: 0;\r\n    padding-bottom: 10px;\r\n    border-bottom: 1px solid var(--border-color-light);\r\n}\r\n\r\n.settings-actions {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 15px;\r\n}\r\n\r\n.load-settings-form {\r\n    display: flex;\r\n\twidth: auto;\r\n    flex-direction: column;\r\n    gap: 15px;\r\n}\r\n\r\n/* Tab Navigation */\r\n.admin-tabs {\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.tab-nav {\r\n    display: flex;\r\n\tjustify-content: center;\r\n    margin-bottom: 0;\r\n}\r\n\r\n.tab-button {\r\n\tbackground-color: var(--primary-color);\r\n    padding: 0px 5px;\r\n    border-bottom: none;\r\n    border-radius: 5px 5px 0 0;\r\n    margin-right: 3px;\r\n    cursor: pointer;\r\n    font-weight: normal;\r\n    transition: background-color 0.3s;\r\n}\r\n\r\n.tab-button:hover {\r\n    background-color: var(--primary-color-light);\r\n}\r\n\r\n.tab-button.active {\r\n\tbackground-color: var(--primary-color-light);\r\n    margin-bottom: -1px;\r\n}\r\n\r\n/* Tab Content */\r\n.tab-pane {\r\n    display: none;\r\n    padding: 20px;\r\n\tmargin-top: 0;\r\n    border-top: none;\r\n    border-radius: 0 0 5px 5px;\r\n}\r\n\r\n.tab-pane.active {\r\n    display: block;\r\n\tmargin-top: 0;\r\n}\r\n\r\n/* Logout section */\r\n.logout-section {\r\n    margin-top: 0;\r\n\tpadding: 0;\r\n    text-align: right;\r\n}\r\n\r\n/* Look and Feel Tab Styles */\r\n/* Individual style variable settings have been removed, only theme selection is available */\r\n</style>\r\n\r\n{% endif %}\r\n{% endblock %}\r\n
